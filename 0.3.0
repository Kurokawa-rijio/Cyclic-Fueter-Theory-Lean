  ring

theorem einN_01 (H : SphN d Om r s c) :
    Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 0 1 = 2*(d 0 (d 1 r))/r + 2*(d 0 r)*(d 1 r)/r^2 + Om/r^2 := by
  have hR := ricN_01 d Om r s c H
