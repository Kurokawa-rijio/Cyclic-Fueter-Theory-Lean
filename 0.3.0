  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination 0

set_option maxHeartbeats 0 in
theorem tymA_32 {N A R : S} (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    Tym (gD N A R s) (giD N A R s) (FT d W s) 3 2 =
    0 := by
  simp only [Tym, gD, giD, FT, Fin.sum_univ_three, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, neg_mul, mul_neg]
  all_goals
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination 0

set_option maxHeartbeats 0 in
theorem tymA_33 {N A R : S} (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    Tym (gD N A R s) (giD N A R s) (FT d W s) 3 3 =
    (1/2 : S) * W ^ 4 * R⁻¹ ^ 2 * s ^ 2 + (-1 : S) * W ^ 2 * R⁻¹ ^ 2 * s ^ 2 + (1/2 : S) * R⁻¹ ^ 2 * s ^ 2 := by
  simp only [Tym, gD, giD, FT, Fin.sum_univ_three, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, neg_mul, mul_neg]
  all_goals
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((-1/2 : S) * R * W ^ 4 * iR ^ 3 * is ^ 2 * s ^ 4 + (1 : S) * R * W ^ 2 * iR ^ 3 * is ^ 2 * s ^ 4 + (1/2 : S) * R * (d 0 W) ^ 2 * iN ^ 2 * iR * is ^ 2 * s ^ 4 + (1/2 : S) * R * (d 0 W) ^ 2 * iN ^ 2 * iR * s ^ 2 + (-1/2 : S) * R * (d 1 W) ^ 2 * iA ^ 2 * iR * is ^ 2 * s ^ 4 + (-1/2 : S) * R * (d 1 W) ^ 2 * iA ^ 2 * iR * s ^ 2 + (-1/2 : S) * R * iR ^ 3 * is ^ 2 * s ^ 4 + (-1/2 : S) * W ^ 4 * iR ^ 2 * is ^ 2 * s ^ 4 + (1 : S) * W ^ 2 * iR ^ 2 * is ^ 2 * s ^ 4 + (1/2 : S) * (d 0 W) ^ 2 * iN ^ 2 * is ^ 2 * s ^ 4 + (1/2 : S) * (d 0 W) ^ 2 * iN ^ 2 * s ^ 2 + (-1/2 : S) * (d 1 W) ^ 2 * iA ^ 2 * is ^ 2 * s ^ 4 + (-1/2 : S) * (d 1 W) ^ 2 * iA ^ 2 * s ^ 2 + (-1/2 : S) * iR ^ 2 * is ^ 2 * s ^ 4) * hiR + ((-1/2 : S) * W ^ 4 * iR ^ 2 * is * s ^ 3 + (-1/2 : S) * W ^ 4 * iR ^ 2 * s ^ 2 + (1 : S) * W ^ 2 * iR ^ 2 * is * s ^ 3 + (1 : S) * W ^ 2 * iR ^ 2 * s ^ 2 + (1/2 : S) * (d 0 W) ^ 2 * iN ^ 2 * is * s ^ 3 + (1/2 : S) * (d 0 W) ^ 2 * iN ^ 2 * s ^ 2 + (-1/2 : S) * (d 1 W) ^ 2 * iA ^ 2 * is * s ^ 3 + (-1/2 : S) * (d 1 W) ^ 2 * iA ^ 2 * s ^ 2 + (-1/2 : S) * iR ^ 2 * is * s ^ 3 + (-1/2 : S) * iR ^ 2 * s ^ 2) * his

/-! ### D. 実解析:拘束の輸送、Gudermann と Mercator、波面の出会い、帽子の崩壊、平坦極限、Z9 の整理 -/

section Analysis
open Real Filter Topology Set CFT.AlphaIV

/-- 拘束の輸送:∂_v C = −(r_v/r) C(constraint_prop_u)、初期の特性線で C = 0、r > 0 なら C ≡ 0 -/
theorem constraint_transport {v0 v1 : ℝ} {r rv C C' : ℝ → ℝ}
    (hr : ∀ v ∈ Icc v0 v1, HasDerivWithinAt r (rv v) (Icc v0 v1) v)
    (hC : ∀ v ∈ Icc v0 v1, HasDerivWithinAt C (C' v) (Icc v0 v1) v)
    (heq : ∀ v ∈ Icc v0 v1, C' v = -(rv v * (r v)⁻¹) * C v) (h0 : C v0 = 0)
    (hpos : ∀ v ∈ Icc v0 v1, r v ≠ 0) : ∀ v ∈ Icc v0 v1, C v = 0 :=
  CFT.S4J.jump_transport hr hC (fun v hv => by rw [heq v hv]; field_simp [hpos v hv]; ring) h0 hpos

/-- W_uv の右辺(AlphaIV の FW)は Ω = e^{2σ} で goursat_W の右辺と同じ -/
theorem fw_eq (r σ W : ℝ) : FW r σ W = 2⁻¹ * exp (2 * σ) * W * (1 - W ^ 2) * r⁻¹ ^ 2 := by
  simp only [FW]; ring

/-- 首の波面 z_ℓ(t) = ℓ arsinh(tan(t/ℓ)) -/
noncomputable def zfront (l t : ℝ) : ℝ := l * arsinh (tan (t / l))

/-- z_ℓ(ℓ gd(z/ℓ)) = z(すべての z) -/
theorem front_gd_inv (l z : ℝ) (hl : l ≠ 0) : zfront l (l * gd (z / l)) = z := by
  simp only [zfront]
  rw [show l * gd (z / l) / l = gd (z / l) by field_simp, tan_gd, arsinh_sinh]
  field_simp

/-- 主値の帯 |t| < πℓ/2 で ℓ gd(z_ℓ(t)/ℓ) = t:z_ℓ と t ↦ ℓ gd(·/ℓ) は互いに逆 -/
theorem gd_front_inv (l t : ℝ) (hl : 0 < l) (ht : |t| < π * l / 2) : l * gd (zfront l t / l) = t := by
  have h1 : -(π / 2) < t / l := by
    rw [lt_div_iff hl]; have := neg_abs_le t; nlinarith
  have h2 : t / l < π / 2 := by
    rw [div_lt_iff hl]; have := le_abs_self t; nlinarith
  simp only [zfront, gd]
  rw [show l * arsinh (tan (t / l)) / l = arsinh (tan (t / l)) by field_simp, sinh_arsinh, arctan_tan h1 h2]
  field_simp

/-- cos(gd y) = sech y -/
theorem cos_gd (y : ℝ) : cos (gd y) = 1 / cosh y := by
  rw [gd, cos_arctan, ← cosh_sq', sqrt_sq (cosh_pos y).le]

/-- Mercator:gd′ = cos ∘ gd。したがって緯度 φ = gd(y) で球面の dφ² + cos²φ dλ² = sech²y (dy² + dλ²) -/
theorem mercator (y : ℝ) : HasDerivAt gd (cos (gd y)) y := by
  rw [cos_gd]; exact gd_deriv y

/-- 首の Mercator 座標:t(y) = ℓ gd(y/ℓ) は dt/dy = cos(t/ℓ)。したがって
  −dt² + cos²(t/ℓ)dz² = cos²(t/ℓ)(−dy² + dz²)(同じ Gudermann 写像が首の 2 次元の計量を共形平坦にする) -/
theorem neck_mercator (l y : ℝ) (hl : l ≠ 0) :
    HasDerivAt (fun y => l * gd (y / l)) (cos (l * gd (y / l) / l)) y := by
  have h := ((gd_deriv (y / l)).comp y ((hasDerivAt_id y).div_const l)).const_mul l
  rw [show l * gd (y / l) / l = gd (y / l) by field_simp, cos_gd]
  convert h using 1
  simp only [id]; field_simp

/-- 原点を通る未来向き・右向きのヌル曲線(dt/dz = cos(t/ℓ)、主値の帯の中)は t = ℓ gd(z/ℓ) に限る。
  台帳 Z10 の t/ℓ* = gd(z/ℓ*)。これは Mercator 座標での 45° の航程線 y = z の像:座標の対応であって、
  球面(K = +1)と首の 2 次元部分(K = −1/ℓ²、AdS₂)の力学的な同値ではない -/
theorem null_curve_unique (l : ℝ) (hl : 0 < l) (T T' : ℝ → ℝ) (hT : ∀ z, HasDerivAt T (T' z) z)
    (hnull : ∀ z, T' z = cos (T z / l)) (hstrip : ∀ z, |T z| < π * l / 2) (h0 : T 0 = 0) :
    ∀ z, T z = l * gd (z / l) := by
  have hcos : ∀ z, 0 < cos (T z / l) := by
    intro z
    apply cos_pos_of_mem_Ioo
    constructor
    · rw [lt_div_iff hl]; have := neg_abs_le (T z); have := hstrip z; nlinarith
    · rw [div_lt_iff hl]; have := le_abs_self (T z); have := hstrip z; nlinarith
  have hd : ∀ z, HasDerivAt (fun z => zfront l (T z) - z) 0 z := by
    intro z
    have h := ((front_deriv l (T z) hl (hcos z)).comp z (hT z)).sub (hasDerivAt_id z)
    convert h using 1
    rw [hnull z]; field_simp [(hcos z).ne']
  have hconst : ∀ z, zfront l (T z) - z = zfront l (T 0) - 0 := fun z =>
    is_const_of_deriv_eq_zero (fun z => (hd z).differentiableAt) (fun z => (hd z).deriv) z 0
  intro z
  have e := hconst z
  rw [h0, show zfront l 0 = 0 by simp [zfront]] at e
  have hz : zfront l (T z) = z := by linarith
  rw [← gd_front_inv l (T z) hl (hstrip z), hz]

/-- 長さ L の首の両端からの波面 z_L = −L/2 + z_ℓ(t)、z_R = L/2 − z_ℓ(t) が出会うのは t = ℓ gd(L/(2ℓ)) のときに限る
  (上界でなく等式。t* < πℓ/2 は fronts_meet_before) -/
theorem fronts_meet_iff (l L t : ℝ) (hl : 0 < l) (ht : |t| < π * l / 2) :
    -(L / 2) + zfront l t = L / 2 - zfront l t ↔ t = l * gd (L / (2 * l)) := by
  constructor
  · intro h
    have hz : zfront l t = L / 2 := by linarith
    rw [← gd_front_inv l t hl ht, hz]; congr 2; field_simp
  · intro h
    have : zfront l t = L / 2 := by
      rw [h, show L / (2 * l) = (L / 2) / l by field_simp]; exact front_gd_inv l (L / 2) hl.ne'
    linarith

/-- 帽子の加速度:tt 成分 a′² + a² = ℓ² と θθ 成分 2aa″ − a′² + a² + ℓ² = 0 から a″ = −a -/
theorem cap_accel (a a1 a2 l : ℝ) (ha : a ≠ 0) (h00 : a1 ^ 2 + a ^ 2 = l ^ 2)
    (h22 : 2 * a * a2 - a1 ^ 2 + a ^ 2 + l ^ 2 = 0) : a2 = -a := by
  have : 2 * a * (a2 + a) = 0 := by linear_combination h22 + h00
  have := (mul_eq_zero.mp this).resolve_left (mul_ne_zero two_ne_zero ha)
  linarith

/-- 時間対称な初期値 a(0) = ℓ、a′(0) = 0 で a″ = −a の解は a = ℓ cos η だけ -/
theorem cap_unique (l : ℝ) (A A' : ℝ → ℝ) (h1 : ∀ η, HasDerivAt A (A' η) η)
    (h2 : ∀ η, HasDerivAt A' (-A η) η) (h0 : A 0 = l) (h0' : A' 0 = 0) : ∀ η, A η = l * cos η := by
  let E : ℝ → ℝ := fun η => (A η - l * cos η) ^ 2 + (A' η + l * sin η) ^ 2
  have hE : ∀ η, HasDerivAt E 0 η := by
    intro η
    have h := (((h1 η).sub ((hasDerivAt_cos η).const_mul l)).pow 2).add
      (((h2 η).add ((hasDerivAt_sin η).const_mul l)).pow 2)
    convert h using 1
    push_cast; ring
  have hc : ∀ η, E η = E 0 := fun η =>
    is_const_of_deriv_eq_zero (fun z => (hE z).differentiableAt) (fun z => (hE z).deriv) η 0
  intro η
  have e := hc η
  simp only [E, h0, h0', cos_zero, sin_zero, mul_one, mul_zero, sub_self, add_zero] at e
  have h3 : (A η - l * cos η) ^ 2 = 0 := by
    have := sq_nonneg (A' η + l * sin η); nlinarith [sq_nonneg (A η - l * cos η)]
  have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h3
  linarith

/-- 中心の固有時 t(η) = ∫₀^η a = ℓ sin η(dt = a dη)、崩壊 η = π/2 で t = ℓ -/
theorem cap_proper_time (l η : ℝ) :
    HasDerivAt (fun η => l * sin η) (l * cos η) η ∧ l * sin (π / 2) = l :=
  ⟨by simpa using (hasDerivAt_sin η).const_mul l, by simp⟩

/-- 帽子の YM のエネルギー密度(rho_tube の Rho、W = cos χ、W_χ/A = −sin χ/a)は ρ̂ = 3/(2a⁴) -/
theorem cap_density (a X Y : ℝ) (ha : a ≠ 0) (hX : X ≠ 0) (hXY : X ^ 2 + Y ^ 2 = 1) :
    CFT.S4J.Rho (a * X) Y 0 (-X / a) = 3 / (2 * a ^ 4) := by
  simp only [CFT.S4J.Rho]
  have hY : 1 - Y ^ 2 = X ^ 2 := by linarith
  rw [hY]; field_simp; ring

/-- 崩壊:a = ℓ cos η → 0(η → π/2⁻)で ρ̂ = 3/(2a⁴) → ∞(中心の測地線に沿って曲率の不変量が発散) -/
theorem cap_crunch (l : ℝ) (hl : 0 < l) :
    Tendsto (fun η => 3 / (2 * (l * cos η) ^ 4)) (𝓝[<] (π / 2)) atTop := by
  have h1 : Tendsto (fun η => l * cos η) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    have hc := tendsto_cos_pi_div_two
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have := (tendsto_nhdsWithin_iff.mp hc).1
      simpa using this.const_mul l
    · filter_upwards [(tendsto_nhdsWithin_iff.mp hc).2] with η hη
      exact mul_pos hl hη
  have h2 : Tendsto (fun η => 2 * (l * cos η) ^ 4) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have := ((tendsto_nhdsWithin_iff.mp h1).1.pow 4).const_mul 2
      simpa using this
    · filter_upwards [(tendsto_nhdsWithin_iff.mp h1).2] with η hη
      have : 0 < (l * cos η) ^ 4 := pow_pos hη 4
      linarith
  have h3 := (tendsto_inv_nhdsGT_zero.comp h2).const_mul_atTop (by norm_num : (0 : ℝ) < 3)
  refine h3.congr' ?_
  filter_upwards with η
  simp [div_eq_mul_inv]

/-- t_sing = ℓ < πℓ/2(Z9 の目標) -/
theorem t_sing_lt (l : ℝ) (hl : 0 < l) : l < π * l / 2 := by
  have := pi_gt_three; nlinarith

/-- 接合から帽子へ向かう波面は共形座標で χ = π/2 − η(dχ = −dη)。η < π/2 なら中心 χ = 0 はまだ波面の外
  (厳密な FRW の領域)にある。波面が中心に着く η = π/2 は崩壊の瞬間に一致する -/
theorem center_before_front (η : ℝ) (h : η < π / 2) : (0 : ℝ) < π / 2 - η := by linarith

/-- 平坦極限:到着時計 ℓ gd(z/ℓ) → z(ℓ → ∞) -/
theorem flat_clock (z : ℝ) : Tendsto (fun l : ℝ => l * gd (z / l)) atTop (𝓝 z) := by
  by_cases hz : z = 0
  · subst hz; simp [gd_zero]
  have hslope := gd_deriv_zero.tendsto_slope_zero
  simp only [zero_add, gd_zero, sub_zero, smul_eq_mul] at hslope
  have hu : Tendsto (fun l : ℝ => z / l) atTop (𝓝[≠] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using tendsto_const_nhds.div_atTop tendsto_id
    · filter_upwards [eventually_gt_atTop 0] with l hl
      exact div_ne_zero hz hl.ne'
  have := (hslope.comp hu).const_mul z
  rw [mul_one] at this
  refine this.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with l hl
  simp only [Function.comp]
  field_simp

/-- arsinh ∘ tan の 0 での微分は 1 -/
theorem front_deriv_zero : HasDerivAt (fun x => arsinh (tan x)) 1 0 := by
  have ht := hasDerivAt_tan (by simp : cos (0 : ℝ) ≠ 0)
  have h := (hasDerivAt_arsinh (tan 0)).comp (0 : ℝ) ht
  simpa using h

/-- 平坦極限:波面 ℓ arsinh(tan(t/ℓ)) → t -/
theorem flat_front (t : ℝ) : Tendsto (fun l : ℝ => zfront l t) atTop (𝓝 t) := by
  by_cases ht : t = 0
  · subst ht; simp [zfront]
  have hslope := front_deriv_zero.tendsto_slope_zero
  simp only [zero_add, tan_zero, arsinh_zero, sub_zero, smul_eq_mul] at hslope
  have hu : Tendsto (fun l : ℝ => t / l) atTop (𝓝[≠] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using tendsto_const_nhds.div_atTop tendsto_id
    · filter_upwards [eventually_gt_atTop 0] with l hl
      exact div_ne_zero ht hl.ne'
  have := (hslope.comp hu).const_mul t
  rw [mul_one] at this
  refine this.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with l hl
  simp only [Function.comp, zfront]
  field_simp

/-- 平坦極限:計量の係数 cos²(t/ℓ) → 1、時計の速さ sech(z/ℓ) → 1 -/
theorem flat_metric (t z : ℝ) :
    Tendsto (fun l : ℝ => cos (t / l) ^ 2) atTop (𝓝 1) ∧
    Tendsto (fun l : ℝ => 1 / cosh (z / l)) atTop (𝓝 1) := by
  have h : ∀ x : ℝ, Tendsto (fun l : ℝ => x / l) atTop (𝓝 0) := fun x =>
    tendsto_const_nhds.div_atTop tendsto_id
  constructor
  · simpa using ((continuous_cos.tendsto 0).comp (h t)).pow 2
  · have := (continuous_cosh.tendsto 0).comp (h z)
    simpa using this.inv₀ (by simp)

/-- Z9 の正しい形:正の解が [τ₁, T) で類の条件を満たすなら T − τ₁ ≤ πr₁/2(最大の存在区間の長さ) -/
theorem z9_maximal (r rp W : ℝ → ℝ) (l κ τ1 T r1 : ℝ) (hT : τ1 < T)
    (hpos : ∀ τ ∈ Ico τ1 T, 0 < r τ)
    (h1 : ∀ τ ∈ Ico τ1 T, HasDerivAt r (rp τ) τ)
    (h2 : ∀ τ ∈ Ico τ1 T, HasDerivAt rp (CFT.Z9.acc l (r τ) (rp τ) (W τ)) τ)
    (hk : l ^ 2 ≤ 2 * κ) (hW : ∀ τ ∈ Ico τ1 T, κ ≤ W τ ^ 2 * r τ ^ 2)
    (h0 : rp τ1 = 0) (hr1 : r τ1 = r1) : T - τ1 ≤ π * r1 / 2 := by
  have hr1p : 0 < r1 := by rw [← hr1]; exact hpos τ1 ⟨le_refl _, hT⟩
  by_contra hlt
  push_neg at hlt
  set τ2 := τ1 + π * r1 / 2 with hτ2
  have hp : 0 < π * r1 / 2 := by have := pi_pos; positivity
  have hsub : ∀ τ ∈ Icc τ1 τ2, τ ∈ Ico τ1 T := fun τ hτ => ⟨hτ.1, by linarith [hτ.2]⟩
  have := CFT.Z9.z9_collapse r rp W l κ τ1 τ2 r1 (by linarith) (fun τ hτ => hpos τ (hsub τ hτ))
    (fun τ hτ => h1 τ (hsub τ hτ)) (fun τ hτ => h2 τ (hsub τ hτ)) hk (fun τ hτ => hW τ (hsub τ hτ)) h0 hr1
  linarith

/-- 旧 z9_reaches_zero の仮定は κ > 0 では両立しない(r = 0 の点で κ ≤ W²r² = 0 が破れる)。
  したがってその結論は空虚で、正しい形は z9_collapse、z9_maximal -/
theorem z9_reaches_zero_vacuous (r rp W : ℝ → ℝ) (l κ τ1 r1 : ℝ) (hr1p : 0 < r1) (hκ : 0 < κ)
    (h1 : ∀ τ ∈ Icc τ1 (τ1 + π * r1 / 2), HasDerivAt r (rp τ) τ)
    (h2 : ∀ τ ∈ Icc τ1 (τ1 + π * r1 / 2), HasDerivAt rp (CFT.Z9.acc l (r τ) (rp τ) (W τ)) τ)
    (hk : l ^ 2 ≤ 2 * κ) (hW : ∀ τ ∈ Icc τ1 (τ1 + π * r1 / 2), κ ≤ W τ ^ 2 * r τ ^ 2)
    (h0 : rp τ1 = 0) (hr1 : r τ1 = r1) : False := by
  obtain ⟨T, hT, hrT⟩ := CFT.Z9.z9_reaches_zero r rp W l κ τ1 r1 hr1p h1 h2 hk hW h0 hr1
  have := hW T hT
  rw [hrT] at this
  simp at this
  linarith

end Analysis

import sympy as sp
from gen3 import tolean
# atoms
names={}
def A_(nm,lean):
    s=sp.Symbol(nm); names[s]=lean; return s
N,A,R,s,W=[A_(x,x) for x in ['N','A','R','s','W']]
iN,iA,iR,is_=[A_(x,x) for x in ['iN','iA','iR','is']]
Nt,Nx,At,Ax,Rt,Rx,Wt,Wx=[A_(a,'(d %d %s)'%(i,f)) for a,i,f in [('Nt',0,'N'),('Nx',1,'N'),('At',0,'A'),('Ax',1,'A'),('Rt',0,'R'),('Rx',1,'R'),('Wt',0,'W'),('Wx',1,'W')]]
Ntt,Nxx,Att,Rtt,Rxx=[A_(a,'(d %d (d %d %s))'%(i,j,f)) for a,i,j,f in [('Ntt',0,0,'N'),('Nxx',1,1,'N'),('Att',0,0,'A'),('Rtt',0,0,'R'),('Rxx',1,1,'R')]]
O,r,iO,ir=[A_(x,y) for x,y in [('Om','Om'),('r','r'),('iOm','iOm'),('ir','ir')]]
Ou,Ov,ru,rv,Wu,Wv,ruu,ruv,Ouv=[A_(a,b) for a,b in [('Ou','(d 0 Om)'),('Ov','(d 1 Om)'),('ru','(d 0 r)'),('rv','(d 1 r)'),('Wu','(d 0 W)'),('Wv','(d 1 W)'),('ruu','(d 0 (d 0 r))'),('ruv','(d 0 (d 1 r))'),('Ouv','(d 0 (d 1 Om))')]]
l=A_('l','l')
def lean(e):
    e=sp.expand(e)
    if e==0: return '0'
    out=[]
    gens=sorted(e.free_symbols,key=str)
    if not gens:
        q=sp.Rational(e); return '(%s : S)'%q
    for mon,c in sp.Poly(e,*gens).terms():
        f=['(%s : S)'%sp.Rational(c)]
        for g,p in zip(gens,mon):
            if p: f.append(names[g] if p==1 else '%s ^ %d'%(names[g],p))
        out.append(' * '.join(f))
    return ' + '.join(out)
def cert(P,rels,hn):
    P=sp.expand(P)
    gens=[]
    for x in rels: gens+=list(x.free_symbols)
    Q,rem=sp.reduced(P,rels,*gens)
    assert sp.expand(rem)==0,('REM',rem)
    return ' + '.join('(%s) * %s'%(lean(q),h) for q,h in zip(Q,hn) if sp.expand(q)!=0) or '0'
relD=[N*iN-1,A*iA-1,R*iR-1]; hD=['hiN','hiA','hiR']
relN=[O*iO-1,r*ir-1]; hN_=['hiOm','hir']
out={}
einD11=2*A**2*Nt*Rt*iN**3*iR - A**2*Rt**2*iN**2*iR**2 - 2*A**2*Rtt*iN**2*iR - A**2*iR**2 + 2*Nx*Rx*iN*iR + Rx**2*iR**2
Gnn=lambda N_,R_,Nt_,Rt_,Rtt_,k1,k2,iN_,iR_: -iR_**2 - 2*Rtt_*iN_**2*iR_ - Rt_**2*iN_**2*iR_**2 + 2*Nt_*Rt_*iN_**3*iR_ + k2**2*iR_**2 + 2*k1*k2*iN_*iR_
out['gauss']=cert(einD11*iA**2 - Gnn(N,R,Nt,Rt,Rtt,Nx*iA,Rx*iA,iN,iR),relD,hD)
einD00=2*At*Rt*iA*iR + 2*Ax*N**2*Rx*iA**3*iR - N**2*Rx**2*iA**2*iR**2 - 2*N**2*Rxx*iA**2*iR + N**2*iR**2 + Rt**2*iR**2
einD22=At*Nt*R**2*iA*iN**3 - At*R*Rt*iA*iN**2 - Att*R**2*iA*iN**2 - Ax*Nx*R**2*iA**3*iN - Ax*R*Rx*iA**3 + Nt*R*Rt*iN**3 + Nx*R*Rx*iA**2*iN + Nxx*R**2*iA**2*iN - R*Rtt*iN**2 + R*Rxx*iA**2
P22=(-Att*R**2*iA*iN**2 - R*Rtt*iN**2 + At*Nt*R**2*iA*iN**3 + Nt*R*Rt*iN**3 - Ax*Nx*R**2*iA**3*iN + Nx*R*Rx*iA**2*iN - Rx**2*iA**2/2 + sp.Rational(1,2) + Rt**2*iN**2/2)
out['ang']=cert(einD22 + R**2*iN**2/2*einD00 - (R**2*iA**2*iN*Nxx + P22),relD,hD)
# slice: Rt=At=0
e00s=einD00.subs({Rt:0,At:0})
out['slice']=cert(e00s*iN**2 - (1-(Rx*iA)**2 - 2*R*(Rxx*iA**2 - Ax*Rx*iA**3))*iR**2,relD,hD)
tD11=-sp.Rational(1,2)*A**2*W**4*iR**4 + A**2*W**2*iR**4 + A**2*Wt**2*iN**2*iR**2 - sp.Rational(1,2)*A**2*iR**4 + Wx**2*iR**2
tD00=sp.Rational(1,2)*N**2*W**4*iR**4 - N**2*W**2*iR**4 + N**2*Wx**2*iA**2*iR**2 + sp.Rational(1,2)*N**2*iR**4 + Wt**2*iR**2
tD01=2*Wt*Wx*iR**2
Tnn=lambda R_,W_,wt,wx,iR_: wx**2*iR_**2 + wt**2*iR_**2 - (1-W_**2)**2*iR_**4/2
Rho=lambda R_,W_,wt,wx,iR_: wx**2*iR_**2 + wt**2*iR_**2 + (1-W_**2)**2*iR_**4/2
out['tnn']=cert(tD11*iA**2 - Tnn(R,W,Wt*iN,Wx*iA,iR),relD,hD)
out['rho']=cert(tD00*iN**2 - Rho(R,W,Wt*iN,Wx*iA,iR),relD,hD)
out['flux']=cert(tD01*(iN*iA) - 2*(Wt*iN)*(Wx*iA)*iR**2,relD,hD)
# ym flux tube: (N A R^2 s) * iA^2 * iR^2 * Wx = N s Wx iA
out['ymflux']=cert(N*A*R**2*s*iA**2*iR**2*Wx - N*s*(Wx*iA),relD,hD)
out['ymnull']=cert(O*r**2*s*(-iO)*ir**2*Wv - (-(s*Wv)),relN,hN_)
# mixed: einN01 = 2 l^2 tN01  <=> ... ; forward: from h: E=T  derive target. linear_combination coefficient c*h + cert
einN01=O*ir**2 + 2*ir**2*ru*rv + 2*ir*ruv
tN01=sp.Rational(1,2)*O*W**4*ir**4 - O*W**2*ir**4 + sp.Rational(1,2)*O*ir**4
tgt=r*ruv + ru*rv - (O/2*(l**2*(1-W**2)**2*ir**2-1))
# forward: tgt - c*(einN01 - 2 l^2 tN01) in ideal with c = r^2/2
out['mixed_fwd']=cert(tgt - r**2/2*(einN01-2*l**2*tN01),relN,hN_)
# backward: (einN01 - 2 l^2 tN01) - c*tgt in ideal, c = 2 ir^2
out['mixed_bwd']=cert((einN01-2*l**2*tN01) - 2*ir**2*tgt,relN,hN_)
import pickle; pickle.dump(out,open('cert5.pkl','wb'))
for k,v in out.items(): print(k,len(v))

import sympy as sp, pickle
from cert5 import lean, names, A_
CD=pickle.load(open('cert.pkl','rb')); CT=pickle.load(open('certT.pkl','rb'))
out={}
# ---------- constraint propagation (null) ----------
O,r,W,l=[sp.Symbol(x) for x in ['Om','r','W','l']]
iO,ir=sp.Symbol('iOm'),sp.Symbol('ir')
ru,rv,ruu,ruv,rvv,ruuv,ruvv=[A_(a,b) for a,b in [('ru','(d 0 r)'),('rv','(d 1 r)'),('ruu','(d 0 (d 0 r))'),('ruv','(d 0 (d 1 r))'),('rvv','(d 1 (d 1 r))'),('ruuv','(d 0 (d 0 (d 1 r)))'),('ruvv','(d 1 (d 0 (d 1 r)))')]]
Ou,Ov,Ouv=[A_(a,b) for a,b in [('Ou','(d 0 Om)'),('Ov','(d 1 Om)'),('Ouv','(d 0 (d 1 Om))')]]
Wu,Wv,Wuv=[A_(a,b) for a,b in [('Wu','(d 0 W)'),('Wv','(d 1 W)'),('Wuv','(d 0 (d 1 W))')]]
for x,y in [(O,'Om'),(r,'r'),(W,'W'),(l,'l'),(iO,'iOm'),(ir,'ir')]: names[x]=y
h=sp.Rational(1,2)
Er=h*O*(l**2*(1-W**2)**2*ir**2-1)*ir - ru*rv*ir
EO=Ou*Ov*iO - 2*O*ruv*ir - O**2*l**2*(1-W**2)**2*ir**4
EW=h*O*W*(1-W**2)*ir**2
D0={O:Ou,r:ru,W:Wu,rv:ruv,ru:ruu,Ov:Ouv,Wv:Wuv,iO:-iO**2*Ou,ir:-ir**2*ru,l:0}
D1={O:Ov,r:rv,W:Wv,ru:ruv,rv:rvv,ruu:ruuv,Ou:Ouv,Wu:Wuv,ruv:ruvv,iO:-iO**2*Ov,ir:-ir**2*rv,l:0}
def Dd(e,Dm):
    e=sp.expand(e); out=0
    for a in e.free_symbols:
        if a not in Dm: raise Exception('no deriv '+str(a))
        out+=sp.diff(e,a)*Dm[a]
    return sp.expand(out)
rels=[O*iO-1,r*ir-1]
Cu=ruu-Ou*iO*ru+2*l**2*Wu**2*ir
Cv=rvv-Ov*iO*rv+2*l**2*Wv**2*ir
# u-constraint along v
H1=ruuv-Dd(Er,D0); H2=ruv-Er; H3=Ouv-EO; H4=Wuv-EW
G=Dd(Cu,D1)+rv*ir*Cu
gens=[ruuv,Ouv,Wuv,ruv,iO,ir,ruvv,rvv,ruu,ru,rv,Ou,Ov,Wu,Wv,O,r,W,l]
Q,rem=sp.reduced(G,[H1,H3,H4,H2]+rels,*gens,order='lex')
assert sp.expand(rem)==0, rem
out['cu']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hr1','hO','hW','hr','hiOm','hir']) if sp.expand(q)!=0)
# v-constraint along u: d0(Cv); d0 rvv = d1(d0(d1 r)) = ruvv ; d0 Ov = Ouv ; d0 Wv = Wuv; d0 rv = ruv
D0b=dict(D0); D0b[rvv]=ruvv; D0b[Ov]=Ouv; D0b[Wv]=Wuv; D0b[rv]=ruv
H1b=ruvv-Dd(Er,D1)
Gb=Dd(Cv,D0b)+ru*ir*Cv
gensb=[ruvv,Ouv,Wuv,ruv,iO,ir,ruuv,rvv,ruu,ru,rv,Ou,Ov,Wu,Wv,O,r,W,l]
Q,rem=sp.reduced(Gb,[H1b,H3,H4,H2]+rels,*gensb,order='lex')
assert sp.expand(rem)==0, rem
out['cv']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hr1','hO','hW','hr','hiOm','hir']) if sp.expand(q)!=0)
print('prop ok')
# ---------- goursat forms ----------
einN22=Ou*Ov*iO**3*r**2 - Ouv*iO**2*r**2 - 2*iO*r*ruv
tN22=h*W**4*ir**2 - W**2*ir**2 + h*ir**2
c=-O**2*ir**2
Q,rem=sp.reduced(sp.expand((Ouv-EO) - c*(einN22-2*l**2*tN22)),rels,iO,ir,O,r)
assert sp.expand(rem)==0
out['gO']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hiOm','hir']) if sp.expand(q)!=0) or '0'
out['gO_c']=lean(c)
s_=sp.Symbol('s'); is_=sp.Symbol('is'); names[s_]='s'; names[is_]='is'
ym02=-O*W**3*ir**2*s_ + O*W*ir**2*s_ - 2*Wuv*s_
c=-h*is_
Q,rem=sp.reduced(sp.expand((Wuv-EW) - c*ym02),rels+[s_*is_-1],iO,ir,is_,O,r,s_)
assert sp.expand(rem)==0
out['gW']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hiOm','hir','his']) if sp.expand(q)!=0) or '0'
mixed=r*ruv+ru*rv-(O/2*(l**2*(1-W**2)**2*ir**2-1))
Q,rem=sp.reduced(sp.expand((ruv-Er)-ir*mixed),rels,iO,ir,O,r)
assert sp.expand(rem)==0
out['gr']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hiOm','hir']) if sp.expand(q)!=0) or '0'
# constraints uu/vv equivalence: einN00 - 2 l^2 tN00 = -2 ir Cu
einN00=2*Ou*iO*ir*ru-2*ir*ruu; tN00=2*Wu**2*ir**2
Q,rem=sp.reduced(sp.expand((einN00-2*l**2*tN00)+2*ir*Cu),rels,iO,ir,O,r); assert sp.expand(rem)==0
out['cuu']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hiOm','hir']) if sp.expand(q)!=0) or '0'
print('goursat ok', out['gr'], '|', out['cuu'])
pickle.dump(out,open('cert6.pkl','wb'))
einN11=2*Ov*iO*ir*rv-2*ir*rvv; tN11=2*Wv**2*ir**2
Q,rem=sp.reduced(sp.expand((einN11-2*l**2*tN11)+2*ir*Cv),rels,iO,ir,O,r); assert sp.expand(rem)==0
out['cvv']=' + '.join('(%s) * %s'%(lean(q),hn) for q,hn in zip(Q,['hiOm','hir']) if sp.expand(q)!=0) or '0'
pickle.dump(out,open('cert6.pkl','wb'))
print('cvv',out['cvv'])

import sympy as sp, pickle
from cert5 import lean, names, A_
CD=pickle.load(open('cert.pkl','rb')); CT=pickle.load(open('certT.pkl','rb'))
sym=lambda n: sp.Symbol(n)
a,at,att,X,Y,ia,iX,l=[A_(x,y) for x,y in [('a','a'),('at','(d 0 a)'),('att','(d 0 (d 0 a))'),('X','X'),('Y','Y'),('ia','ia'),('iX','iX'),('l','l')]]
sub_cap={sym('N'):a,sym('Nt'):at,sym('Nx'):0,sym('Ntt'):att,sym('Ntx'):0,sym('Nxx'):0,
 sym('A'):a,sym('At'):at,sym('Ax'):0,sym('Att'):att,sym('Atx'):0,sym('Axx'):0,
 sym('R'):a*X,sym('Rt'):at*X,sym('Rx'):a*Y,sym('Rtt'):att*X,sym('Rtx'):at*Y,sym('Rxx'):-a*X,
 sym('iN'):ia,sym('iA'):ia,sym('iR'):ia*iX,sym('W'):Y,sym('Wt'):0,sym('Wx'):-X}
GB=[Y**2+X**2-1, X*iX-1, a*ia-1]; G_=[Y,iX,ia,X,a,at,att,l]
def red(P):
    Q,rem=sp.reduced(sp.expand(P),GB,*G_,order='lex'); return Q,sp.expand(rem)
def certstr(Q,hn=['hXY','hiX','hia']):
    return ' + '.join('(%s) * %s'%(lean(q),h) for q,h in zip(Q,hn) if sp.expand(q)!=0) or '0'
out={}
targets={(0,0):at**2+a**2-l**2,(2,2):2*a*att-at**2+a**2+l**2,(1,1):2*a*att-at**2+a**2+l**2}
for (i,j) in [(0,0),(1,1),(2,2),(0,1)]:
    E=CD['D'][('ein',i,j)][2].subs(sub_cap); T=CT[('D','T',i,j)][2].subs(sub_cap)
    P=sp.expand(E-2*l**2*T)
    Q,rem=red(P)
    print((i,j),'NF:',sp.factor(rem))
    out[(i,j),'nf']=rem
pickle.dump(out,open('cert7tmp.pkl','wb'))
cert={}
ks={(0,0):(3*ia**2, a**2/3),(1,1):(-ia**2,-a**2),(2,2):(-X**2*ia**2,-a**2*iX**2)}
for ij,(k,kinv) in ks.items():
    i,j=ij
    E=CD['D'][('ein',i,j)][2].subs(sub_cap); T=CT[('D','T',i,j)][2].subs(sub_cap)
    P=sp.expand(E-2*l**2*T); t0=targets[ij]
    Qf,rf=red(t0-kinv*P); assert rf==0,(ij,'f',rf)
    Qb,rb=red(P-k*t0); assert rb==0,(ij,'b',rb)
    cert[ij]=(lean(kinv),certstr(Qf),lean(k),certstr(Qb))
E=CD['D'][('ein',0,1)][2].subs(sub_cap); T=CT[('D','T',0,1)][2].subs(sub_cap)
Q,r0=red(E-2*l**2*T); assert r0==0; cert[(0,1)]=certstr(Q)
# neck
C_,S_,iC,il=[A_(x,y) for x,y in [('C','C'),('S','S'),('iC','iC'),('il','il')]]
sub_neck={sym('N'):1,sym('Nt'):0,sym('Nx'):0,sym('Ntt'):0,sym('Ntx'):0,sym('Nxx'):0,
 sym('A'):C_,sym('At'):-S_*il,sym('Ax'):0,sym('Att'):-C_*il**2,sym('Atx'):0,sym('Axx'):0,
 sym('R'):l,sym('Rt'):0,sym('Rx'):0,sym('Rtt'):0,sym('Rtx'):0,sym('Rxx'):0,
 sym('iN'):1,sym('iA'):iC,sym('iR'):il,sym('W'):0,sym('Wt'):0,sym('Wx'):0}
GBn=[C_*iC-1,l*il-1]
for (i,j) in [(0,0),(1,1),(2,2),(0,1)]:
    E=CD['D'][('ein',i,j)][2].subs(sub_neck); T=CT[('D','T',i,j)][2].subs(sub_neck)
    Q,rem=sp.reduced(sp.expand(E-2*l**2*T),GBn,iC,il,C_,l,S_)
    assert sp.expand(rem)==0,(i,j,rem)
    cert['neck',i,j]=' + '.join('(%s) * %s'%(lean(q),h) for q,h in zip(Q,['hiC','hil']) if sp.expand(q)!=0) or '0'
print({k:len(v) if isinstance(v,str) else [len(x) for x in v] for k,v in cert.items()})
pickle.dump(cert,open('cert7.pkl','wb'))

import sympy as sp, pickle
t,x,th,ph=sp.symbols('t x th ph'); X=[t,x,th,ph]
N=sp.Function('N')(t,x);A=sp.Function('A')(t,x);R=sp.Function('R')(t,x)
s=sp.sin(th);c=sp.cos(th)
d=lambda i,e: sp.diff(e,X[i])
GD=[[[d(0,N)/N,d(1,N)/N,0,0],[d(1,N)/N,d(0,A)*A/N**2,0,0],[0,0,d(0,R)*R/N**2,0],[0,0,0,d(0,R)*R*s**2/N**2]],
 [[d(1,N)*N/A**2,d(0,A)/A,0,0],[d(0,A)/A,d(1,A)/A,0,0],[0,0,-d(1,R)*R/A**2,0],[0,0,0,-d(1,R)*R*s**2/A**2]],
 [[0,0,d(0,R)/R,0],[0,0,d(1,R)/R,0],[d(0,R)/R,d(1,R)/R,0,0],[0,0,0,-s*c]],
 [[0,0,0,d(0,R)/R],[0,0,0,d(1,R)/R],[0,0,0,c/s],[d(0,R)/R,d(1,R)/R,c/s,0]]]
def Ric(b,cc):
    return sum(d(a,GD[a][b][cc])-d(cc,GD[a][b][a]) for a in range(4))+sum(GD[a][a][e]*GD[e][b][cc]-GD[a][cc][e]*GD[e][b][a] for a in range(4) for e in range(4))
r00=sp.simplify(Ric(0,0))
D=lambda f,*k: sp.Derivative(f,*k)
target=-d(0,d(0,A))/A - 2*d(0,d(0,R))/R + d(0,A)*d(0,N)/(A*N) + 2*d(0,N)*d(0,R)/(N*R) + d(1,d(1,N))*N/A**2 - d(1,A)*d(1,N)*N/A**3 + 2*d(1,N)*d(1,R)*N/(A**2*R)
print(sp.simplify(r00-target))

import sympy as sp
t,x,th,ph=sp.symbols('t x th ph')
def einstein(g,X):
    gi=sp.simplify(g.inv()); n=4
    Gam=[[[sp.simplify(sum(gi[a,d]*(sp.diff(g[d,c],X[b])+sp.diff(g[d,b],X[c])-sp.diff(g[b,c],X[d])) for d in range(n))/2) for c in range(n)] for b in range(n)] for a in range(n)]
    Ric=sp.zeros(n)
    for b in range(n):
        for c in range(n):
            Ric[b,c]=sp.simplify(sum(sp.diff(Gam[a][b][c],X[a])-sp.diff(Gam[a][b][a],X[c]) for a in range(n))+sum(Gam[a][a][e]*Gam[e][b][c]-Gam[a][c][e]*Gam[e][b][a] for a in range(n) for e in range(n)))
    Rs=sp.simplify(sum(gi[a,b]*Ric[a,b] for a in range(n) for b in range(n)))
    G=sp.simplify(Ric-g*Rs/2)
    return Gam,Ric,Rs,G
# diagonal
N=sp.Function('N')(t,x);A=sp.Function('A')(t,x);R=sp.Function('R')(t,x)
g=sp.diag(-N**2,A**2,R**2,R**2*sp.sin(th)**2)
_,_,_,G=einstein(g,[t,x,th,ph])
for (i,j) in [(0,0),(1,1),(0,1),(2,2)]:
    print('diag G',i,j,'=',sp.expand(sp.simplify(G[i,j])))
print('offdiag', [sp.simplify(G[i,j]) for i in range(4) for j in range(4) if i!=j and (i,j)!=(0,1) and (i,j)!=(1,0)])
print('G33/sin2-G22',sp.simplify(G[3,3]/sp.sin(th)**2-G[2,2]))
# double null
u,v=t,x
Om=sp.Function('Om')(u,v);r=sp.Function('r')(u,v)
g2=sp.Matrix([[0,-Om,0,0],[-Om,0,0,0],[0,0,r**2,0],[0,0,0,r**2*sp.sin(th)**2]])
_,_,_,G2=einstein(g2,[u,v,th,ph])
for (i,j) in [(0,0),(1,1),(0,1),(2,2)]:
    print('null G',i,j,'=',sp.expand(sp.simplify(G2[i,j])))
print('offdiag', [sp.simplify(G2[i,j]) for i in range(4) for j in range(4) if i!=j and (i,j)!=(0,1) and (i,j)!=(1,0)])
print('G33/sin2-G22',sp.simplify(G2[3,3]/sp.sin(th)**2-G2[2,2]))

/-! ### C. 外側の厳密解:帽子(閉じた放射 FRW)と首(AdS₂ × S²)を EYM の式から -/

section Exact
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- 帽子:共形時間 η(座標 0)と χ(座標 1)、N = A = a(η)、R = a(η) X(X = sin χ、Y = cos χ)、W = Y -/
structure CapData (a X Y s c : S) : Prop where
  ha : a ≠ 0
  hX : X ≠ 0
  hs : s ≠ 0
  a1 : d 1 a = 0
  a2 : d 2 a = 0
  a3 : d 3 a = 0
  X0 : d 0 X = 0
  X1 : d 1 X = Y
  X2 : d 2 X = 0
  X3 : d 3 X = 0
  Y0 : d 0 Y = 0
  Y1 : d 1 Y = -X
  hXY : X ^ 2 + Y ^ 2 = 1
  s0 : d 0 s = 0
  s1 : d 1 s = 0
  s2 : d 2 s = c
  s3 : d 3 s = 0
  c0 : d 0 c = 0
  c1 : d 1 c = 0
  c2 : d 2 c = -s
  c3 : d 3 c = 0
  comm : ∀ i j f, d i (d j f) = d j (d i f)

theorem capSph (a X Y s c : S) (H : CapData d a X Y s c) : SphD d a a (a * X) s c := by
  obtain ⟨ha, hX, hs, a1, a2, a3, X0, X1, X2, X3, Y0, Y1, hXY, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  refine ⟨ha, ha, mul_ne_zero ha hX, hs, a2, a3, a2, a3, ?_, ?_, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ <;>
    simp [Derivation.leibniz, a2, a3, X2, X3]

set_option maxHeartbeats 0 in
/-- 帽子の tt 成分 ⇔ Friedmann の式 a′² + a² = ℓ²(閉じた放射 FRW、共形時間) -/
theorem cap_00 (a X Y s c l : S) (H : CapData d a X Y s c) :
    Ein d (gD a a (a * X) s) (giD a a (a * X) s) (GD d a a (a * X) s c) 0 0
      = 2 * l ^ 2 * Tym (gD a a (a * X) s) (giD a a (a * X) s) (FT d Y s) 0 0 ↔ (d 0 a) ^ 2 + a ^ 2 = l ^ 2 := by
  have HS := capSph d a X Y s c H
  obtain ⟨ha, hX, hs, a1, a2, a3, X0, X1, X2, X3, Y0, Y1, hXY, -, -, -, -, -, -, -, -, comm⟩ := H
  have za : d 1 (d 0 a) = 0 := by rw [comm 1 0 a, a1, map_zero]
  rw [einD_00 d a a (a * X) s c HS, tymD_00 d Y s ha ha (mul_ne_zero ha hX) hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.leibniz, smul_eq_mul, mul_inv,
    a1, X0, X1, Y0, Y1, za, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hia : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
  have hiX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
  generalize a⁻¹ = ia at hia ⊢
  generalize X⁻¹ = iX at hiX ⊢
  constructor
  · intro h
    linear_combination ((1/3 : S) * a ^ 2) * h + ((-1/3 : S) * X ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 4 * l ^ 2 + (1/3 : S) * Y ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 4 * l ^ 2 + (1/3 : S) * a ^ 6 * iX ^ 2 * ia ^ 4 + (-1/3 : S) * a ^ 4 * iX ^ 4 * ia ^ 4 * l ^ 2) * hXY + ((1/3 : S) * X ^ 3 * a ^ 4 * iX ^ 3 * ia ^ 4 * l ^ 2 + (1/3 : S) * X ^ 2 * a ^ 4 * iX ^ 2 * ia ^ 4 * l ^ 2 + (-1/3 : S) * X * a ^ 6 * iX * ia ^ 4 + (1 : S) * X * a ^ 4 * iX * ia ^ 4 * l ^ 2 + (-1/3 : S) * X * a ^ 2 * (d 0 a) ^ 2 * iX * ia ^ 2 + (-1/3 : S) * a ^ 6 * ia ^ 4 + (-2/3 : S) * a ^ 5 * ia ^ 3 + (1 : S) * a ^ 4 * ia ^ 4 * l ^ 2 + (-1 : S) * a ^ 2 * (d 0 a) ^ 2 * ia ^ 2) * hiX + ((1/3 : S) * a ^ 5 * iX ^ 2 * ia ^ 3 + (-1/3 : S) * a ^ 5 * ia ^ 3 + (1/3 : S) * a ^ 4 * iX ^ 2 * ia ^ 2 + (-1 : S) * a ^ 4 * ia ^ 2 + (1 : S) * a ^ 3 * ia ^ 3 * l ^ 2 + (-1 : S) * a ^ 3 * ia + (1 : S) * a ^ 2 * ia ^ 2 * l ^ 2 + (-1 : S) * a ^ 2 + (-1 : S) * a * (d 0 a) ^ 2 * ia + (1 : S) * a * ia * l ^ 2 + (-1 : S) * (d 0 a) ^ 2 + (1 : S) * l ^ 2) * hia
  · intro h
    linear_combination ((3 : S) * ia ^ 2) * h + ((1 : S) * X ^ 2 * a ^ 2 * iX ^ 4 * ia ^ 4 * l ^ 2 + (-1 : S) * Y ^ 2 * a ^ 2 * iX ^ 4 * ia ^ 4 * l ^ 2 + (-1 : S) * a ^ 4 * iX ^ 2 * ia ^ 4 + (1 : S) * a ^ 2 * iX ^ 4 * ia ^ 4 * l ^ 2) * hXY + ((-1 : S) * X ^ 3 * a ^ 2 * iX ^ 3 * ia ^ 4 * l ^ 2 + (-1 : S) * X ^ 2 * a ^ 2 * iX ^ 2 * ia ^ 4 * l ^ 2 + (1 : S) * X * a ^ 4 * iX * ia ^ 4 + (-3 : S) * X * a ^ 2 * iX * ia ^ 4 * l ^ 2 + (1 : S) * X * (d 0 a) ^ 2 * iX * ia ^ 2 + (1 : S) * a ^ 4 * ia ^ 4 + (2 : S) * a ^ 3 * ia ^ 3 + (-3 : S) * a ^ 2 * ia ^ 4 * l ^ 2 + (3 : S) * (d 0 a) ^ 2 * ia ^ 2) * hiX + ((-1 : S) * a ^ 3 * iX ^ 2 * ia ^ 3 + (1 : S) * a ^ 3 * ia ^ 3 + (-1 : S) * a ^ 2 * iX ^ 2 * ia ^ 2 + (3 : S) * a ^ 2 * ia ^ 2 + (-3 : S) * a * ia ^ 3 * l ^ 2 + (-3 : S) * ia ^ 2 * l ^ 2) * hia

