    Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) 3 1
      - 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (FT d W s) 3 1 = 0 := by
  have hE := einA_31 d 1 A R s c H
  have hT := tymA_31 d W s one_ne_zero H.hA H.hR H.hs
  rw [hE, hT]
  obtain ⟨-, hA, hR, hs, -, -, -, -, -, -, -, -, -, -, -, -, -, -, comm⟩ := H
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  have kW := comm 1 0 W
  have d2i : ∀ i, d i (2⁻¹ : S) = 0 := fun i => by rw [deriv_inv (d i) 2 two_ne_zero, deriv_ofNat (d i) 2]; ring
  simp only [Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx,
    map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one, inv_one, one_pow,
    iA, iR, kA, kR, kW, hl0, hl1, d2i, deriv_ofNat (d 0) 2, deriv_ofNat (d 1) 2,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  all_goals
    have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
    have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
    have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    generalize A⁻¹ = iA at hiA ⊢
    generalize R⁻¹ = iR at hiR ⊢
    generalize s⁻¹ = is at his ⊢
    linear_combination 0
set_option maxHeartbeats 0 in
theorem sync_32 (W A R s c l : S) (H : SphD d 1 A R s c) (hl0 : d 0 l = 0) (hl1 : d 1 l = 0) :
    Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) 3 2
      - 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (FT d W s) 3 2 = 0 := by
  have hE := einA_32 d 1 A R s c H
  have hT := tymA_32 d W s one_ne_zero H.hA H.hR H.hs
  rw [hE, hT]
  obtain ⟨-, hA, hR, hs, -, -, -, -, -, -, -, -, -, -, -, -, -, -, comm⟩ := H
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  have kW := comm 1 0 W
  have d2i : ∀ i, d i (2⁻¹ : S) = 0 := fun i => by rw [deriv_inv (d i) 2 two_ne_zero, deriv_ofNat (d i) 2]; ring
  simp only [Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx,
    map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one, inv_one, one_pow,
    iA, iR, kA, kR, kW, hl0, hl1, d2i, deriv_ofNat (d 0) 2, deriv_ofNat (d 1) 2,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  all_goals
    have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
    have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
    have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    generalize A⁻¹ = iA at hiA ⊢
    generalize R⁻¹ = iR at hiR ⊢
    generalize s⁻¹ = is at his ⊢
    linear_combination 0
set_option maxHeartbeats 0 in
theorem sync_33 (W A R s c l : S) (H : SphD d 1 A R s c) (hl0 : d 0 l = 0) (hl1 : d 1 l = 0) :
    Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) 3 3
      - 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (FT d W s) 3 3 = s ^ 2 * (R ^ 2 * (eKxα (d 0) (d 1) A R W l + eKTα (d 0) (d 1) A R W l + 2⁻¹ * Hα (d 0) (d 1) A R W l)) := by
  have hE := einA_33 d 1 A R s c H
  have hT := tymA_33 d W s one_ne_zero H.hA H.hR H.hs
  rw [hE, hT]
  obtain ⟨-, hA, hR, hs, -, -, -, -, -, -, -, -, -, -, -, -, -, -, comm⟩ := H
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  have kW := comm 1 0 W
  have d2i : ∀ i, d i (2⁻¹ : S) = 0 := fun i => by rw [deriv_inv (d i) 2 two_ne_zero, deriv_ofNat (d i) 2]; ring
  simp only [Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx,
    map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one, inv_one, one_pow,
    iA, iR, kA, kR, kW, hl0, hl1, d2i, deriv_ofNat (d 0) 2, deriv_ofNat (d 1) 2,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  all_goals
    have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
    have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
    have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    generalize A⁻¹ = iA at hiA ⊢
    generalize R⁻¹ = iR at hiR ⊢
    generalize s⁻¹ = is at his ⊢
    linear_combination ((1 : S) * (d 0 A) * R * (d 0 R) * iA * s ^ 2 + (1 : S) * (d 1 A) * R * (d 1 R) * iA ^ 3 * s ^ 2 + (1 : S) * R * (d 0 (d 0 R)) * s ^ 2 + (-1 : S) * R * (d 1 (d 1 R)) * iA ^ 2 * s ^ 2 + (1 : S) * R * W ^ 4 * iR ^ 3 * l ^ 2 * s ^ 2 + (-2 : S) * R * W ^ 2 * iR ^ 3 * l ^ 2 * s ^ 2 + (1 : S) * R * iR ^ 3 * l ^ 2 * s ^ 2 + (1 : S) * W ^ 4 * iR ^ 2 * l ^ 2 * s ^ 2 + (-2 : S) * W ^ 2 * iR ^ 2 * l ^ 2 * s ^ 2 + (1 : S) * iR ^ 2 * l ^ 2 * s ^ 2) * hiR
end Sync

section Equiv
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- YM の (1,θ) 成分 = −s eP(N = 1、ymD_split から) -/
theorem ym_sync_02 (W A R s c : S) (H : SphD d 1 A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2 = -(s * ePα (d 0) (d 1) A R W 0) := by
  rw [CFT.S4D.ymD_split d W 1 A R s c H W2 W3]
  simp only [ePα, map_add, map_sub, map_neg, map_mul, Derivation.leibniz, smul_eq_mul, H.s0, H.s1, inv_one,
    mul_one, one_mul, mul_zero, zero_mul, add_zero, zero_add]
  ring

/-- YM の (2,φ) 成分 × s = (1,θ) 成分 -/
theorem ym_sync_13 (W A R s c : S) (H : SphD d 1 A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    s * YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (FT d W s) 1 3
      = YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2 := by
  rw [ymA_13 d W 1 A R s c H W2 W3, ymA_02 d W 1 A R s c H W2 W3]; ring

theorem fin4_cases (μ : Fin 4) : μ = 0 ∨ μ = 1 ∨ μ = 2 ∨ μ = 3 := by
  fin_cases μ <;> simp

theorem fin3_cases (a : Fin 3) : a = 0 ∨ a = 1 ∨ a = 2 := by
  fin_cases a <;> simp

/-- 4 次元の EYM 方程式の全成分(Einstein 16、YM 12、F = dA + A∧A)⇔ α の五つの方程式 -/
theorem full_4d_iff_alpha (W A R s c l : S) (H : SphD d 1 A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0)
    (hl0 : d 0 l = 0) (hl1 : d 1 l = 0) :
    ((∀ μ ν, Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) μ ν
        = 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (Fym d (Aym W s c)) μ ν) ∧
      (∀ a n, YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (Fym d (Aym W s c)) a n = 0))
    ↔ (Hα (d 0) (d 1) A R W l = 0 ∧ Mα (d 0) (d 1) A R W l = 0 ∧ ePα (d 0) (d 1) A R W l = 0 ∧
        eKxα (d 0) (d 1) A R W l = 0 ∧ eKTα (d 0) (d 1) A R W l = 0) := by
  rw [fym_eq d W s c W2 W3 H.s0 H.s1 H.s2 H.s3 H.c0 H.c1 H.c2 H.c3]
  have hA := H.hA
  have hR := H.hR
  have hs := H.hs
  have eP0 : ePα (d 0) (d 1) A R W 0 = ePα (d 0) (d 1) A R W l := by simp only [ePα]
  have E : ∀ μ ν, (Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) μ ν
      = 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (FT d W s) μ ν) ↔
      Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) μ ν
        - 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (FT d W s) μ ν = 0 := fun μ ν => sub_eq_zero.symm
  constructor
  · rintro ⟨hE, hY⟩
    have e00 := (E 0 0).mp (hE 0 0); rw [sync_00 d W A R s c l H hl0 hl1] at e00
    have e01 := (E 0 1).mp (hE 0 1); rw [sync_01 d W A R s c l H hl0 hl1] at e01
    have e11 := (E 1 1).mp (hE 1 1); rw [sync_11 d W A R s c l H hl0 hl1] at e11
    have e22 := (E 2 2).mp (hE 2 2); rw [sync_22 d W A R s c l H hl0 hl1] at e22
    have y02 := hY 0 2; rw [ym_sync_02 d W A R s c H W2 W3, eP0] at y02
    have hH : Hα (d 0) (d 1) A R W l = 0 := by
      have := e00; simp only [mul_eq_zero, inv_eq_zero, two_ne_zero, false_or] at this; exact this
    have hM : Mα (d 0) (d 1) A R W l = 0 := by
      have := neg_eq_zero.mp e01; exact (mul_eq_zero.mp this).resolve_left hA
    have hT : eKTα (d 0) (d 1) A R W l = 0 := by
      rw [hH] at e11
      have := (mul_eq_zero.mp e11).resolve_left (pow_ne_zero 2 hA)
      linear_combination this / 2
    have hX : eKxα (d 0) (d 1) A R W l = 0 := by
      rw [hH, hT] at e22
      have := (mul_eq_zero.mp e22).resolve_left (pow_ne_zero 2 hR)
      linear_combination this
    have hP : ePα (d 0) (d 1) A R W l = 0 := by
      have := neg_eq_zero.mp y02; exact (mul_eq_zero.mp this).resolve_left hs
    exact ⟨hH, hM, hP, hX, hT⟩
  · rintro ⟨hH, hM, hP, hX, hT⟩
    constructor
    · intro μ ν
      rw [E]
      rcases fin4_cases μ with rfl | rfl | rfl | rfl <;> rcases fin4_cases ν with rfl | rfl | rfl | rfl
      all_goals first
        | rw [sync_00 d W A R s c l H hl0 hl1, hH]; ring
        | rw [sync_01 d W A R s c l H hl0 hl1, hM]; ring
        | rw [sync_02 d W A R s c l H hl0 hl1]
        | rw [sync_03 d W A R s c l H hl0 hl1]
        | rw [sync_10 d W A R s c l H hl0 hl1, hM]; ring
        | rw [sync_11 d W A R s c l H hl0 hl1, hH, hT]; ring
        | rw [sync_12 d W A R s c l H hl0 hl1]
        | rw [sync_13 d W A R s c l H hl0 hl1]
        | rw [sync_20 d W A R s c l H hl0 hl1]
        | rw [sync_21 d W A R s c l H hl0 hl1]
        | rw [sync_22 d W A R s c l H hl0 hl1, hH, hX, hT]; ring
        | rw [sync_23 d W A R s c l H hl0 hl1]
        | rw [sync_30 d W A R s c l H hl0 hl1]
        | rw [sync_31 d W A R s c l H hl0 hl1]
        | rw [sync_32 d W A R s c l H hl0 hl1]
        | rw [sync_33 d W A R s c l H hl0 hl1, hH, hX, hT]; ring
    · intro a n
      have y02 : YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2 = 0 := by
        rw [ym_sync_02 d W A R s c H W2 W3, eP0, hP]; ring
      have y13 : YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (FT d W s) 1 3 = 0 := by
        have h13 := ym_sync_13 d W A R s c H W2 W3; rw [y02] at h13
        exact (mul_eq_zero.mp h13).resolve_left hs
      rcases fin3_cases a with rfl | rfl | rfl <;> rcases fin4_cases n with rfl | rfl | rfl | rfl
      · exact ymA_00 d W 1 A R s c H W2 W3
      · exact ymA_01 d W 1 A R s c H W2 W3
      · exact y02
      · exact ymA_03 d W 1 A R s c H W2 W3
      · exact ymA_10 d W 1 A R s c H W2 W3
      · exact ymA_11 d W 1 A R s c H W2 W3
      · exact ymA_12 d W 1 A R s c H W2 W3
      · exact y13
      · exact ymA_20 d W 1 A R s c H W2 W3
      · exact ymA_21 d W 1 A R s c H W2 W3
      · exact ymA_22 d W 1 A R s c H W2 W3
      · exact ymA_23 d W 1 A R s c H W2 W3

/-- Palais なしの照合:4 次元の EYM 方程式の全成分 ⇔ 縮約した作用の五つの Euler–Lagrange 方程式
  (同期ゲージ N = 1、β = 0、full_4d_iff_alpha と el_iff_alpha を合成) -/
theorem palais_free (W A R s c l : S) (H : SphD d 1 A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0)
    (hl0 : d 0 l = 0) (hl1 : d 1 l = 0) (hl : l ≠ 0) :
    ((∀ μ ν, Ein d (gD 1 A R s) (giD 1 A R s) (GD d 1 A R s c) μ ν
        = 2 * l ^ 2 * Tym (gD 1 A R s) (giD 1 A R s) (Fym d (Aym W s c)) μ ν) ∧
      (∀ a n, YMeq d (giD 1 A R s) (1 * A * R ^ 2 * s) (Aym W s c) (Fym d (Aym W s c)) a n = 0))
    ↔ (EN (d 0) (d 1) 1 A R 0 W l = 0 ∧ Eb (d 0) (d 1) 1 A R 0 W l = 0 ∧ EW (d 0) (d 1) 1 A R 0 W l = 0 ∧
        EA (d 0) (d 1) 1 A R 0 W l = 0 ∧ ER (d 0) (d 1) 1 A R 0 W l = 0) := by
  rw [full_4d_iff_alpha d W A R s c l H W2 W3 hl0 hl1,
    el_iff_alpha (d 0) (d 1) A R W l H.hA H.hR hl (fun f => H.comm 0 1 f) hl0 hl1]

end Equiv

end CFT.S2M

/-
  段階 2(その 1):縮約した作用の変分から、α で使ってきた方程式をすべて導く

  球対称な計量 −N²dt² + A²(dx + β dt)² + R²dΩ² と磁気的な YM 場 W(t, x)。
  縮約した作用(角度の積分と 1/16πG を除く):
    L = L₁ − 4ℓ²[N W′²/A − A ẇ²/N + NA(1 − W²)²/(2R²)]、 ℓ² = 4πG/g²
    L₁ = 2AN + (2NR′² + 4RN′R′)/A − (2A/N)u² − (4R/N)uv、 u = Ṙ − βR′、 v = Ȧ − (Aβ)′、 ẇ = Ẇ − βW′
  L₁ は EH + GHY の一階の形(段階 1 の ghy_spherical、シフトを含む版は aux/S1/shift.py)。
  YM の項は −(1/4g²)√−g F^aF^a(球対称な磁気的配位の F² の公式)。g は ℓ² を通してだけ入る。
  * first_variation:変分 δ(dt, dx と可換な導分)について
      δL = δN·E_N + δA·E_A + δR·E_R + δβ·E_β + δW·E_W + ∂_t Θ_t + ∂_x Θ_x
    E_φ は Euler–Lagrange の式(aux/S2/gen.py が生成、形式的な恒等式として Lean で確認)。
  続き(AlphaS2_Match):同期ゲージ N = 1、β = 0 で E_φ が α の方程式(H、M、発展、YM)の可逆な一次結合になる。
-/
import CFT.AlphaIV_Propagation

namespace CFT.S2

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {S : Type*} [Field S] [CharZero S]

def Lag (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := (-2) * A * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * A * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + (-2) * A * N * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * A * N + (-4) * A * R * (dx R) * b * (dx b) * N⁻¹ + 4 * A * R * (dt R) * (dx b) * N⁻¹ + (-2) * A * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹ + 4 * A * (dx R) * (dt R) * b * N⁻¹ + (-2) * A * (dt R)^(2:ℕ) * N⁻¹ + 4 * A * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 4 * A * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * (dx R) * b^(2:ℕ) * N⁻¹ + 4 * (dx A) * R * (dt R) * b * N⁻¹ + 4 * (dt A) * R * (dx R) * b * N⁻¹ + (-4) * (dt A) * R * (dt R) * N⁻¹ + 2 * N * (dx R)^(2:ℕ) * A⁻¹ + (-4) * N * (dx W)^(2:ℕ) * A⁻¹ * l^(2:ℕ) + 4 * (dx N) * R * (dx R) * A⁻¹

def EN (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := 4 * A * R * (dx R) * b * (dx b) * N⁻¹^(2:ℕ) + (-4) * A * R * (dt R) * (dx b) * N⁻¹^(2:ℕ) + 2 * A * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * A * (dx R) * (dt R) * b * N⁻¹^(2:ℕ) + 2 * A * (dt R)^(2:ℕ) * N⁻¹^(2:ℕ) + (-2) * A * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * A * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + (-4) * A * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + 8 * A * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * A * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-2) * A * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * A + 4 * (dx A) * R * (dx R) * A⁻¹^(2:ℕ) + 4 * (dx A) * R * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * (dx A) * R * (dt R) * b * N⁻¹^(2:ℕ) + (-4) * (dt A) * R * (dx R) * b * N⁻¹^(2:ℕ) + 4 * (dt A) * R * (dt R) * N⁻¹^(2:ℕ) + (-4) * R * (dx (dx R)) * A⁻¹ + (-2) * (dx R)^(2:ℕ) * A⁻¹ + (-4) * (dx W)^(2:ℕ) * A⁻¹ * l^(2:ℕ)

def EA (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := (-2) * N * (dx R)^(2:ℕ) * A⁻¹^(2:ℕ) + (-2) * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * N * (dx W)^(2:ℕ) * A⁻¹^(2:ℕ) * l^(2:ℕ) + (-2) * N * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * N + (-4) * (dx N) * R * (dx R) * A⁻¹^(2:ℕ) + (-4) * (dx N) * R * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * (dx N) * R * (dt R) * b * N⁻¹^(2:ℕ) + 4 * (dt N) * R * (dx R) * b * N⁻¹^(2:ℕ) + (-4) * (dt N) * R * (dt R) * N⁻¹^(2:ℕ) + 4 * R * (dx R) * b * (dx b) * N⁻¹ + (-4) * R * (dx R) * (dt b) * N⁻¹ + 4 * R * (dx (dx R)) * b^(2:ℕ) * N⁻¹ + (-8) * R * (dx (dt R)) * b * N⁻¹ + 4 * R * (dt (dt R)) * N⁻¹ + 2 * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹ + (-4) * (dx R) * (dt R) * b * N⁻¹ + 2 * (dt R)^(2:ℕ) * N⁻¹ + 4 * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-8) * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 4 * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹

def ER (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := 4 * A * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(3:ℕ) + (-8) * A * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(3:ℕ) + 4 * A * N * l^(2:ℕ) * R⁻¹^(3:ℕ) + (-4) * A * (dx N) * R * b * (dx b) * N⁻¹^(2:ℕ) + (-4) * A * (dx N) * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * A * (dx N) * (dt R) * b * N⁻¹^(2:ℕ) + 4 * A * (dt N) * R * (dx b) * N⁻¹^(2:ℕ) + 4 * A * (dt N) * (dx R) * b * N⁻¹^(2:ℕ) + (-4) * A * (dt N) * (dt R) * N⁻¹^(2:ℕ) + 4 * A * R * b * (dx (dx b)) * N⁻¹ + 4 * A * R * (dx b)^(2:ℕ) * N⁻¹ + (-4) * A * R * (dx (dt b)) * N⁻¹ + 8 * A * (dx R) * b * (dx b) * N⁻¹ + (-4) * A * (dx R) * (dt b) * N⁻¹ + 4 * A * (dx (dx R)) * b^(2:ℕ) * N⁻¹ + (-4) * A * (dt R) * (dx b) * N⁻¹ + (-8) * A * (dx (dt R)) * b * N⁻¹ + 4 * A * (dt (dt R)) * N⁻¹ + 4 * (dx A) * N * (dx R) * A⁻¹^(2:ℕ) + 4 * (dx A) * (dx N) * R * A⁻¹^(2:ℕ) + (-4) * (dx A) * (dx N) * R * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * (dx A) * (dt N) * R * b * N⁻¹^(2:ℕ) + 12 * (dx A) * R * b * (dx b) * N⁻¹ + (-4) * (dx A) * R * (dt b) * N⁻¹ + 4 * (dx A) * (dx R) * b^(2:ℕ) * N⁻¹ + (-4) * (dx A) * (dt R) * b * N⁻¹ + 4 * (dx (dx A)) * R * b^(2:ℕ) * N⁻¹ + 4 * (dt A) * (dx N) * R * b * N⁻¹^(2:ℕ) + (-4) * (dt A) * (dt N) * R * N⁻¹^(2:ℕ) + (-8) * (dt A) * R * (dx b) * N⁻¹ + (-4) * (dt A) * (dx R) * b * N⁻¹ + 4 * (dt A) * (dt R) * N⁻¹ + (-8) * (dx (dt A)) * R * b * N⁻¹ + 4 * (dt (dt A)) * R * N⁻¹ + (-4) * N * (dx (dx R)) * A⁻¹ + (-4) * (dx N) * (dx R) * A⁻¹ + (-4) * (dx (dx N)) * R * A⁻¹

def Eb (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := (-4) * A * (dx N) * R * (dx R) * b * N⁻¹^(2:ℕ) + 4 * A * (dx N) * R * (dt R) * N⁻¹^(2:ℕ) + 4 * A * R * (dx (dx R)) * b * N⁻¹ + (-4) * A * R * (dx (dt R)) * N⁻¹ + 8 * A * (dx W)^(2:ℕ) * b * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx W) * (dt W) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * (dx R) * b * N⁻¹ + 4 * (dt A) * R * (dx R) * N⁻¹

def EW (dt dx : Derivation ℤ S S) (N A R b W l : S) : S := (-8) * A * N * W^(3:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 8 * A * N * W * l^(2:ℕ) * R⁻¹^(2:ℕ) + 8 * A * (dx N) * (dx W) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-8) * A * (dx N) * (dt W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-8) * A * (dt N) * (dx W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + 8 * A * (dt N) * (dt W) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-16) * A * (dx W) * b * (dx b) * l^(2:ℕ) * N⁻¹ + 8 * A * (dx W) * (dt b) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx (dx W)) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + 8 * A * (dt W) * (dx b) * l^(2:ℕ) * N⁻¹ + 16 * A * (dx (dt W)) * b * l^(2:ℕ) * N⁻¹ + (-8) * A * (dt (dt W)) * l^(2:ℕ) * N⁻¹ + (-8) * (dx A) * N * (dx W) * A⁻¹^(2:ℕ) * l^(2:ℕ) + (-8) * (dx A) * (dx W) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + 8 * (dx A) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 8 * (dt A) * (dx W) * b * l^(2:ℕ) * N⁻¹ + (-8) * (dt A) * (dt W) * l^(2:ℕ) * N⁻¹ + 8 * N * (dx (dx W)) * A⁻¹ * l^(2:ℕ) + 8 * (dx N) * (dx W) * A⁻¹ * l^(2:ℕ)

def Tht (dt dx δ : Derivation ℤ S S) (N A R b W l : S) : S := 4 * A * R * (dx b) * (δ R) * N⁻¹ + 4 * A * (dx R) * b * (δ R) * N⁻¹ + (-4) * A * (dt R) * (δ R) * N⁻¹ + (-8) * A * (dx W) * b * (δ W) * l^(2:ℕ) * N⁻¹ + 8 * A * (dt W) * (δ W) * l^(2:ℕ) * N⁻¹ + 4 * (dx A) * R * b * (δ R) * N⁻¹ + (-4) * (dt A) * R * (δ R) * N⁻¹ + 4 * R * (dx R) * b * (δ A) * N⁻¹ + (-4) * R * (dt R) * (δ A) * N⁻¹

def Thx (dt dx δ : Derivation ℤ S S) (N A R b W l : S) : S := (-4) * A * R * (dx R) * b * (δ b) * N⁻¹ + 4 * A * R * (dt R) * (δ b) * N⁻¹ + (-4) * A * R * b * (dx b) * (δ R) * N⁻¹ + (-4) * A * (dx R) * b^(2:ℕ) * (δ R) * N⁻¹ + 4 * A * (dt R) * b * (δ R) * N⁻¹ + 8 * A * (dx W) * b^(2:ℕ) * (δ W) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dt W) * b * (δ W) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * b^(2:ℕ) * (δ R) * N⁻¹ + 4 * (dt A) * R * b * (δ R) * N⁻¹ + 4 * N * (dx R) * A⁻¹ * (δ R) + (-8) * N * (dx W) * A⁻¹ * (δ W) * l^(2:ℕ) + 4 * (dx N) * R * A⁻¹ * (δ R) + 4 * R * (dx R) * A⁻¹ * (δ N) + (-4) * R * (dx R) * b^(2:ℕ) * (δ A) * N⁻¹ + 4 * R * (dt R) * b * (δ A) * N⁻¹

theorem first_variation (dt dx δ : Derivation ℤ S S) (N A R b W l : S)
    (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hδt : ∀ f, δ (dt f) = dt (δ f)) (hδx : ∀ f, δ (dx f) = dx (δ f))
    (hlt : dt l = 0) (hlx : dx l = 0) (hld : δ l = 0) :
    δ (Lag dt dx N A R b W l) = δ N * EN dt dx N A R b W l + δ A * EA dt dx N A R b W l
      + δ R * ER dt dx N A R b W l + δ b * Eb dt dx N A R b W l + δ W * EW dt dx N A R b W l
      + dt (Tht dt dx δ N A R b W l) + dx (Thx dt dx δ N A R b W l) := by
  simp only [Lag, EN, EA, ER, Eb, EW, Tht, Thx, map_add, map_sub, map_neg, Derivation.leibniz,
    Derivation.leibniz_pow, smul_eq_mul, CFT.Propagation.deriv_inv _ _ hN, CFT.Propagation.deriv_inv _ _ hA,
    CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat δ 2, CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4,
    CFT.Propagation.deriv_ofNat δ 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    CFT.Propagation.deriv_ofNat δ 8, Derivation.map_one_eq_zero, hc, hδt, hδx, hlt, hlx, hld,
    nsmul_eq_mul, Nat.cast_ofNat]
  ring

end CFT.S2

/-
  段階 2(その 2):同期ゲージ N = 1、β = 0 で、作用の Euler–Lagrange の式は α の方程式の一次結合
    E_N = A R² · H(ハミルトン拘束、AlphaIV_Propagation の Hc)
    E_β = −2A²R² · M(運動量拘束、Mc)
    E_W = −8ℓ² ·(YM の発展方程式 ∂_t P = ∂_x(∂_xW/A) + AW(1 − W²)/R²、P = A∂_tW)
    E_A = −4R² ·(K_T の発展方程式) − R² · H
    E_R = −4AR ·(K_x の発展方程式 + K_T の発展方程式) − 2AR · H
  ここで K_x = −∂_tA/A、K_T = −∂_tR/R、P = A∂_tW、κ = 2ℓ²(拘束の伝播 AlphaIV_Propagation の変数)。
  * el_iff_alpha:A, R, ℓ ≠ 0 なら、五つの EL の式がすべて 0 ⇔ α の五つの方程式(H = M = 0 と三つの発展方程式)。
  したがって α で入力としてきた場の方程式は、段階 1 で導いた作用の帰結である(仮定ではない)。
  証明:aux/S2/match.py が A·A⁻¹ = 1、R·R⁻¹ = 1 に関する一次結合の係数を出し、linear_combination で閉じる。
-/
import CFT.AlphaS2_Action

namespace CFT.S2

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {S : Type*} [Field S] [CharZero S]

/-- α の拘束と発展方程式(同期ゲージ、K_x = −∂_tA/A、K_T = −∂_tR/R、P = A∂_tW、κ = 2ℓ²) -/
def Hα (dt dx : Derivation ℤ S S) (A R W l : S) : S := CFT.Propagation.Hc dx A R (-(dt A * A⁻¹)) (-(dt R * R⁻¹)) W (A * dt W) (2 * l ^ 2)
def Mα (dt dx : Derivation ℤ S S) (A R W l : S) : S := CFT.Propagation.Mc dx A R (-(dt A * A⁻¹)) (-(dt R * R⁻¹)) W (A * dt W) (2 * l ^ 2)
def ePα (dt dx : Derivation ℤ S S) (A R W l : S) : S := (dt (A * dt W) - (dx (dx W * A⁻¹) + A * W * (1 - W ^ 2) * R⁻¹ ^ 2))
def eKxα (dt dx : Derivation ℤ S S) (A R W l : S) : S := (dt (-(dt A * A⁻¹)) - (-2 * (CFT.Propagation.Dx dx A (CFT.Propagation.Dx dx A R)) * R⁻¹ + ((-(dt A * A⁻¹)) + 2 * (-(dt R * R⁻¹))) * (-(dt A * A⁻¹)) - (2 * l ^ 2) * ((((A * dt W) * A⁻¹) ^ 2 + (CFT.Propagation.Dx dx A W) ^ 2) * R⁻¹ ^ 2 - (1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 * 2⁻¹)))
def eKTα (dt dx : Derivation ℤ S S) (A R W l : S) : S := (dt (-(dt R * R⁻¹)) - ((1 - (CFT.Propagation.Dx dx A R) ^ 2 - R * (CFT.Propagation.Dx dx A (CFT.Propagation.Dx dx A R))) * R⁻¹ ^ 2 + ((-(dt A * A⁻¹)) + 2 * (-(dt R * R⁻¹))) * (-(dt R * R⁻¹)) - (2 * l ^ 2) * ((1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 * 2⁻¹)))

theorem match_N (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    EN dt dx 1 A R 0 W l = A * R ^ 2 * Hα dt dx A R W l := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dx 2]; ring
  simp only [EN, Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    CFT.Propagation.deriv_inv _ _ hA, CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination (4 * A^(2:ℕ) * R^(2:ℕ) * (dt W)^(2:ℕ) * a * l^(2:ℕ) * r^(2:ℕ) + 4 * A * R^(2:ℕ) * (dt W)^(2:ℕ) * l^(2:ℕ) * r^(2:ℕ) + (-2) * (dx A) * R^(3:ℕ) * (dx R) * a^(2:ℕ) * r^(2:ℕ) + (-2) * (dx A) * R^(2:ℕ) * (dx R) * a^(2:ℕ) * r + (-4) * (dt A) * R^(2:ℕ) * (dt R) * r + 2 * R^(3:ℕ) * (dx (dx R)) * a * r^(2:ℕ) + 2 * R^(2:ℕ) * (dx R)^(2:ℕ) * a * r^(2:ℕ) + 2 * R^(2:ℕ) * (dx (dx R)) * a * r + 4 * R^(2:ℕ) * (dx W)^(2:ℕ) * a * l^(2:ℕ) * r^(2:ℕ)) * ha + ((-2) * A * R * (dt R)^(2:ℕ) * r + 2 * A * R * W^(4:ℕ) * l^(2:ℕ) * r^(3:ℕ) + (-4) * A * R * W^(2:ℕ) * l^(2:ℕ) * r^(3:ℕ) + 4 * A * R * (dt W)^(2:ℕ) * l^(2:ℕ) * r + 2 * A * R * l^(2:ℕ) * r^(3:ℕ) + (-2) * A * R * r + (-2) * A * (dt R)^(2:ℕ) + 2 * A * W^(4:ℕ) * l^(2:ℕ) * r^(2:ℕ) + (-4) * A * W^(2:ℕ) * l^(2:ℕ) * r^(2:ℕ) + 4 * A * (dt W)^(2:ℕ) * l^(2:ℕ) + 2 * A * l^(2:ℕ) * r^(2:ℕ) + (-2) * A + (-2) * (dx A) * R^(2:ℕ) * (dx R) * a^(2:ℕ) * r + (-4) * (dx A) * R * (dx R) * a^(2:ℕ) + (-4) * (dt A) * R * (dt R) + 2 * R^(2:ℕ) * (dx (dx R)) * a * r + 2 * R * (dx R)^(2:ℕ) * a * r + 4 * R * (dx (dx R)) * a + 4 * R * (dx W)^(2:ℕ) * a * l^(2:ℕ) * r + 2 * (dx R)^(2:ℕ) * a + 4 * (dx W)^(2:ℕ) * a * l^(2:ℕ)) * hb

theorem match_b (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    Eb dt dx 1 A R 0 W l = -2 * A ^ 2 * R ^ 2 * Mα dt dx A R W l := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dx 2]; ring
  simp only [Eb, Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    CFT.Propagation.deriv_inv _ _ hA, CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination (8 * A^(2:ℕ) * R^(2:ℕ) * (dx W) * (dt W) * a * l^(2:ℕ) * r^(2:ℕ) + (-4) * A * (dt A) * R^(2:ℕ) * (dx R) * a * r + 4 * A * R^(2:ℕ) * (dx (dt R)) * r + 8 * A * R^(2:ℕ) * (dx W) * (dt W) * l^(2:ℕ) * r^(2:ℕ) + (-4) * (dt A) * R^(2:ℕ) * (dx R) * r) * ha + (4 * A * R * (dx (dt R)) + 8 * A * R * (dx W) * (dt W) * l^(2:ℕ) * r + 8 * A * (dx W) * (dt W) * l^(2:ℕ) + (-4) * (dt A) * R * (dx R)) * hb

theorem match_W (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    EW dt dx 1 A R 0 W l = -8 * l ^ 2 * ePα dt dx A R W l := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dx 2]; ring
  simp only [EW, Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    CFT.Propagation.deriv_inv _ _ hA, CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination 0

theorem match_A (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    EA dt dx 1 A R 0 W l = -4 * R ^ 2 * eKTα dt dx A R W l - R ^ 2 * Hα dt dx A R W l := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dx 2]; ring
  simp only [EA, Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    CFT.Propagation.deriv_inv _ _ hA, CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination ((-4) * A * R^(2:ℕ) * (dt W)^(2:ℕ) * a * l^(2:ℕ) * r^(2:ℕ) + (-4) * R^(2:ℕ) * (dt W)^(2:ℕ) * l^(2:ℕ) * r^(2:ℕ)) * ha + ((-2) * (dx A) * R^(2:ℕ) * (dx R) * a^(3:ℕ) * r + 2 * R^(2:ℕ) * (dx (dx R)) * a^(2:ℕ) * r + 2 * R * (dx R)^(2:ℕ) * a^(2:ℕ) * r + (-2) * R * (dt R)^(2:ℕ) * r + (-4) * R * (dt (dt R)) + 2 * R * W^(4:ℕ) * l^(2:ℕ) * r^(3:ℕ) + (-4) * R * W^(2:ℕ) * l^(2:ℕ) * r^(3:ℕ) + (-4) * R * (dx W)^(2:ℕ) * a^(2:ℕ) * l^(2:ℕ) * r + (-4) * R * (dt W)^(2:ℕ) * l^(2:ℕ) * r + 2 * R * l^(2:ℕ) * r^(3:ℕ) + (-2) * R * r + 2 * (dx R)^(2:ℕ) * a^(2:ℕ) + (-2) * (dt R)^(2:ℕ) + 2 * W^(4:ℕ) * l^(2:ℕ) * r^(2:ℕ) + (-4) * W^(2:ℕ) * l^(2:ℕ) * r^(2:ℕ) + (-4) * (dx W)^(2:ℕ) * a^(2:ℕ) * l^(2:ℕ) + (-4) * (dt W)^(2:ℕ) * l^(2:ℕ) + 2 * l^(2:ℕ) * r^(2:ℕ) + (-2)) * hb

theorem match_R (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    ER dt dx 1 A R 0 W l = -4 * A * R * (eKxα dt dx A R W l + eKTα dt dx A R W l) - 2 * A * R * Hα dt dx A R W l := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [CFT.Propagation.deriv_inv _ _ two_ne_zero, CFT.Propagation.deriv_ofNat dx 2]; ring
  simp only [ER, Hα, Mα, ePα, eKxα, eKTα, CFT.Propagation.Hc, CFT.Propagation.Mc, CFT.Propagation.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    CFT.Propagation.deriv_inv _ _ hA, CFT.Propagation.deriv_inv _ _ hR, CFT.Propagation.deriv_ofNat dt 2, CFT.Propagation.deriv_ofNat dx 2,
    CFT.Propagation.deriv_ofNat dt 4, CFT.Propagation.deriv_ofNat dx 4, CFT.Propagation.deriv_ofNat dt 8, CFT.Propagation.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination ((-4) * (dx A) * R * (dx R) * a^(2:ℕ) * r + (-4) * (dt A) * R * (dt R) * r + (-4) * (dt (dt A)) * R + 4 * R * (dx (dx R)) * a * r) * ha + ((-4) * A * (dt (dt R)) + (-4) * A * W^(4:ℕ) * l^(2:ℕ) * r^(3:ℕ) + 8 * A * W^(2:ℕ) * l^(2:ℕ) * r^(3:ℕ) + (-4) * A * l^(2:ℕ) * r^(3:ℕ) + (-4) * (dx A) * (dx R) * a^(2:ℕ) + (-4) * (dt A) * (dt R) + 4 * (dx (dx R)) * a) * hb

/-- 抽象的な形:五つの一次の関係と A, R, ℓ ≠ 0 から、EL の式がすべて 0 ⇔ α の方程式がすべて成り立つ -/
theorem el_iff_abstract (A R l EN Eb EW EA ER H M eP eKx eKT : S) (hA : A ≠ 0) (hR : R ≠ 0) (hl : l ≠ 0)
    (h1 : EN = A * R ^ 2 * H) (h2 : Eb = -2 * A ^ 2 * R ^ 2 * M) (h3 : EW = -8 * l ^ 2 * eP)
    (h4 : EA = -4 * R ^ 2 * eKT - R ^ 2 * H) (h5 : ER = -4 * A * R * (eKx + eKT) - 2 * A * R * H) :
    (EN = 0 ∧ Eb = 0 ∧ EW = 0 ∧ EA = 0 ∧ ER = 0) ↔ (H = 0 ∧ M = 0 ∧ eP = 0 ∧ eKx = 0 ∧ eKT = 0) := by
  have hR2 : R ^ 2 ≠ 0 := pow_ne_zero 2 hR
  have hl2 : l ^ 2 ≠ 0 := pow_ne_zero 2 hl
  constructor
  · rintro ⟨e1, e2, e3, e4, e5⟩
    have hH : H = 0 := by
      rw [h1] at e1; rcases mul_eq_zero.mp e1 with h | h
      · exact absurd h (mul_ne_zero hA hR2)
      · exact h
    have hM : M = 0 := by
      rw [h2] at e2; rcases mul_eq_zero.mp e2 with h | h
      · exact absurd h (by simp [hA, hR])
      · exact h
    have hP : eP = 0 := by
      rw [h3] at e3; rcases mul_eq_zero.mp e3 with h | h
      · exact absurd h (by simp [hl])
      · exact h
    have hT : eKT = 0 := by
      rw [h4, hH] at e4
      have : R ^ 2 * eKT = 0 := by linear_combination (-1/4 : S) * e4
      exact (mul_eq_zero.mp this).resolve_left hR2
    have hX : eKx = 0 := by
      rw [h5, hH, hT] at e5
      have : (A * R) * eKx = 0 := by linear_combination (-1/4 : S) * e5
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hA hR)
    exact ⟨hH, hM, hP, hX, hT⟩
  · rintro ⟨hH, hM, hP, hX, hT⟩
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [h1, hH, mul_zero]
    · rw [h2, hM, mul_zero]
    · rw [h3, hP, mul_zero]
    · rw [h4, hT, hH]; ring
    · rw [h5, hX, hT, hH]; ring

/-- 段階 2 の結論:縮約した作用の Euler–Lagrange 方程式 ⇔ α の場の方程式(同期ゲージ) -/
theorem el_iff_alpha (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0) (hl : l ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    (EN dt dx 1 A R 0 W l = 0 ∧ Eb dt dx 1 A R 0 W l = 0 ∧ EW dt dx 1 A R 0 W l = 0 ∧
      EA dt dx 1 A R 0 W l = 0 ∧ ER dt dx 1 A R 0 W l = 0) ↔
    (Hα dt dx A R W l = 0 ∧ Mα dt dx A R W l = 0 ∧ ePα dt dx A R W l = 0 ∧
      eKxα dt dx A R W l = 0 ∧ eKTα dt dx A R W l = 0) :=
  el_iff_abstract A R l _ _ _ _ _ _ _ _ _ _ hA hR hl
    (match_N dt dx A R W l hA hR hc hlt hlx) (match_b dt dx A R W l hA hR hc hlt hlx)
    (match_W dt dx A R W l hA hR hc hlt hlx) (match_A dt dx A R W l hA hR hc hlt hlx)
    (match_R dt dx A R W l hA hR hc hlt hlx)

end CFT.S2

/-
  段階 3 の閉鎖:α-II.4 の厳密な窓と α-III.6 の非自明な平坦極限(2026-10-21 の外部監査の論証を Lean に)

  A. α-II.4:旧 window は角括弧が負であること(hneg)を仮定に置いていた。Bochner から出るのは κ ≤ 0 だけ。
    * disc_identity:Σc = 0、Σ_{i<j}c_ic_j = −3/4、c₁c₂c₃ = C/4 なら Π_{i<j}(c_i − c_j)² = (27/16)(1 − C²)
    * C_strict:c が相異なれば −1 < C < 1
    * window_strict:t > 0、t² = 12 − 2x(x = R ℓ²)、角括弧 2ℓ√R + tC ≤ 0、C > −1 ⇒ x < 2
    * strict_window:相異なる固有値 λ が (I) の関係 Σλ² = R²/4 + R/(2ℓ²) を満たし κ ≤ 0 なら 0 < Rℓ² < 2。
      角度の表示 λ_i = R/3 + q c_i は仮定せず、λ から作る(R > 0 と Rℓ² < 6 も固有値の相異から出る)
    * c2_window:C2 枠の各点で、固有値が相異なり (I) が成り立つなら 0 < Rℓ² < 2(kappa_nonpos と合わせる)
  B. α-III.6:密度 ρ₀ > 0 を固定し、帽子の半径 a → ∞ と G(a) = 3/(8πρ₀a²) → 0 を同時にとる
    (6/a² = 16πG(a)ρ₀ を保つ)。固有半径 s を固定して
    * flat_r:r_a(s) = a sin(s/a) → s、flat_rp:r_a′ = cos(s/a) → 1、flat_G:G(a) → 0
    * cap_mass_exact:m_a = M₂/(2G(a)) = (4π/3)ρ₀ r_a³(有限の a で厳密)
    * flat_mass:m_a(s) → (4π/3)ρ₀ s³、cap_mass_rate:dm_a/ds = 4πρ₀ r_a² r_a′、flat_mass_rate_limit:→ 4πρ₀ s²
    G を固定して a → ∞ とすると ρ = 3/(8πGa²) → 0 で真空に退化するので、非零の密度には同時の極限が要る。
-/
import CFT.Cartan.BochnerSign
import CFT.AlphaII
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv
import Mathlib.Analysis.Calculus.Deriv.Slope

open Real Filter Topology

namespace CFT.S3

/-! ### A. α-II.4 の厳密な窓 -/

theorem disc_identity (c1 c2 c3 C : ℝ) (he1 : c1 + c2 + c3 = 0) (he2 : c1 * c2 + c2 * c3 + c3 * c1 = -3 / 4)
    (he3 : c1 * c2 * c3 = C / 4) :
    (c1 - c2) ^ 2 * (c2 - c3) ^ 2 * (c1 - c3) ^ 2 = 27 / 16 * (1 - C ^ 2) := by
  have h3 : c3 = -c1 - c2 := by linarith
  subst h3
  have hC : C = 4 * (c1 * c2 * (-c1 - c2)) := by linarith
  subst hC
  linear_combination (-4*c1^4 - 8*c1^3*c2 - 12*c1^2*c2^2 - 3*c1^2 - 8*c1*c2^3 - 3*c1*c2 - 4*c2^4
    - 3*c2^2 - 9/4) * he2

theorem C_strict (c1 c2 c3 C : ℝ) (he1 : c1 + c2 + c3 = 0) (he2 : c1 * c2 + c2 * c3 + c3 * c1 = -3 / 4)
    (he3 : c1 * c2 * c3 = C / 4) (h12 : c1 ≠ c2) (h23 : c2 ≠ c3) (h13 : c1 ≠ c3) :
    -1 < C ∧ C < 1 := by
  have hd := disc_identity c1 c2 c3 C he1 he2 he3
  have hpos : 0 < (c1 - c2) ^ 2 * (c2 - c3) ^ 2 * (c1 - c3) ^ 2 := by
    have := sub_ne_zero.mpr h12; have := sub_ne_zero.mpr h23; have := sub_ne_zero.mpr h13
    positivity
  rw [hd] at hpos
  have h1 : C ^ 2 < 1 := by linarith
  exact abs_lt.mp ((sq_lt_one_iff_abs_lt_one C).mp h1)

/-- 角括弧 ≤ 0 と C > −1 から x < 2(旧 window の hneg を弱めた形) -/
theorem window_strict (sR l t C : ℝ) (hsR : 0 < sR) (hl : 0 < l) (ht : 0 < t)
    (ht2 : t ^ 2 = 12 - 2 * (sR ^ 2 * l ^ 2)) (hC : -1 < C) (hbr : 2 * l * sR + t * C ≤ 0) :
    sR ^ 2 * l ^ 2 < 2 := by
  by_contra hx
  push_neg at hx
  have h1 : t ≤ 2 * l * sR := by
    have : t ^ 2 ≤ (2 * l * sR) ^ 2 := by nlinarith
    have h0 : 0 ≤ 2 * l * sR := by positivity
    nlinarith [sq_nonneg (t - 2 * l * sR), sq_nonneg (t + 2 * l * sR)]
  have h2 : -t < t * C := by nlinarith
  linarith

set_option maxHeartbeats 4000000 in
/-- 固有値から:相異なる λ、(I) の関係、κ ≤ 0 ⇒ 0 < Rℓ² < 2 -/
theorem strict_window (l1 l2 l3 l : ℝ) (hl : 0 < l) (h12 : l1 ≠ l2) (h23 : l2 ≠ l3) (h13 : l1 ≠ l3)
    (hI : l1 ^ 2 + l2 ^ 2 + l3 ^ 2 = (l1 + l2 + l3) ^ 2 / 4 + (l1 + l2 + l3) / (2 * l ^ 2))
    (hκ : (l1 + l2 - (l1 + l2 + l3) / 2) * (l1 - l2) ^ 2 + (l2 + l3 - (l1 + l2 + l3) / 2) * (l2 - l3) ^ 2
      + (l1 + l3 - (l1 + l2 + l3) / 2) * (l1 - l3) ^ 2 ≤ 0) :
    0 < (l1 + l2 + l3) * l ^ 2 ∧ (l1 + l2 + l3) * l ^ 2 < 2 := by
  obtain ⟨R, hR⟩ : ∃ R, R = l1 + l2 + l3 := ⟨_, rfl⟩
  rw [← hR] at hI hκ ⊢
  have hl2 : 0 < l ^ 2 := by positivity
  have hI' : (l1 ^ 2 + l2 ^ 2 + l3 ^ 2) * (4 * l ^ 2) = R ^ 2 * l ^ 2 + 2 * R := by
    rw [hI]; field_simp; ring
  have hspread : 0 < (l1 - l2) ^ 2 + (l2 - l3) ^ 2 + (l1 - l3) ^ 2 := by
    have := sub_ne_zero.mpr h12; positivity
  have key : R * (6 - R * l ^ 2) = 4 * l ^ 2 * ((l1 - l2) ^ 2 + (l2 - l3) ^ 2 + (l1 - l3) ^ 2) := by
    rw [hR] at hI' ⊢; linear_combination (-3 : ℝ) * hI'
  have hprod : 0 < R * (6 - R * l ^ 2) := by rw [key]; positivity
  have hRpos : 0 < R := by
    by_contra h; push_neg at h
    have : 0 ≤ 6 - R * l ^ 2 := by nlinarith
    nlinarith
  have h6 : R * l ^ 2 < 6 := by
    by_contra h; push_neg at h; nlinarith
  refine ⟨by positivity, ?_⟩
  obtain ⟨sR, hsR⟩ : ∃ sR, sR = √R := ⟨_, rfl⟩
  have hsR0 : 0 < sR := by rw [hsR]; exact Real.sqrt_pos.mpr hRpos
  have hsR2 : sR ^ 2 = R := by rw [hsR]; exact Real.sq_sqrt hRpos.le
  obtain ⟨t, htd⟩ : ∃ t, t = √(12 - 2 * (sR ^ 2 * l ^ 2)) := ⟨_, rfl⟩
  have ht0 : 0 < t := by rw [htd]; exact Real.sqrt_pos.mpr (by rw [hsR2]; linarith)
  have ht2 : t ^ 2 = 12 - 2 * (sR ^ 2 * l ^ 2) := by rw [htd]; exact Real.sq_sqrt (by rw [hsR2]; linarith)
  obtain ⟨q, hq⟩ : ∃ q, q = sR * t / (6 * l) := ⟨_, rfl⟩
  have hq0 : 0 < q := by rw [hq]; positivity
  have hqne : q ≠ 0 := hq0.ne'
  obtain ⟨c1, hc1⟩ : ∃ c, c = (l1 - R / 3) / q := ⟨_, rfl⟩
  obtain ⟨c2, hc2⟩ : ∃ c, c = (l2 - R / 3) / q := ⟨_, rfl⟩
  obtain ⟨c3, hc3⟩ : ∃ c, c = (l3 - R / 3) / q := ⟨_, rfl⟩
  have hl1 : l1 = R / 3 + q * c1 := by rw [hc1]; field_simp; ring
  have hl2' : l2 = R / 3 + q * c2 := by rw [hc2]; field_simp; ring
  have hl3 : l3 = R / 3 + q * c3 := by rw [hc3]; field_simp; ring
  have he1 : c1 + c2 + c3 = 0 := by
    have : q * (c1 + c2 + c3) = 0 := by linear_combination -(hl1 + hl2' + hl3) - hR
    exact (mul_eq_zero.mp this).resolve_left hqne
  have hq2 : q ^ 2 * (36 * l ^ 2) = R * t ^ 2 := by
    rw [hq, ← hsR2]; field_simp; ring
  have hsq : q ^ 2 * (c1 ^ 2 + c2 ^ 2 + c3 ^ 2) = 3 / 2 * q ^ 2 := by
    -- Σ(λ − R/3)² = R(6 − Rℓ²)/(12ℓ²) = (3/2)q²
    have hs : (q * c1) ^ 2 + (q * c2) ^ 2 + (q * c3) ^ 2 = (l1 ^ 2 + l2 ^ 2 + l3 ^ 2) - R ^ 2 / 3 := by
      have e1 : q * c1 = l1 - R / 3 := by linarith
      have e2 : q * c2 = l2 - R / 3 := by linarith
      have e3 : q * c3 = l3 - R / 3 := by linarith
      rw [e1, e2, e3, hR]; ring
    have hS : (l1 ^ 2 + l2 ^ 2 + l3 ^ 2) - R ^ 2 / 3 = R * (6 - R * l ^ 2) / (12 * l ^ 2) := by
      rw [eq_div_iff (by positivity)]; linear_combination (3 : ℝ) * hI'
    have h36 : R * (6 - R * l ^ 2) / (12 * l ^ 2) = 3 / 2 * q ^ 2 := by
      have hlne : l ≠ 0 := hl.ne'
      rw [div_eq_iff (by positivity)]
      have : t ^ 2 = 12 - 2 * (R * l ^ 2) := by rw [ht2, hsR2]
      linear_combination (-1/2 : ℝ) * hq2 - (R / 2) * this
    linear_combination hs + hS + h36
  have hsq' : c1 ^ 2 + c2 ^ 2 + c3 ^ 2 = 3 / 2 := by
    have := pow_ne_zero 2 hqne
    have h := hsq; rw [← sub_eq_zero] at h
    have : q ^ 2 * (c1 ^ 2 + c2 ^ 2 + c3 ^ 2 - 3 / 2) = 0 := by linear_combination h
    linarith [(mul_eq_zero.mp this).resolve_left (pow_ne_zero 2 hqne)]
  have he2 : c1 * c2 + c2 * c3 + c3 * c1 = -3 / 4 := by
    have : (c1 + c2 + c3) ^ 2 = 0 := by rw [he1]; ring
    linear_combination (1/2 : ℝ) * this - (1/2 : ℝ) * hsq'
  obtain ⟨C, hCd⟩ : ∃ C, C = 4 * (c1 * c2 * c3) := ⟨_, rfl⟩
  have he3 : c1 * c2 * c3 = C / 4 := by rw [hCd]; ring
  have hc12 : c1 ≠ c2 := by intro h; apply h12; rw [hl1, hl2', h]
  have hc23 : c2 ≠ c3 := by intro h; apply h23; rw [hl2', hl3, h]
  have hc13 : c1 ≠ c3 := by intro h; apply h13; rw [hl1, hl3, h]
  have hCs := (C_strict c1 c2 c3 C he1 he2 he3 hc12 hc23 hc13).1
  have hk0 := CFT.AlphaII.kappa_closed sR t l C c1 c2 c3 hl.ne' he1 he2 he3 (by rw [ht2]; ring)
  have hsym := CFT.AlphaII.kappa_sym l1 l2 l3
  simp only at hk0 hsym
  have e : (l1 + l2 + l3) ^ 3 - 4 * (l1 + l2 + l3) * (l1 * l2 + l2 * l3 + l3 * l1) + 9 * (l1 * l2 * l3)
      = (6 - R * l ^ 2) * sR ^ 3 / (48 * l ^ 3) * (2 * l * sR + t * C) := by
    rw [hl1, hl2', hl3, ← hsR2, hq]
    linear_combination hk0
  have hκ' : (6 - R * l ^ 2) * sR ^ 3 / (48 * l ^ 3) * (2 * l * sR + t * C) ≤ 0 := by
    rw [← e, ← hsym]; rw [hR] at hκ; linarith [hκ]
  have hpre : 0 < (6 - R * l ^ 2) * sR ^ 3 / (48 * l ^ 3) := by
    have : 0 < 6 - R * l ^ 2 := by linarith
    positivity
  have hbr : 2 * l * sR + t * C ≤ 0 := by
    by_contra h; push_neg at h; have := mul_pos hpre h; linarith
  have := window_strict sR l t C hsR0 hl ht0 ht2 hCs hbr
  rw [hsR2] at this; linarith

/-- C2 枠の各点で:Ricci 固有値が相異なり (I) が成り立つなら 0 < Rℓ² < 2(κ < 0 は仮定しない) -/
theorem c2_window {Rg : Type*} [CommRing Rg] [Algebra ℚ Rg] {F : CFT.Cartan.Frame Rg} {lam : Fin 3 → Rg}
    (H : CFT.Cartan.C2 F lam) (ev : Rg →+* ℝ) (l : ℝ) (hl : 0 < l)
    (h01 : ev (lam 0) ≠ ev (lam 1)) (h12 : ev (lam 1) ≠ ev (lam 2)) (h02 : ev (lam 0) ≠ ev (lam 2))
    (hI : ev (lam 0) ^ 2 + ev (lam 1) ^ 2 + ev (lam 2) ^ 2
      = (ev (lam 0) + ev (lam 1) + ev (lam 2)) ^ 2 / 4 + (ev (lam 0) + ev (lam 1) + ev (lam 2)) / (2 * l ^ 2)) :
    0 < (ev (lam 0) + ev (lam 1) + ev (lam 2)) * l ^ 2 ∧ (ev (lam 0) + ev (lam 1) + ev (lam 2)) * l ^ 2 < 2 := by
  have hk := H.kappa_nonpos ev
  simp only at hk
  exact strict_window _ _ _ l hl h01 h12 h02 hI (by linarith)

/-! ### B. α-III.6 の非自明な平坦極限 -/

/-- r_a(s) = a sin(s/a) → s(a → ∞) -/
theorem flat_r (s : ℝ) : Tendsto (fun a : ℝ => a * sin (s / a)) atTop (𝓝 s) := by
  by_cases hs : s = 0
  · subst hs; simp
  have hslope := (hasDerivAt_sin 0).tendsto_slope_zero
  simp only [zero_add, sin_zero, sub_zero, cos_zero, smul_eq_mul] at hslope
  have hu : Tendsto (fun a : ℝ => s / a) atTop (𝓝[≠] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using tendsto_const_nhds.div_atTop tendsto_id
    · filter_upwards [eventually_gt_atTop 0] with a ha
      exact div_ne_zero hs ha.ne'
  have := (hslope.comp hu).const_mul s
  rw [mul_one] at this
  refine this.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with a ha
  simp only [Function.comp]
  field_simp

/-- r_a′ = cos(s/a) → 1 -/
theorem flat_rp (s : ℝ) : Tendsto (fun a : ℝ => cos (s / a)) atTop (𝓝 1) := by
  have h : Tendsto (fun a : ℝ => s / a) atTop (𝓝 0) := tendsto_const_nhds.div_atTop tendsto_id
  simpa using (continuous_cos.tendsto 0).comp h

/-- G(a) = 3/(8πρ₀a²) → 0 -/
theorem flat_G (ρ0 : ℝ) : Tendsto (fun a : ℝ => 3 / (8 * π * ρ0 * a ^ 2)) atTop (𝓝 0) := by
  by_cases hρ : ρ0 = 0
  · subst hρ; simp
  have h : Tendsto (fun a : ℝ => (3 / (8 * π * ρ0)) * (a ^ 2)⁻¹) atTop (𝓝 ((3 / (8 * π * ρ0)) * 0)) :=
    tendsto_const_nhds.mul (tendsto_inv_atTop_zero.comp (tendsto_pow_atTop (by norm_num : (2:ℕ) ≠ 0)))
  rw [mul_zero] at h
  refine h.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with a ha
  field_simp

/-- 曲率と源の関係 6/a² = 16πG(a)ρ₀ と、有限の a での厳密な質量 m_a = M₂/(2G(a)) = (4π/3)ρ₀ r_a³ -/
theorem cap_mass_exact (ρ0 a s : ℝ) (hρ : ρ0 ≠ 0) (ha : a ≠ 0) :
    6 / a ^ 2 = 16 * π * (3 / (8 * π * ρ0 * a ^ 2)) * ρ0 ∧
    (a * sin (s / a) * (1 - cos (s / a) ^ 2)) / (2 * (3 / (8 * π * ρ0 * a ^ 2)))
      = 4 * π / 3 * ρ0 * (a * sin (s / a)) ^ 3 := by
  have hπ : π ≠ 0 := pi_ne_zero
  constructor
  · field_simp; ring
  · rw [show 1 - cos (s / a) ^ 2 = sin (s / a) ^ 2 by rw [← sin_sq_add_cos_sq (s / a)]; ring]
    field_simp; ring

/-- m_a(s) → (4π/3)ρ₀ s³ -/
theorem flat_mass (ρ0 s : ℝ) :
    Tendsto (fun a : ℝ => 4 * π / 3 * ρ0 * (a * sin (s / a)) ^ 3) atTop (𝓝 (4 * π / 3 * ρ0 * s ^ 3)) :=
  tendsto_const_nhds.mul ((flat_r s).pow 3)

/-- dm_a/ds = 4πρ₀ r_a² r_a′(有限の a で厳密) -/
theorem cap_mass_rate (ρ0 a s : ℝ) (ha : a ≠ 0) :
    HasDerivAt (fun s => 4 * π / 3 * ρ0 * (a * sin (s / a)) ^ 3)
      (4 * π * ρ0 * (a * sin (s / a)) ^ 2 * cos (s / a)) s := by
  have h1 : HasDerivAt (fun s => a * sin (s / a)) (cos (s / a)) s := by
    have := ((hasDerivAt_id s).div_const a).sin.const_mul a
    convert this using 1; simp only [id]; field_simp
  have := (h1.pow 3).const_mul (4 * π / 3 * ρ0)
  convert this using 1; push_cast; ring

/-- dm_a/ds → 4πρ₀ s² -/
theorem flat_mass_rate_limit (ρ0 s : ℝ) :
    Tendsto (fun a : ℝ => 4 * π * ρ0 * (a * sin (s / a)) ^ 2 * cos (s / a)) atTop (𝓝 (4 * π * ρ0 * s ^ 2)) := by
  have := (tendsto_const_nhds (x := 4 * π * ρ0)).mul ((flat_r s).pow 2) |>.mul (flat_rp s)
  simpa using this

end CFT.S3

/-
  α-III.7 の合成(2026-10-21 の評価基準 3-G:質量の下限を定義の書き換えでなく条件から導く)

  旧 min_mass は数の恒等式 ℓ*/(2G) = √π M_Pl/g だけだった。ここでは
  * min_mass_from_constraints:ハミルトン拘束・運動量拘束(場の方程式)、未捕捉(|rK_T| ≤ r′)、
    優勢エネルギー条件(|J| ≤ ρ)、出発点が周縁的捕捉面(首の喉)で r(s₀)=ℓ、首の EYM
    ハミルトン拘束を仮定する。ell_neck から ℓ²=4πG/g²、従って r₀²=4πG/g² を導き、
    外側のすべての点で物理質量 m=M₂/(2G) ≥ √π M_Pl/g を示す(penrose_from_constraints と min_mass を合成)。
-/
import CFT.AlphaIII_Shape
import CFT.AlphaII_EYM

open Real Set

namespace CFT.S3M

theorem min_mass_from_constraints (r rp rpp a KT KTp ρ J M : ℝ → ℝ) (s0 s1 G g l : ℝ)
    (hG : 0 < G) (hg : 0 < g) (hlpos : 0 < l)
    (hneckR : r s0 = l)
    (hneckEYM : 16 * π * G * (1 / (2 * g ^ 2 * l ^ 4)) = 2 / l ^ 2)
    (hM : ∀ s, M s = r s * (1 - rp s ^ 2 + r s ^ 2 * KT s ^ 2))
    (hr0 : ∀ s ∈ Icc s0 s1, r s ≠ 0)
    (d1 : ∀ s ∈ Icc s0 s1, HasDerivAt r (rp s) s)
    (d2 : ∀ s ∈ Icc s0 s1, HasDerivAt rp (rpp s) s)
    (d3 : ∀ s ∈ Icc s0 s1, HasDerivAt KT (KTp s) s)
    (hH : ∀ s ∈ Icc s0 s1, 2 * (1 - rp s ^ 2 - 2 * r s * rpp s) / r s ^ 2
      + 4 * a s * KT s + 2 * KT s ^ 2 = 2 * ρ s)
    (hMom : ∀ s ∈ Icc s0 s1, 2 * (rp s / r s) * (a s - KT s) - 2 * KTp s = J s)
    (hunt : ∀ s ∈ Icc s0 s1, |r s * KT s| ≤ rp s)
    (hdec : ∀ s ∈ Icc s0 s1, |J s| ≤ ρ s)
    (hmarg : rp s0 ^ 2 = r s0 ^ 2 * KT s0 ^ 2) :
    ∀ s ∈ Icc s0 s1, √π * (1 / √G) / g ≤ M s / (2 * G) := by
  have hEll : l ^ 2 = 4 * π * G / g ^ 2 :=
    (CFT.EYM.ell_neck G g l (ne_of_gt hg) (ne_of_gt hlpos) (ne_of_gt hG)).1 hneckEYM
  have hneck : r s0 ^ 2 = 4 * π * G / g ^ 2 := by
    rw [hneckR, hEll]
  have hpos : 0 < r s0 := by rw [hneckR]; exact hlpos
  intro s hs
  have hp := CFT.Shape.penrose_from_constraints r rp rpp a KT KTp ρ J M s0 s1 hM hr0 d1 d2 d3 hH hMom hunt hdec
    hmarg s hs
  have hr : r s0 = √(4 * π * G / g ^ 2) := by
    rw [← hneck, Real.sqrt_sq hpos.le]
  rw [← CFT.AlphaIII.min_mass G g hG hg, ← hr]
  exact div_le_div_of_nonneg_right hp (by positivity)

end CFT.S3M

/-
  段階 4 の幾何の入力:球対称な計量の Einstein テンソルを Levi-Civita の公式から計算する

  関数は微分体 S の元、∂_0..∂_3 は可換な導分(滑らかな関数の芽の代数的な抽象、AlphaIV_Propagation と同じ)。
  Christoffel 記号 Γ^a_bc = ½ g^{ae}(∂_b g_ec + ∂_c g_eb − ∂_e g_bc)、
  Ricci R_bc = ∂_a Γ^a_bc − ∂_c Γ^a_ba + Γ^a_ae Γ^e_bc − Γ^a_ce Γ^e_ba、スカラー R = g^{bc} R_bc、
  Einstein G_bc = R_bc − ½ g_bc R。角度は s = sin θ、c = cos θ(∂_θ s = c、∂_θ c = −s)。
  * 対角の計量 −N²dt² + A²dx² + R²dΩ²(座標 t, x, θ, φ):gamD(Γ の表)、einD_00、einD_11、einD_22、einD_01
  * 二重ヌルの計量 −2Ω du dv + r²dΩ²(座標 u, v, θ, φ):gamN、einN_00(G_uu)、einN_11(G_vv)、
    einN_01(G_uv)、einN_22(G_θθ)
  これで、これまで外部(教科書の公式)に置いていた G_uu = −(2/r)(r_uu − (Ω_u/Ω) r_u)(Ω = e^{2σ} で
  r_uu − 2σ_u r_u)と、空間的な切り口の ³R の公式(時間対称で G_tt/N² = ½ ³R)が、Levi-Civita の公式から出る。
-/
import CFT.AlphaIV_Propagation
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

namespace CFT.S4

open CFT.Propagation (deriv_inv deriv_ofNat)

variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- Christoffel 記号 Γ^a_bc -/
def Gam (g gi : Fin 4 → Fin 4 → S) (a b c : Fin 4) : S :=
  2⁻¹ * ∑ e, gi a e * (d b (g e c) + d c (g e b) - d e (g b c))

/-- Ricci テンソル R_bc(Γ を与えて) -/
def Ric (Γ : Fin 4 → Fin 4 → Fin 4 → S) (b c : Fin 4) : S :=
  ∑ a, (d a (Γ a b c) - d c (Γ a b a)) + ∑ a, ∑ e, (Γ a a e * Γ e b c - Γ a c e * Γ e b a)

/-- スカラー曲率 -/
def Rsc (gi : Fin 4 → Fin 4 → S) (Γ : Fin 4 → Fin 4 → Fin 4 → S) : S :=
  ∑ b, ∑ c, gi b c * Ric d Γ b c

/-- Einstein テンソル G_bc -/
def Ein (g gi : Fin 4 → Fin 4 → S) (Γ : Fin 4 → Fin 4 → Fin 4 → S) (b c : Fin 4) : S :=
  Ric d Γ b c - 2⁻¹ * g b c * Rsc d gi Γ

/-! ### 対角の計量 −N²dt² + A²dx² + R²(dθ² + s²dφ²) -/

section Diag
variable (N A R s c : S)

def gD : Fin 4 → Fin 4 → S := ![![-N^2, 0, 0, 0], ![0, A^2, 0, 0], ![0, 0, R^2, 0], ![0, 0, 0, R^2*s^2]]
def giD : Fin 4 → Fin 4 → S :=
  ![![-(N⁻¹^2), 0, 0, 0], ![0, A⁻¹^2, 0, 0], ![0, 0, R⁻¹^2, 0], ![0, 0, 0, R⁻¹^2 * s⁻¹^2]]

/-- Γ の表(gamD で Gam と一致することを示す) -/
def GD : Fin 4 → Fin 4 → Fin 4 → S :=
  ![![![d 0 N * N⁻¹, d 1 N * N⁻¹, 0, 0], ![d 1 N * N⁻¹, d 0 A * A * N⁻¹^2, 0, 0],
      ![0, 0, d 0 R * R * N⁻¹^2, 0], ![0, 0, 0, d 0 R * R * s^2 * N⁻¹^2]],
    ![![d 1 N * N * A⁻¹^2, d 0 A * A⁻¹, 0, 0], ![d 0 A * A⁻¹, d 1 A * A⁻¹, 0, 0],
      ![0, 0, -(d 1 R * R * A⁻¹^2), 0], ![0, 0, 0, -(d 1 R * R * s^2 * A⁻¹^2)]],
    ![![0, 0, d 0 R * R⁻¹, 0], ![0, 0, d 1 R * R⁻¹, 0], ![d 0 R * R⁻¹, d 1 R * R⁻¹, 0, 0],
      ![0, 0, 0, -(s * c)]],
    ![![0, 0, 0, d 0 R * R⁻¹], ![0, 0, 0, d 1 R * R⁻¹], ![0, 0, 0, c * s⁻¹],
      ![d 0 R * R⁻¹, d 1 R * R⁻¹, c * s⁻¹, 0]]]

/-- 球対称の座標の仮定 -/
structure SphD : Prop where
  hN : N ≠ 0
  hA : A ≠ 0
  hR : R ≠ 0
  hs : s ≠ 0
  N2 : d 2 N = 0
  N3 : d 3 N = 0
  A2 : d 2 A = 0
  A3 : d 3 A = 0
  R2 : d 2 R = 0
  R3 : d 3 R = 0
  s0 : d 0 s = 0
  s1 : d 1 s = 0
  s2 : d 2 s = c
  s3 : d 3 s = 0
  c0 : d 0 c = 0
  c1 : d 1 c = 0
  c2 : d 2 c = -s
  c3 : d 3 c = 0
  comm : ∀ i j f, d i (d j f) = d j (d i f)

theorem giD_inv (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    ∀ i k, ∑ j, gD N A R s i j * giD N A R s j k = if i = k then 1 else 0 := by
  intro i k
  fin_cases i <;> fin_cases k <;> simp [gD, giD, Fin.sum_univ_four] <;> field_simp <;> ring

set_option maxHeartbeats 0 in
theorem gamD (H : SphD d N A R s c) : Gam d (gD N A R s) (giD N A R s) = GD d N A R s c := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, -⟩ := H
  funext a b e
  fin_cases a <;> fin_cases b <;> fin_cases e <;>
    simp [Gam, gD, giD, GD, Fin.sum_univ_four, Derivation.leibniz, Derivation.leibniz_pow,
      smul_eq_mul, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3] <;> field_simp <;> ring

set_option maxHeartbeats 0 in
theorem ricD_00 (H : SphD d N A R s c) : Ric d (GD d N A R s c) 0 0 =
    (1 : S) * (d 0 A) * (d 0 N) * A⁻¹ * N⁻¹ + (-1 : S) * (d 0 (d 0 A)) * A⁻¹ + (-1 : S) * (d 1 A) * N * (d 1 N) * A⁻¹ ^ 3 + (2 : S) * N * (d 1 N) * (d 1 R) * A⁻¹ ^ 2 * R⁻¹ + (1 : S) * N * (d 1 (d 1 N)) * A⁻¹ ^ 2 + (2 : S) * (d 0 N) * (d 0 R) * N⁻¹ * R⁻¹ + (-2 : S) * (d 0 (d 0 R)) * R⁻¹ := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [Ric, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((-1 : S) * (d 1 N) ^ 2 * iA ^ 2) * hiN

set_option maxHeartbeats 0 in
theorem ricD_11 (H : SphD d N A R s c) : Ric d (GD d N A R s c) 1 1 =
    (-1 : S) * A * (d 0 A) * (d 0 N) * N⁻¹ ^ 3 + (2 : S) * A * (d 0 A) * (d 0 R) * N⁻¹ ^ 2 * R⁻¹ + (1 : S) * A * (d 0 (d 0 A)) * N⁻¹ ^ 2 + (1 : S) * (d 1 A) * (d 1 N) * A⁻¹ * N⁻¹ + (2 : S) * (d 1 A) * (d 1 R) * A⁻¹ * R⁻¹ + (-1 : S) * (d 1 (d 1 N)) * N⁻¹ + (-2 : S) * (d 1 (d 1 R)) * R⁻¹ := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [Ric, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((-1 : S) * (d 0 A) ^ 2 * iN ^ 2) * hiA

set_option maxHeartbeats 0 in
theorem ricD_22 (H : SphD d N A R s c) : Ric d (GD d N A R s c) 2 2 =
    (1 : S) * (d 0 A) * R * (d 0 R) * A⁻¹ * N⁻¹ ^ 2 + (1 : S) * (d 1 A) * R * (d 1 R) * A⁻¹ ^ 3 + (-1 : S) * (d 0 N) * R * (d 0 R) * N⁻¹ ^ 3 + (-1 : S) * (d 1 N) * R * (d 1 R) * A⁻¹ ^ 2 * N⁻¹ + (1 : S) * R * (d 0 (d 0 R)) * N⁻¹ ^ 2 + (-1 : S) * R * (d 1 (d 1 R)) * A⁻¹ ^ 2 + (1 : S) * (d 0 R) ^ 2 * N⁻¹ ^ 2 + (-1 : S) * (d 1 R) ^ 2 * A⁻¹ ^ 2 + (1 : S) := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [Ric, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((1 : S)) * his

