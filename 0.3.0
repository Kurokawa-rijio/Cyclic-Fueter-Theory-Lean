end CFT.S4

/-
  段階 4 の作り直し(外部の文章に頼らず Lean で):分布としての方程式と、両側の値の受け渡しを明示する

  段階 4(AlphaS4_Junction)で仮定に置いていた三つを、定理にする。
  1. δ の係数:旧 tube_israel は「δ の係数 = κ(x₀)[g]」を仮定 htt、hang に置いていた。ここでは
     係数 κ が連続で各側で C¹ のとき、分布としての κ ∂g(⟨κ∂g, φ⟩ := −⟨g, ∂(κφ)⟩)の δ の係数が
     κ(x₀)[g] であることを部分積分から証明する(delta_coeff_weighted)。これで
       * slice_shell(α-III.9):ハミルトン拘束 G_nn = −(2/R)R_xx + … = 8πGρ から σ = −[R_x]/(4πG R₀)
       * tube_tt_shell、tube_ang_shell(α-III.1):8πG S_tt = −(2N²/(A²R))[R_x]、8πG S_ang = (R²/(A²N))[N_x]
       * null_uu_shell(α-III.2):G_uu = −(2/r)r_uu + … から 8πG μ = −(2/r₀)[r_u]
     係数の形は AlphaS4_Junction の tube_tt_form、tube_ang_form、slice_hamiltonian、uu_form(計量から計算)。
  2. YM の表面流:旧 color_current は「表面流 = N s [w]」を仮定 hj に置いていた。ymD_split で YM 方程式を
     ∂_x(N s W_x/A) + ∂_t(…) + (微分なし) の形に書き(F = dA + A∧A から計算)、delta_coeff から
     表面流 = [N s W_x/A](tube_color_current)。ヌルな面では流束 −sW_v(ym_flux_null)の跳びで、
     接線微分なので 0(null_color_current、trace_deriv_eq)
  3. 両側の値:微分体 S± の恒等式(gauss_tube、tnn_tube)を、接合点での評価 ev± : S± →+* ℝ に渡す
     (nn_eq_eval)。timelike_two_sided:両側で nn 方程式が成り立ち、内部の量と K が連続、W_t = 0 なら
     [w²] = 0。timelike_dumbbell:帽子 w = −1/ℓ、首 w = 0 では殻なしの時間的な接合は起こらない
     (Israel の δ の係数から K の連続性を出すところまで合成)
  さらに trace_deriv_eq:面の上で両側のトレースが一致すれば接線微分も一致する(ヌルな面の [r_v] = [Ω_v] = [W_v] = 0)。
-/
import CFT.AlphaS5_Evolution

namespace CFT.S4D

open CFT.S4 CFT.S5
open CFT.Propagation (deriv_inv deriv_ofNat)

section YMD
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

set_option maxHeartbeats 0 in
/-- 対角の計量での YM 方程式の (1, θ) 成分 -/
theorem ymD_02 (W N A R s c : S) (H : SphD d N A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    YMeq d (giD N A R s) (N * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2 = (-1 : S) * A * N * W ^ 3 * R⁻¹ ^ 2 * s + (1 : S) * A * N * W * R⁻¹ ^ 2 * s + (1 : S) * A * (d 0 N) * (d 0 W) * N⁻¹ ^ 2 * s + (-1 : S) * A * (d 0 (d 0 W)) * N⁻¹ * s + (-1 : S) * (d 0 A) * (d 0 W) * N⁻¹ * s + (-1 : S) * (d 1 A) * N * (d 1 W) * A⁻¹ ^ 2 * s + (1 : S) * N * (d 1 (d 1 W)) * A⁻¹ * s + (1 : S) * (d 1 N) * (d 1 W) * A⁻¹ * s := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zW20, zW30⟩ := z W W2 W3 0
  obtain ⟨zW21, zW31⟩ := z W W2 W3 1
  have kW := comm 1 0 W
  simp only [eps3_table, YMeq, Fup, giD, FT, Aym, Fin.sum_univ_three, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons,
    map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3, W2, W3, s0, s1, s2, s3, c0, c1, c2, c3, zW20, zW30, zW21, zW31, kW,
    mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, mul_one, one_mul, neg_mul, mul_neg]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((2 : S) * A * (d 0 N) * R ^ 2 * (d 0 W) * iN ^ 2 * iR ^ 2 * s + (2 : S) * A * R ^ 2 * (d 0 R) * (d 0 W) * iN * iR ^ 3 * s + (-1 : S) * A * R ^ 2 * (d 0 (d 0 W)) * iN * iR ^ 2 * s + (-2 : S) * A * R * (d 0 R) * (d 0 W) * iN * iR ^ 2 * s + (-1 : S) * (d 0 A) * R ^ 2 * (d 0 W) * iN * iR ^ 2 * s) * hiN + ((-2 : S) * (d 1 A) * N * R ^ 2 * (d 1 W) * iA ^ 2 * iR ^ 2 * s + (-2 : S) * N * R ^ 2 * (d 1 R) * (d 1 W) * iA * iR ^ 3 * s + (1 : S) * N * R ^ 2 * (d 1 (d 1 W)) * iA * iR ^ 2 * s + (2 : S) * N * R * (d 1 R) * (d 1 W) * iA * iR ^ 2 * s + (1 : S) * (d 1 N) * R ^ 2 * (d 1 W) * iA * iR ^ 2 * s) * hiA + ((-1 : S) * A * N * R * W ^ 3 * iR ^ 3 * is ^ 2 * s ^ 3 + (1 : S) * A * N * R * W * iR ^ 3 * is ^ 2 * s ^ 3 + (-1 : S) * A * N * W ^ 3 * iR ^ 2 * is ^ 2 * s ^ 3 + (1 : S) * A * N * W * iR ^ 2 * is ^ 2 * s ^ 3 + (1 : S) * A * (d 0 N) * R * (d 0 W) * iN ^ 2 * iR * s + (1 : S) * A * (d 0 N) * (d 0 W) * iN ^ 2 * s + (2 : S) * A * R * (d 0 R) * (d 0 W) * iN * iR ^ 2 * s + (-1 : S) * A * R * (d 0 (d 0 W)) * iN * iR * s + (-1 : S) * A * (d 0 (d 0 W)) * iN * s + (-1 : S) * (d 0 A) * R * (d 0 W) * iN * iR * s + (-1 : S) * (d 0 A) * (d 0 W) * iN * s + (-1 : S) * (d 1 A) * N * R * (d 1 W) * iA ^ 2 * iR * s + (-1 : S) * (d 1 A) * N * (d 1 W) * iA ^ 2 * s + (-2 : S) * N * R * (d 1 R) * (d 1 W) * iA * iR ^ 2 * s + (1 : S) * N * R * (d 1 (d 1 W)) * iA * iR * s + (1 : S) * N * (d 1 (d 1 W)) * iA * s + (1 : S) * (d 1 N) * R * (d 1 W) * iA * iR * s + (1 : S) * (d 1 N) * (d 1 W) * iA * s) * hiR + ((-1 : S) * A * N * W ^ 3 * iR ^ 2 * is * s ^ 2 + (-1 : S) * A * N * W ^ 3 * iR ^ 2 * s + (1 : S) * A * N * W * iR ^ 2 * is * s ^ 2 + (1 : S) * A * N * W * iR ^ 2 * s) * his

set_option maxHeartbeats 0 in
/-- 流束の形:YM 方程式 = ∂_x(N s W_x/A) + ∂_t(−A s W_t/N) + A N s W(1 − W²)/R²。
  x の 2 階微分は流束 √−g F^{1xθ} = N s W_x/A(ym_flux_tube)の ∂_x にだけ入る -/
theorem ymD_split (W N A R s c : S) (H : SphD d N A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    YMeq d (giD N A R s) (N * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2
      = d 1 (N * s * (d 1 W * A⁻¹)) + d 0 (-(A * s * (d 0 W * N⁻¹)))
        + A * N * s * W * (1 - W ^ 2) * R⁻¹ ^ 2 := by
  rw [ymD_02 d W N A R s c H W2 W3]
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have kW := comm 1 0 W
  simp only [map_add, map_sub, map_neg, map_mul, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one, iN, iA, s0, s1, kW]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination 0

/-- 評価への受け渡し:各側で nn 成分の Einstein 方程式 G_xx = 2ℓ² T̂_xx が成り立てば、接合点の値で
  Gnn(…) = 2ℓ² Tnn(…)(ev は滑らかな関数をその点の値に送る環準同型) -/
theorem nn_eq_eval (W N A R s c l : S) (H : SphD d N A R s c) (ev : S →+* ℝ)
    (hE : Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 1 1
      = 2 * l ^ 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 1 1) :
    CFT.S4J.Gnn (ev N) (ev R) (ev (d 0 N)) (ev (d 0 R)) (ev (d 0 (d 0 R))) (ev (d 1 N) * (ev A)⁻¹)
        (ev (d 1 R) * (ev A)⁻¹)
      = 2 * (ev l) ^ 2 * CFT.S4J.Tnn (ev R) (ev W) (ev (d 0 W) * (ev N)⁻¹) (ev (d 1 W) * (ev A)⁻¹) := by
  have h1 := CFT.S4J.gauss_tube d N A R s c H
  have h2 := CFT.S4J.tnn_tube d W s N A R H.hN H.hA H.hR H.hs
  have h3 : Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 1 1 * A⁻¹ ^ 2
      = 2 * l ^ 2 * (Tym (gD N A R s) (giD N A R s) (FT d W s) 1 1 * A⁻¹ ^ 2) := by rw [hE]; ring
  rw [h1, h2] at h3
  have h4 := congrArg ev h3
  simpa only [CFT.S4J.Gnn, CFT.S4J.Tnn, map_add, map_sub, map_neg, map_mul, map_pow, map_inv₀,
    map_ofNat, map_one, map_div₀] using h4

end YMD

section Distrib
open Real Set intervalIntegral

/-- 重みつきの δ の係数:κ が連続で各側で C¹(導関数 km、kp)、⟨κ∂g, φ⟩ := −⟨g, ∂(κφ)⟩ の弱い形で
  κ∂g = S_正則 + m δ_{x₀} なら m = κ(x₀)[g] -/
theorem delta_coeff_weighted {a x0 b m : ℝ} (hax : a < x0) (hxb : x0 < b)
    {pm pp qm qp Sm Sp κ km kp : ℝ → ℝ}
    (hpm : ∀ x ∈ Icc a x0, HasDerivWithinAt pm (qm x) (Icc a x0) x)
    (hpp : ∀ x ∈ Icc x0 b, HasDerivWithinAt pp (qp x) (Icc x0 b) x)
    (hκm : ∀ x ∈ Icc a x0, HasDerivWithinAt κ (km x) (Icc a x0) x)
    (hκp : ∀ x ∈ Icc x0 b, HasDerivWithinAt κ (kp x) (Icc x0 b) x)
    (cqm : ContinuousOn qm (Icc a x0)) (cqp : ContinuousOn qp (Icc x0 b))
    (ckm : ContinuousOn km (Icc a x0)) (ckp : ContinuousOn kp (Icc x0 b))
    (sideM : ∀ x ∈ Icc a x0, κ x * qm x = Sm x) (sideP : ∀ x ∈ Icc x0 b, κ x * qp x = Sp x)
    (weak : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, pm x * (km x * φ x + κ x * φ' x)) + ∫ x in x0..b, pp x * (kp x * φ x + κ x * φ' x))
        = (∫ x in a..x0, Sm x * φ x) + (∫ x in x0..b, Sp x * φ x) + m * φ x0) :
    m = κ x0 * (pp x0 - pm x0) := by
  set t : ℝ → ℝ := fun u => (u - a) * (b - u) with ht
  set t' : ℝ → ℝ := fun u => (b - u) - (u - a) with ht'
  have dt : ∀ x, HasDerivAt t (t' x) x := by
    intro x
    have h := ((hasDerivAt_id x).sub_const a).mul ((hasDerivAt_id x).const_sub b)
    simp only [id] at h
    convert h using 1; simp only [ht']; ring
  have ct' : Continuous t' := by simp only [ht']; fun_prop
  have ct : Continuous t := by simp only [ht]; fun_prop
  have hw := weak t t' dt ct' (by simp [ht]) (by simp [ht])
  have uL : uIcc a x0 = Icc a x0 := uIcc_of_le hax.le
  have uR : uIcc x0 b = Icc x0 b := uIcc_of_le hxb.le
  have cκL : ContinuousOn κ (Icc a x0) := fun x hx => (hκm x hx).continuousWithinAt
  have cκR : ContinuousOn κ (Icc x0 b) := fun x hx => (hκp x hx).continuousWithinAt
  -- 左側の部分積分(ψ = κ t)
  have eL := integral_mul_deriv_eq_deriv_mul_of_hasDerivWithinAt
    (u := pm) (v := fun x => κ x * t x) (u' := qm) (v' := fun x => km x * t x + κ x * t' x) (a := a) (b := x0)
    (by rw [uL]; exact hpm)
    (by rw [uL]; intro x hx; exact (hκm x hx).mul (dt x).hasDerivWithinAt)
    (by rw [← uL] at cqm; exact cqm.intervalIntegrable)
    (by
      have : ContinuousOn (fun x => km x * t x + κ x * t' x) (Icc a x0) :=
        (ckm.mul ct.continuousOn).add (cκL.mul ct'.continuousOn)
      rw [← uL] at this; exact this.intervalIntegrable)
  have eR := integral_mul_deriv_eq_deriv_mul_of_hasDerivWithinAt
    (u := pp) (v := fun x => κ x * t x) (u' := qp) (v' := fun x => kp x * t x + κ x * t' x) (a := x0) (b := b)
    (by rw [uR]; exact hpp)
    (by rw [uR]; intro x hx; exact (hκp x hx).mul (dt x).hasDerivWithinAt)
    (by rw [← uR] at cqp; exact cqp.intervalIntegrable)
    (by
      have : ContinuousOn (fun x => kp x * t x + κ x * t' x) (Icc x0 b) :=
        (ckp.mul ct.continuousOn).add (cκR.mul ct'.continuousOn)
      rw [← uR] at this; exact this.intervalIntegrable)
  have e1 : ∫ x in a..x0, qm x * (κ x * t x) = ∫ x in a..x0, Sm x * t x := by
    apply integral_congr; intro x hx; rw [uL] at hx; simp only; rw [← sideM x hx]; ring
  have e2 : ∫ x in x0..b, qp x * (κ x * t x) = ∫ x in x0..b, Sp x * t x := by
    apply integral_congr; intro x hx; rw [uR] at hx; simp only; rw [← sideP x hx]; ring
  rw [eL, eR, e1, e2] at hw
  have ta : t a = 0 := by simp [ht]
  have tb : t b = 0 := by simp [ht]
  simp only [ta, tb, mul_zero, zero_mul, sub_zero] at hw
  have hpos : t x0 ≠ 0 := by simp only [ht]; exact mul_ne_zero (by linarith) (by linarith)
  have key : (κ x0 * (pp x0 - pm x0) - m) * t x0 = 0 := by linarith
  have := (mul_eq_zero.mp key).resolve_right hpos
  linarith

/-- α-III.9:時間対称な切り口のハミルトン拘束(slice_hamiltonian、A = 1)G_nn = −(2/R)R_xx + (1 − R_x²)/R² = 8πGρ。
  κ = −2/R で delta_coeff_weighted から 8πG σ = −(2/R₀)[R_x]、σ = −[R_x]/(4πG R₀) -/
theorem slice_shell {G R0 σ jump : ℝ} (hG : G ≠ 0) (hR : R0 ≠ 0)
    (h : 8 * π * G * σ = -2 / R0 * jump) : σ = -jump / (4 * π * G * R0) := by
  have hπ : π ≠ 0 := pi_ne_zero
  field_simp at h ⊢
  linarith

/-- 面の上でトレースが一致すれば接線微分も一致する(ヌルな面の [r_v] = [Ω_v] = [W_v] = 0) -/
theorem trace_deriv_eq {v0 v1 : ℝ} (hv : v0 < v1) {fp fm dp dm : ℝ → ℝ}
    (heq : ∀ v ∈ Icc v0 v1, fp v = fm v)
    (hp : ∀ v ∈ Icc v0 v1, HasDerivWithinAt fp (dp v) (Icc v0 v1) v)
    (hm : ∀ v ∈ Icc v0 v1, HasDerivWithinAt fm (dm v) (Icc v0 v1) v) :
    ∀ v ∈ Icc v0 v1, dp v = dm v := by
  intro v hv'
  have hm' : HasDerivWithinAt fp (dm v) (Icc v0 v1) v :=
    (hm v hv').congr (fun x hx => heq x hx) (heq v hv')
  exact (uniqueDiffOn_Icc hv v hv').eq_deriv _ (hp v hv') hm'

/-- α-III.1 の両側の合成:両側で nn 方程式(nn_eq_eval の値の形)、内部の量(N, R, N_t, R_t, R_tt, W)と
  K(k₁ = N_x/A、k₂ = R_x/A)が連続、時間対称 W_t = 0 なら [w²] = 0 -/
theorem timelike_two_sided (l N R Nt Rt Rtt k1 k2 W wp wm : ℝ) (hl : l ≠ 0) (hR : R ≠ 0)
    (eP : CFT.S4J.Gnn N R Nt Rt Rtt k1 k2 = 2 * l ^ 2 * CFT.S4J.Tnn R W 0 wp)
    (eM : CFT.S4J.Gnn N R Nt Rt Rtt k1 k2 = 2 * l ^ 2 * CFT.S4J.Tnn R W 0 wm) : wp ^ 2 = wm ^ 2 :=
  CFT.S4J.timelike_no_go l N R Nt Rt Rtt k1 k2 W wp wm hl hR eP eM

/-- α-III.1 の全体の合成(ダンベル):重みつきの δ の係数(tube_tt_form、tube_ang_form と
  delta_coeff_weighted)で殻なし(S_tt = S_ang = 0)なら [R_x] = [N_x] = 0、A は連続なので
  K は連続。両側の nn 方程式(nn_eq_eval)と W_t = 0 から [w²] = 0。帽子 w = −1/ℓ、首 w = 0 では
  成り立たないので、殻なしの時間的な接合はない -/
theorem timelike_dumbbell (G l N A R Nt Rt Rtt Nxp Nxm Rxp Rxm W Stt Sang : ℝ)
    (hG : G ≠ 0) (hl : l ≠ 0) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0)
    (htt : 8 * π * G * Stt = -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) * (Rxp - Rxm))
    (hang : 8 * π * G * Sang = R ^ 2 * A⁻¹ ^ 2 * N⁻¹ * (Nxp - Nxm))
    (eP : CFT.S4J.Gnn N R Nt Rt Rtt (Nxp * A⁻¹) (Rxp * A⁻¹) = 2 * l ^ 2 * CFT.S4J.Tnn R W 0 (-1 / l))
    (eM : CFT.S4J.Gnn N R Nt Rt Rtt (Nxm * A⁻¹) (Rxm * A⁻¹) = 2 * l ^ 2 * CFT.S4J.Tnn R W 0 0) :
    ¬ (Stt = 0 ∧ Sang = 0) := by
  intro hS
  obtain ⟨h1, h2⟩ := (CFT.S4J.tube_israel G N A R (Rxp - Rxm) (Nxp - Nxm) Stt Sang hG hN hA hR
    htt.symm hang.symm).mp hS
  have e1 : Nxp = Nxm := by linarith
  have e2 : Rxp = Rxm := by linarith
  rw [e1, e2] at eP
  have := timelike_two_sided l N R Nt Rt Rtt (Nxm * A⁻¹) (Rxm * A⁻¹) W (-1 / l) 0 hl hR eP eM
  exact (CFT.S4J.dumbbell_timelike l hl).1 this.symm

/-- 時間的な管の YM の表面流:ymD_split で流束 g = N s W_x/A の ∂_x だけが x の 2 階微分を持つので、
  弱い形 −∫ g φ′ = ∫ S φ + j φ(x₀) から j = [g](delta_coeff) -/
theorem tube_color_current {a x0 b j : ℝ} (hax : a < x0) (hxb : x0 < b)
    {pm pp qm qp Sm Sp : ℝ → ℝ}
    (hpm : ∀ x ∈ Icc a x0, HasDerivWithinAt pm (qm x) (Icc a x0) x)
    (hpp : ∀ x ∈ Icc x0 b, HasDerivWithinAt pp (qp x) (Icc x0 b) x)
    (hqm : IntervalIntegrable qm MeasureTheory.volume a x0)
    (hqp : IntervalIntegrable qp MeasureTheory.volume x0 b)
    (sideM : ∀ x ∈ Icc a x0, qm x = Sm x) (sideP : ∀ x ∈ Icc x0 b, qp x = Sp x)
    (weak : ∀ φ φ' : ℝ → ℝ,
      (∀ x ∈ Icc a x0, HasDerivWithinAt φ (φ' x) (Icc a x0) x) →
      (∀ x ∈ Icc x0 b, HasDerivWithinAt φ (φ' x) (Icc x0 b) x) →
      Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, pm x * φ' x) + ∫ x in x0..b, pp x * φ' x)
        = (∫ x in a..x0, Sm x * φ x) + (∫ x in x0..b, Sp x * φ x) + j * φ x0)
    (N s wp wm : ℝ) (hfp : pp x0 = N * s * wp) (hfm : pm x0 = N * s * wm) (hN : N ≠ 0) (hs : s ≠ 0) :
    j = N * s * (wp - wm) ∧ (j = 0 ↔ wp = wm) := by
  have hj := CFT.S4J.delta_coeff hax hxb hpm hpp hqm hqp sideM sideP weak
  rw [hfp, hfm] at hj
  refine ⟨by rw [hj]; ring, ?_⟩
  exact CFT.S4J.color_current N s wp wm j hN hs (by rw [hj])

/-- ダンベルの接合球を通る時間的な面には色の表面流が要る(帽子 w = −1/ℓ、首 w = 0) -/
theorem dumbbell_color_needed (N s l : ℝ) (hN : N ≠ 0) (hs : s ≠ 0) (hl : l ≠ 0) :
    N * s * (0 - -1 / l) ≠ 0 := by
  have : (0 : ℝ) - -1 / l = 1 / l := by ring
  rw [this]; exact mul_ne_zero (mul_ne_zero hN hs) (one_div_ne_zero hl)

/-- ヌルな面 u = 一定 を横切る YM の流束は −s W_v(ym_flux_null)。W のトレースが一致すれば
  W_v も一致し(trace_deriv_eq)、表面流は 0 -/
theorem null_color_current {v0 v1 : ℝ} (hv : v0 < v1) {Wp Wm Wvp Wvm : ℝ → ℝ} (s : ℝ)
    (heq : ∀ v ∈ Icc v0 v1, Wp v = Wm v)
    (hp : ∀ v ∈ Icc v0 v1, HasDerivWithinAt Wp (Wvp v) (Icc v0 v1) v)
    (hm : ∀ v ∈ Icc v0 v1, HasDerivWithinAt Wm (Wvm v) (Icc v0 v1) v) :
    ∀ v ∈ Icc v0 v1, -(s * Wvp v) - -(s * Wvm v) = 0 := by
  intro v hv'
  rw [trace_deriv_eq hv heq hp hm v hv']; ring

/-- α-III.2:uu 成分 G_uu = −(2/r)r_uu + (2Ω_u/(Ωr)) r_u(uu_form)。κ = −2/r で delta_coeff_weighted から
  8πG μ = −(2/r₀)[r_u]。殻なし ⇔ [r_u] = 0 -/
theorem null_uu_shell {G r0 μ jump : ℝ} (hG : G ≠ 0) (hr : r0 ≠ 0)
    (h : 8 * π * G * μ = -2 / r0 * jump) : μ = -jump / (4 * π * G * r0) := slice_shell hG hr h

/-- α-III.2 の合成:各 v で δ の係数から 8πG μ(v) = −(2/r(v))[r_u](v)(null_uu_shell)、
  両側の混合成分の式(mixed_eq)、角での [r_u] = 0 から、波面全体で μ = 0 -/
theorem null_front_weak {v0 v1 G : ℝ} (hG : G ≠ 0) {r rv rup rum ruvp ruvm F μ : ℝ → ℝ}
    (hr : ∀ v ∈ Icc v0 v1, HasDerivWithinAt r (rv v) (Icc v0 v1) v)
    (hup : ∀ v ∈ Icc v0 v1, HasDerivWithinAt rup (ruvp v) (Icc v0 v1) v)
    (hum : ∀ v ∈ Icc v0 v1, HasDerivWithinAt rum (ruvm v) (Icc v0 v1) v)
    (sideP : ∀ v ∈ Icc v0 v1, r v * ruvp v + rup v * rv v = F v)
    (sideM : ∀ v ∈ Icc v0 v1, r v * ruvm v + rum v * rv v = F v)
    (h0 : rup v0 = rum v0) (hpos : ∀ v ∈ Icc v0 v1, r v ≠ 0)
    (hδ : ∀ v ∈ Icc v0 v1, 8 * π * G * μ v = -2 / r v * (rup v - rum v)) :
    ∀ v ∈ Icc v0 v1, μ v = 0 :=
  CFT.S4J.null_front_from_mixed hr hup hum sideP sideM h0 hpos
    (fun v hv => null_uu_shell hG (hpos v hv) (hδ v hv))

end Distrib

end CFT.S4D

/-
  段階 4 の最終定理を、補題を実際に呼び出す形で閉じる(2026-10-21 の評価基準 D:依存関係)

  AlphaS4_Distrib の合成定理(timelike_dumbbell、null_front_weak)は δ の係数の関係式を入力にしていた。
  ここでは最終定理が、場の方程式(微分体 S の上の恒等式)と分布としての方程式(弱い形)だけを入力にとり、
  δ の係数を delta_coeff_weighted で、両側の値を nn_eq_eval で、YM の流束を ymD_split で出す。

  橋渡し:RealLine(横断線の実現)。微分体 S の元 f を線の上の実数値関数 x ↦ ev_x(f) に送る環準同型の族で、
  導分 d が x 微分に対応する(HasDerivWithinAt (fun y => ev y f) (ev x (d f)))。
  * shell_coeff:両側の実現と、各側の古典的な方程式 κ·∂g = src(S の上)と、κ の連続性、分布としての方程式から
    δ の係数 m = κ(x₀)[g](delta_coeff_weighted を呼ぶ)
  * tt_side、ang_side:Einstein 方程式(tt、θθ 成分)と tube_tt_form、tube_ang_form から、κ_tt ∂_x(R_x) = src_tt、
    κ_ang ∂_x(N_x) = src_ang(src は 2ℓ²T̂ − (x の 2 階微分を含まない項))
  * ym_side:YM 方程式 = 0 と ymD_split から ∂_x(N s W_x/A) = src_YM
  * timelike_final(α-III.1):帽子と首の両側の EYM 解、接合点での連続性と時間対称、帽子 w = −1/ℓ、首 w = 0、
    tt・角度成分の分布としての Einstein 方程式から、表面応力は 0 になれない(shell_coeff ×2、tube_israel、
    nn_eq_eval ×2、timelike_no_go を呼ぶ)
  * color_final(α-III.1):YM の分布としての方程式から、表面の色の流れは 0 になれない(shell_coeff、ym_side)
  * slice_final(α-III.9):時間対称な切り口のハミルトン拘束の分布としての式から σ = −[R_x]/(4πG R₀)
  * null_final(α-III.2):両側の EYM 解(二重ヌル)、波面に沿う実現、各 v での分布としての uu 方程式、
    角での [r_u] = 0 から、波面全体で面密度 μ = 0(shell_coeff、mixed_eq、trace_deriv_eq、null_front_from_mixed を呼ぶ)
  入力として残るもの:両側の解が面まで C²(実現の微分可能性)、分布としての方程式(弱解の定義そのもの)。
-/
import CFT.AlphaS4_Distrib

open Real Set intervalIntegral

namespace CFT.S4F

open CFT.S4 CFT.S5

/-- 横断線の実現:S の元を線の上の関数に送り、導分 dd を微分に対応させる -/
structure RealLine {S : Type*} [Field S] (dd : Derivation ℤ S S) (ev : ℝ → S →+* ℝ) (I : Set ℝ) : Prop where
  deriv : ∀ f x, x ∈ I → HasDerivWithinAt (fun y => ev y f) (ev x (dd f)) I x

theorem RealLine.cont {S : Type*} [Field S] {dd : Derivation ℤ S S} {ev : ℝ → S →+* ℝ} {I : Set ℝ}
    (L : RealLine dd ev I) (f : S) : ContinuousOn (fun y => ev y f) I :=
  fun x hx => (L.deriv f x hx).continuousWithinAt

/-- 両側の実現と古典的な方程式から、分布としての方程式の δ の係数 m = κ(x₀)[g] -/
theorem shell_coeff {S₁ S₂ : Type*} [Field S₁] [Field S₂] {d₁ : Derivation ℤ S₁ S₁} {d₂ : Derivation ℤ S₂ S₂}
    {ev₁ : ℝ → S₁ →+* ℝ} {ev₂ : ℝ → S₂ →+* ℝ} {a x0 b m : ℝ} (hax : a < x0) (hxb : x0 < b)
    (L₁ : RealLine d₁ ev₁ (Icc a x0)) (L₂ : RealLine d₂ ev₂ (Icc x0 b))
    (κ₁ g₁ src₁ : S₁) (κ₂ g₂ src₂ : S₂) (e₁ : κ₁ * d₁ g₁ = src₁) (e₂ : κ₂ * d₂ g₂ = src₂)
    (hκ : ev₁ x0 κ₁ = ev₂ x0 κ₂)
    (weak : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, ev₁ x g₁ * (ev₁ x (d₁ κ₁) * φ x + ev₁ x κ₁ * φ' x))
        + ∫ x in x0..b, ev₂ x g₂ * (ev₂ x (d₂ κ₂) * φ x + ev₂ x κ₂ * φ' x))
        = (∫ x in a..x0, ev₁ x src₁ * φ x) + (∫ x in x0..b, ev₂ x src₂ * φ x) + m * φ x0) :
    m = ev₁ x0 κ₁ * (ev₂ x0 g₂ - ev₁ x0 g₁) := by
  let κ : ℝ → ℝ := fun x => if x ≤ x0 then ev₁ x κ₁ else ev₂ x κ₂
  have kL : ∀ x ∈ Icc a x0, κ x = ev₁ x κ₁ := fun x hx => if_pos hx.2
  have kR : ∀ x ∈ Icc x0 b, κ x = ev₂ x κ₂ := by
    intro x hx
    by_cases h : x ≤ x0
    · have : x = x0 := le_antisymm h hx.1
      simp only [κ, if_pos h]; rw [this, hκ]
    · simp only [κ, if_neg h]
  have uL : uIcc a x0 = Icc a x0 := uIcc_of_le hax.le
  have uR : uIcc x0 b = Icc x0 b := uIcc_of_le hxb.le
  have hres := CFT.S4D.delta_coeff_weighted hax hxb (pm := fun x => ev₁ x g₁) (pp := fun x => ev₂ x g₂)
    (qm := fun x => ev₁ x (d₁ g₁)) (qp := fun x => ev₂ x (d₂ g₂)) (Sm := fun x => ev₁ x src₁)
    (Sp := fun x => ev₂ x src₂) (κ := κ) (km := fun x => ev₁ x (d₁ κ₁)) (kp := fun x => ev₂ x (d₂ κ₂)) (m := m)
    (fun x hx => L₁.deriv g₁ x hx) (fun x hx => L₂.deriv g₂ x hx)
    (fun x hx => (L₁.deriv κ₁ x hx).congr (fun y hy => kL y hy) (kL x hx))
    (fun x hx => (L₂.deriv κ₂ x hx).congr (fun y hy => kR y hy) (kR x hx))
    (L₁.cont _) (L₂.cont _) (L₁.cont _) (L₂.cont _)
    (fun x hx => by simp only; rw [kL x hx, ← map_mul, e₁])
    (fun x hx => by simp only; rw [kR x hx, ← map_mul, e₂])
    (fun φ φ' hφ hc ha hb => by
      have h := weak φ φ' hφ hc ha hb
      have i1 : ∫ x in a..x0, ev₁ x g₁ * (ev₁ x (d₁ κ₁) * φ x + κ x * φ' x)
          = ∫ x in a..x0, ev₁ x g₁ * (ev₁ x (d₁ κ₁) * φ x + ev₁ x κ₁ * φ' x) := by
        apply integral_congr; intro x hx; rw [uL] at hx; simp only; rw [kL x hx]
      have i2 : ∫ x in x0..b, ev₂ x g₂ * (ev₂ x (d₂ κ₂) * φ x + κ x * φ' x)
          = ∫ x in x0..b, ev₂ x g₂ * (ev₂ x (d₂ κ₂) * φ x + ev₂ x κ₂ * φ' x) := by
        apply integral_congr; intro x hx; rw [uR] at hx; simp only; rw [kR x hx]
      rw [i1, i2]; exact h)
  rw [hres, kL x0 ⟨hax.le, le_refl _⟩]

section Sides
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- tt 成分の x の 2 階微分を含まない部分 -/
def P00 (N A R : S) : S :=
  2 * d 0 A * d 0 R * A⁻¹ * R⁻¹ + 2 * d 1 A * N ^ 2 * d 1 R * A⁻¹ ^ 3 * R⁻¹
    - N ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 2 * R⁻¹ ^ 2 + N ^ 2 * R⁻¹ ^ 2 + (d 0 R) ^ 2 * R⁻¹ ^ 2

/-- 角度の組み合わせの x の 2 階微分を含まない部分 -/
def P22 (N A R : S) : S :=
  -(d 0 (d 0 A)) * R ^ 2 * A⁻¹ * N⁻¹ ^ 2 - R * d 0 (d 0 R) * N⁻¹ ^ 2
    + d 0 A * d 0 N * R ^ 2 * A⁻¹ * N⁻¹ ^ 3 + d 0 N * R * d 0 R * N⁻¹ ^ 3
    - d 1 A * d 1 N * R ^ 2 * A⁻¹ ^ 3 * N⁻¹ + d 1 N * R * d 1 R * A⁻¹ ^ 2 * N⁻¹
    - (d 1 R) ^ 2 * A⁻¹ ^ 2 / 2 + 1 / 2 + (d 0 R) ^ 2 * N⁻¹ ^ 2 / 2

/-- tt 成分の Einstein 方程式 ⇒ κ_tt ∂_x(R_x) = 2ℓ²T̂_tt − P00 -/
theorem tt_side (W N A R s c l : S) (H : SphD d N A R s c)
    (E00 : Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 0 0
      = 2 * l ^ 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 0 0) :
    -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) * d 1 (d 1 R)
      = 2 * l ^ 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 0 0 - P00 d N A R := by
  have h := CFT.S4J.tube_tt_form d N A R s c H
  rw [E00] at h; rw [P00]; linear_combination -h

/-- θθ と tt 成分の Einstein 方程式 ⇒ κ_ang ∂_x(N_x) = 2ℓ²(T̂_θθ + (R²/2N²)T̂_tt) − P22 -/
theorem ang_side (W N A R s c l : S) (H : SphD d N A R s c)
    (E00 : Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 0 0
      = 2 * l ^ 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 0 0)
    (E22 : Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 2 2
      = 2 * l ^ 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 2 2) :
    R ^ 2 * A⁻¹ ^ 2 * N⁻¹ * d 1 (d 1 N)
      = 2 * l ^ 2 * (Tym (gD N A R s) (giD N A R s) (FT d W s) 2 2
          + R ^ 2 * N⁻¹ ^ 2 / 2 * Tym (gD N A R s) (giD N A R s) (FT d W s) 0 0) - P22 d N A R := by
  have h := CFT.S4J.tube_ang_form d N A R s c H
  rw [E00, E22] at h; rw [P22]; linear_combination -h

/-- YM 方程式 = 0 ⇒ ∂_x(N s W_x/A) = −∂_t(−A s W_t/N) − A N s W(1 − W²)/R² -/
theorem ym_side (W N A R s c : S) (H : SphD d N A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0)
    (hY : YMeq d (giD N A R s) (N * A * R ^ 2 * s) (Aym W s c) (FT d W s) 0 2 = 0) :
    1 * d 1 (N * s * (d 1 W * A⁻¹))
      = -(d 0 (-(A * s * (d 0 W * N⁻¹))) + A * N * s * W * (1 - W ^ 2) * R⁻¹ ^ 2) := by
  have h := CFT.S4D.ymD_split d W N A R s c H W2 W3
  rw [hY] at h; linear_combination -h

/-- uu 成分の Einstein 方程式 ⇒ κ_uu ∂_u(r_u) = 2ℓ²T̂_uu − (2Ω_u/(Ωr)) r_u(κ_uu = −2/r) -/
theorem uu_side (Om r s c W l : S) (H : SphN d Om r s c)
    (E : Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 0 0 = 2 * l ^ 2 * Tym (gN Om r s) (giN Om r s) (FT d W s) 0 0) :
    -(2 * r⁻¹) * d 0 (d 0 r)
      = 2 * l ^ 2 * Tym (gN Om r s) (giN Om r s) (FT d W s) 0 0 - 2 * d 0 Om * Om⁻¹ * r⁻¹ * d 0 r := by
  have h := CFT.S4J.uu_form d Om r s c H
  rw [E] at h; linear_combination -h

/-- F = dA + A∧A は表 FT に等しい(fym_eq を球対称の仮定から) -/
theorem fymD (W N A R s c : S) (H : SphD d N A R s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    Fym d (Aym W s c) = FT d W s :=
  fym_eq d W s c W2 W3 H.s0 H.s1 H.s2 H.s3 H.c0 H.c1 H.c2 H.c3

theorem fymN (W Om r s c : S) (H : SphN d Om r s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0) :
    Fym d (Aym W s c) = FT d W s :=
  fym_eq d W s c W2 W3 H.s0 H.s1 H.s2 H.s3 H.c0 H.c1 H.c2 H.c3

end Sides

/-- α-III.1(重力):帽子(左、S₁)と首(右、S₂)の EYM 解。接合点 x₀ で計量の成分と W が連続、
  時間対称(W_t = 0)、帽子 w = W_x/A = −1/ℓ、首 w = 0。tt と角度成分の分布としての Einstein 方程式の
  δ の係数を 8πG S_tt、8πG S_ang とすると、S_tt = S_ang = 0(殻なし)は起こらない -/
theorem timelike_final {S₁ S₂ : Type*} [Field S₁] [CharZero S₁] [Field S₂] [CharZero S₂]
    (d₁ : Fin 4 → Derivation ℤ S₁ S₁) (d₂ : Fin 4 → Derivation ℤ S₂ S₂)
    (N₁ A₁ R₁ s₁ c₁ W₁ l₁ : S₁) (N₂ A₂ R₂ s₂ c₂ W₂ l₂ : S₂)
    (H₁ : SphD d₁ N₁ A₁ R₁ s₁ c₁) (H₂ : SphD d₂ N₂ A₂ R₂ s₂ c₂)
    (W2₁ : d₁ 2 W₁ = 0) (W3₁ : d₁ 3 W₁ = 0) (W2₂ : d₂ 2 W₂ = 0) (W3₂ : d₂ 3 W₂ = 0)
    (E00₁ : Ein d₁ (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (GD d₁ N₁ A₁ R₁ s₁ c₁) 0 0
      = 2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0)
    (E11₁ : Ein d₁ (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (GD d₁ N₁ A₁ R₁ s₁ c₁) 1 1
      = 2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 1 1)
    (E22₁ : Ein d₁ (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (GD d₁ N₁ A₁ R₁ s₁ c₁) 2 2
      = 2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 2 2)
    (E00₂ : Ein d₂ (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (GD d₂ N₂ A₂ R₂ s₂ c₂) 0 0
      = 2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0)
    (E11₂ : Ein d₂ (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (GD d₂ N₂ A₂ R₂ s₂ c₂) 1 1
      = 2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 1 1)
    (E22₂ : Ein d₂ (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (GD d₂ N₂ A₂ R₂ s₂ c₂) 2 2
      = 2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 2 2)
    {ev₁ : ℝ → S₁ →+* ℝ} {ev₂ : ℝ → S₂ →+* ℝ} {a x0 b G l Stt Sang : ℝ} (hax : a < x0) (hxb : x0 < b)
    (L₁ : RealLine (d₁ 1) ev₁ (Icc a x0)) (L₂ : RealLine (d₂ 1) ev₂ (Icc x0 b))
    (hG : G ≠ 0) (hl : l ≠ 0) (hl₁ : ev₁ x0 l₁ = l) (hl₂ : ev₂ x0 l₂ = l)
    (cN : ev₁ x0 N₁ = ev₂ x0 N₂) (cA : ev₁ x0 A₁ = ev₂ x0 A₂) (cR : ev₁ x0 R₁ = ev₂ x0 R₂)
    (cNt : ev₁ x0 (d₁ 0 N₁) = ev₂ x0 (d₂ 0 N₂)) (cRt : ev₁ x0 (d₁ 0 R₁) = ev₂ x0 (d₂ 0 R₂))
    (cRtt : ev₁ x0 (d₁ 0 (d₁ 0 R₁)) = ev₂ x0 (d₂ 0 (d₂ 0 R₂))) (cW : ev₁ x0 W₁ = ev₂ x0 W₂)
    (ts₁ : ev₁ x0 (d₁ 0 W₁) = 0) (ts₂ : ev₂ x0 (d₂ 0 W₂) = 0)
    (cap : ev₁ x0 (d₁ 1 W₁) * (ev₁ x0 A₁)⁻¹ = -1 / l) (neck : ev₂ x0 (d₂ 1 W₂) * (ev₂ x0 A₂)⁻¹ = 0)
    (weak_tt : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, ev₁ x (d₁ 1 R₁) * (ev₁ x (d₁ 1 (-(2 * N₁ ^ 2 * A₁⁻¹ ^ 2 * R₁⁻¹))) * φ x
            + ev₁ x (-(2 * N₁ ^ 2 * A₁⁻¹ ^ 2 * R₁⁻¹)) * φ' x))
        + ∫ x in x0..b, ev₂ x (d₂ 1 R₂) * (ev₂ x (d₂ 1 (-(2 * N₂ ^ 2 * A₂⁻¹ ^ 2 * R₂⁻¹))) * φ x
            + ev₂ x (-(2 * N₂ ^ 2 * A₂⁻¹ ^ 2 * R₂⁻¹)) * φ' x))
        = (∫ x in a..x0, ev₁ x (2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0
              - P00 d₁ N₁ A₁ R₁) * φ x)
          + (∫ x in x0..b, ev₂ x (2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0
              - P00 d₂ N₂ A₂ R₂) * φ x)
          + 8 * π * G * Stt * φ x0)
    (weak_ang : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, ev₁ x (d₁ 1 N₁) * (ev₁ x (d₁ 1 (R₁ ^ 2 * A₁⁻¹ ^ 2 * N₁⁻¹)) * φ x
            + ev₁ x (R₁ ^ 2 * A₁⁻¹ ^ 2 * N₁⁻¹) * φ' x))
        + ∫ x in x0..b, ev₂ x (d₂ 1 N₂) * (ev₂ x (d₂ 1 (R₂ ^ 2 * A₂⁻¹ ^ 2 * N₂⁻¹)) * φ x
            + ev₂ x (R₂ ^ 2 * A₂⁻¹ ^ 2 * N₂⁻¹) * φ' x))
        = (∫ x in a..x0, ev₁ x (2 * l₁ ^ 2 * (Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 2 2
              + R₁ ^ 2 * N₁⁻¹ ^ 2 / 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0)
              - P22 d₁ N₁ A₁ R₁) * φ x)
          + (∫ x in x0..b, ev₂ x (2 * l₂ ^ 2 * (Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 2 2
              + R₂ ^ 2 * N₂⁻¹ ^ 2 / 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0)
              - P22 d₂ N₂ A₂ R₂) * φ x)
          + 8 * π * G * Sang * φ x0) :
    ¬ (Stt = 0 ∧ Sang = 0) := by
  rw [fymD d₁ W₁ N₁ A₁ R₁ s₁ c₁ H₁ W2₁ W3₁] at E00₁ E11₁ E22₁ weak_tt weak_ang
  rw [fymD d₂ W₂ N₂ A₂ R₂ s₂ c₂ H₂ W2₂ W3₂] at E00₂ E11₂ E22₂ weak_tt weak_ang
  -- δ の係数(delta_coeff_weighted を shell_coeff 経由で)
  have htt := shell_coeff hax hxb L₁ L₂ _ _ _ _ _ _ (tt_side d₁ W₁ N₁ A₁ R₁ s₁ c₁ l₁ H₁ E00₁)
    (tt_side d₂ W₂ N₂ A₂ R₂ s₂ c₂ l₂ H₂ E00₂)
    (by simp only [map_neg, map_mul, map_pow, map_inv₀, map_ofNat]; rw [cN, cA, cR]) weak_tt
  have hang := shell_coeff hax hxb L₁ L₂ _ _ _ _ _ _ (ang_side d₁ W₁ N₁ A₁ R₁ s₁ c₁ l₁ H₁ E00₁ E22₁)
    (ang_side d₂ W₂ N₂ A₂ R₂ s₂ c₂ l₂ H₂ E00₂ E22₂)
    (by simp only [map_mul, map_pow, map_inv₀]; rw [cN, cA, cR]) weak_ang
  simp only [map_neg, map_mul, map_pow, map_inv₀, map_ofNat] at htt hang
  have hN : ev₁ x0 N₁ ≠ 0 := (map_ne_zero _).mpr H₁.hN
  have hA : ev₁ x0 A₁ ≠ 0 := (map_ne_zero _).mpr H₁.hA
  have hR : ev₁ x0 R₁ ≠ 0 := (map_ne_zero _).mpr H₁.hR
  intro hS
  obtain ⟨j1, j2⟩ := (CFT.S4J.tube_israel G (ev₁ x0 N₁) (ev₁ x0 A₁) (ev₁ x0 R₁) _ _ Stt Sang hG hN hA hR
    htt.symm hang.symm).mp hS
  -- 両側の nn 方程式の値(nn_eq_eval)
  have g1 := CFT.S4D.nn_eq_eval d₁ W₁ N₁ A₁ R₁ s₁ c₁ l₁ H₁ (ev₁ x0) E11₁
  have g2 := CFT.S4D.nn_eq_eval d₂ W₂ N₂ A₂ R₂ s₂ c₂ l₂ H₂ (ev₂ x0) E11₂
  have eRx : ev₂ x0 (d₂ 1 R₂) = ev₁ x0 (d₁ 1 R₁) := by linarith
  have eNx : ev₂ x0 (d₂ 1 N₂) = ev₁ x0 (d₁ 1 N₁) := by linarith
  rw [ts₁, zero_mul, cap, hl₁] at g1
  rw [ts₂, zero_mul, neck, hl₂] at g2
  simp only [← cN, ← cA, ← cR, ← cNt, ← cRt, ← cRtt, ← cW, eRx, eNx] at g2
  have := CFT.S4J.timelike_no_go l _ _ _ _ _ _ _ _ (-1 / l) 0 hl hR g1 g2
  exact (CFT.S4J.dumbbell_timelike l hl).1 this.symm

/-- α-III.1(ゲージ場):YM 方程式 = 0(各側)と分布としての YM 方程式(流束 N s W_x/A の δ の係数 j)から、
  ダンベルの接合球では表面の色の流れ j は 0 になれない(ymD_split、shell_coeff を呼ぶ) -/
theorem color_final {S₁ S₂ : Type*} [Field S₁] [CharZero S₁] [Field S₂] [CharZero S₂]
    (d₁ : Fin 4 → Derivation ℤ S₁ S₁) (d₂ : Fin 4 → Derivation ℤ S₂ S₂)
    (N₁ A₁ R₁ s₁ c₁ W₁ : S₁) (N₂ A₂ R₂ s₂ c₂ W₂ : S₂)
    (H₁ : SphD d₁ N₁ A₁ R₁ s₁ c₁) (H₂ : SphD d₂ N₂ A₂ R₂ s₂ c₂)
    (W2₁ : d₁ 2 W₁ = 0) (W3₁ : d₁ 3 W₁ = 0) (W2₂ : d₂ 2 W₂ = 0) (W3₂ : d₂ 3 W₂ = 0)
    (Y₁ : YMeq d₁ (giD N₁ A₁ R₁ s₁) (N₁ * A₁ * R₁ ^ 2 * s₁) (Aym W₁ s₁ c₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 2 = 0)
    (Y₂ : YMeq d₂ (giD N₂ A₂ R₂ s₂) (N₂ * A₂ * R₂ ^ 2 * s₂) (Aym W₂ s₂ c₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 2 = 0)
    {ev₁ : ℝ → S₁ →+* ℝ} {ev₂ : ℝ → S₂ →+* ℝ} {a x0 b l j : ℝ} (hax : a < x0) (hxb : x0 < b)
    (L₁ : RealLine (d₁ 1) ev₁ (Icc a x0)) (L₂ : RealLine (d₂ 1) ev₂ (Icc x0 b)) (hl : l ≠ 0)
    (cN : ev₁ x0 N₁ = ev₂ x0 N₂) (cs : ev₁ x0 s₁ = ev₂ x0 s₂)
    (cap : ev₁ x0 (d₁ 1 W₁) * (ev₁ x0 A₁)⁻¹ = -1 / l) (neck : ev₂ x0 (d₂ 1 W₂) * (ev₂ x0 A₂)⁻¹ = 0)
    (weak : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, ev₁ x (N₁ * s₁ * (d₁ 1 W₁ * A₁⁻¹)) * (ev₁ x (d₁ 1 1) * φ x + ev₁ x 1 * φ' x))
        + ∫ x in x0..b, ev₂ x (N₂ * s₂ * (d₂ 1 W₂ * A₂⁻¹)) * (ev₂ x (d₂ 1 1) * φ x + ev₂ x 1 * φ' x))
        = (∫ x in a..x0, ev₁ x (-(d₁ 0 (-(A₁ * s₁ * (d₁ 0 W₁ * N₁⁻¹)))
              + A₁ * N₁ * s₁ * W₁ * (1 - W₁ ^ 2) * R₁⁻¹ ^ 2)) * φ x)
          + (∫ x in x0..b, ev₂ x (-(d₂ 0 (-(A₂ * s₂ * (d₂ 0 W₂ * N₂⁻¹)))
              + A₂ * N₂ * s₂ * W₂ * (1 - W₂ ^ 2) * R₂⁻¹ ^ 2)) * φ x)
          + j * φ x0) :
    j ≠ 0 := by
  rw [fymD d₁ W₁ N₁ A₁ R₁ s₁ c₁ H₁ W2₁ W3₁] at Y₁
  rw [fymD d₂ W₂ N₂ A₂ R₂ s₂ c₂ H₂ W2₂ W3₂] at Y₂
  have hj := shell_coeff hax hxb L₁ L₂ (1 : S₁) _ _ (1 : S₂) _ _
    (ym_side d₁ W₁ N₁ A₁ R₁ s₁ c₁ H₁ W2₁ W3₁ Y₁) (ym_side d₂ W₂ N₂ A₂ R₂ s₂ c₂ H₂ W2₂ W3₂ Y₂)
    (by simp) weak
  simp only [map_one, one_mul, map_mul, map_inv₀] at hj
  rw [show ev₂ x0 N₂ * ev₂ x0 s₂ * (ev₂ x0 (d₂ 1 W₂) * (ev₂ x0 A₂)⁻¹)
      - ev₁ x0 N₁ * ev₁ x0 s₁ * (ev₁ x0 (d₁ 1 W₁) * (ev₁ x0 A₁)⁻¹)
      = ev₁ x0 N₁ * ev₁ x0 s₁ * (0 - -1 / l) by rw [neck, cap, ← cN, ← cs]; ring] at hj
  rw [hj]
  exact CFT.S4D.dumbbell_color_needed _ _ l ((map_ne_zero _).mpr H₁.hN) ((map_ne_zero _).mpr H₁.hs) hl

/-- α-III.9:時間対称な切り口の球面 x₀(A = 1:x は固有の半径)。ハミルトン拘束(tt 成分)の分布としての式の
  δ の係数を 8πG N₀² σ(T_tt = N²ρ、ρ ⊃ σ δ)とすると σ = −[R_x]/(4πG R₀)(tt_side、shell_coeff を呼ぶ) -/
theorem slice_final {S₁ S₂ : Type*} [Field S₁] [CharZero S₁] [Field S₂] [CharZero S₂]
    (d₁ : Fin 4 → Derivation ℤ S₁ S₁) (d₂ : Fin 4 → Derivation ℤ S₂ S₂)
    (N₁ A₁ R₁ s₁ c₁ W₁ l₁ : S₁) (N₂ A₂ R₂ s₂ c₂ W₂ l₂ : S₂)
    (H₁ : SphD d₁ N₁ A₁ R₁ s₁ c₁) (H₂ : SphD d₂ N₂ A₂ R₂ s₂ c₂)
    (W2₁ : d₁ 2 W₁ = 0) (W3₁ : d₁ 3 W₁ = 0) (W2₂ : d₂ 2 W₂ = 0) (W3₂ : d₂ 3 W₂ = 0)
    (E00₁ : Ein d₁ (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (GD d₁ N₁ A₁ R₁ s₁ c₁) 0 0
      = 2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0)
    (E00₂ : Ein d₂ (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (GD d₂ N₂ A₂ R₂ s₂ c₂) 0 0
      = 2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0)
    {ev₁ : ℝ → S₁ →+* ℝ} {ev₂ : ℝ → S₂ →+* ℝ} {a x0 b G σ : ℝ} (hax : a < x0) (hxb : x0 < b)
    (L₁ : RealLine (d₁ 1) ev₁ (Icc a x0)) (L₂ : RealLine (d₂ 1) ev₂ (Icc x0 b)) (hG : G ≠ 0)
    (cN : ev₁ x0 N₁ = ev₂ x0 N₂) (cA : ev₁ x0 A₁ = ev₂ x0 A₂) (cR : ev₁ x0 R₁ = ev₂ x0 R₂)
    (hA1 : ev₁ x0 A₁ = 1)
    (weak : ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..x0, ev₁ x (d₁ 1 R₁) * (ev₁ x (d₁ 1 (-(2 * N₁ ^ 2 * A₁⁻¹ ^ 2 * R₁⁻¹))) * φ x
            + ev₁ x (-(2 * N₁ ^ 2 * A₁⁻¹ ^ 2 * R₁⁻¹)) * φ' x))
        + ∫ x in x0..b, ev₂ x (d₂ 1 R₂) * (ev₂ x (d₂ 1 (-(2 * N₂ ^ 2 * A₂⁻¹ ^ 2 * R₂⁻¹))) * φ x
            + ev₂ x (-(2 * N₂ ^ 2 * A₂⁻¹ ^ 2 * R₂⁻¹)) * φ' x))
        = (∫ x in a..x0, ev₁ x (2 * l₁ ^ 2 * Tym (gD N₁ A₁ R₁ s₁) (giD N₁ A₁ R₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0
              - P00 d₁ N₁ A₁ R₁) * φ x)
          + (∫ x in x0..b, ev₂ x (2 * l₂ ^ 2 * Tym (gD N₂ A₂ R₂ s₂) (giD N₂ A₂ R₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0
              - P00 d₂ N₂ A₂ R₂) * φ x)
          + 8 * π * G * (ev₁ x0 N₁) ^ 2 * σ * φ x0) :
    σ = -(ev₂ x0 (d₂ 1 R₂) - ev₁ x0 (d₁ 1 R₁)) / (4 * π * G * ev₁ x0 R₁) := by
  rw [fymD d₁ W₁ N₁ A₁ R₁ s₁ c₁ H₁ W2₁ W3₁] at E00₁ weak
  rw [fymD d₂ W₂ N₂ A₂ R₂ s₂ c₂ H₂ W2₂ W3₂] at E00₂ weak
  have h := shell_coeff hax hxb L₁ L₂ _ _ _ _ _ _ (tt_side d₁ W₁ N₁ A₁ R₁ s₁ c₁ l₁ H₁ E00₁)
    (tt_side d₂ W₂ N₂ A₂ R₂ s₂ c₂ l₂ H₂ E00₂)
    (by simp only [map_neg, map_mul, map_pow, map_inv₀, map_ofNat]; rw [cN, cA, cR]) weak
  simp only [map_neg, map_mul, map_pow, map_inv₀, map_ofNat, hA1, inv_one, one_pow, mul_one] at h
  have hN : ev₁ x0 N₁ ≠ 0 := (map_ne_zero _).mpr H₁.hN
  have hR : ev₁ x0 R₁ ≠ 0 := (map_ne_zero _).mpr H₁.hR
  have hπ : π ≠ 0 := pi_ne_zero
  field_simp
  have h2 : (ev₁ x0 N₁) ^ 2 * (8 * π * G * σ * ev₁ x0 R₁ + 2 * (ev₂ x0 (d₂ 1 R₂) - ev₁ x0 (d₁ 1 R₁))) = 0 := by
    field_simp at h; linear_combination h
  have := (mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hN)
  linear_combination this / 2

/-- α-III.2:二重ヌルの両側の EYM 解(S₁、S₂)、波面 u = u₀ に沿う実現 fvᵢ、各 v での横断線の実現 euᵢ v、
  波面の上で r, Ω, W, ℓ が連続、角 v₀ で [r_u] = 0。各 v での分布としての uu 方程式の δ の係数を 8πG μ(v) と
  すると、波面全体で μ = 0。さらに YM の表面流 [−s W_v] も 0(uu_form、mixed_eq、shell_coeff、
  trace_deriv_eq、null_front_from_mixed を呼ぶ) -/
theorem null_final {S₁ S₂ : Type*} [Field S₁] [CharZero S₁] [Field S₂] [CharZero S₂]
    (d₁ : Fin 4 → Derivation ℤ S₁ S₁) (d₂ : Fin 4 → Derivation ℤ S₂ S₂)
    (Om₁ r₁ s₁ c₁ W₁ l₁ : S₁) (Om₂ r₂ s₂ c₂ W₂ l₂ : S₂)
    (H₁ : SphN d₁ Om₁ r₁ s₁ c₁) (H₂ : SphN d₂ Om₂ r₂ s₂ c₂)
    (W2₁ : d₁ 2 W₁ = 0) (W3₁ : d₁ 3 W₁ = 0) (W2₂ : d₂ 2 W₂ = 0) (W3₂ : d₂ 3 W₂ = 0)
    (E00₁ : Ein d₁ (gN Om₁ r₁ s₁) (giN Om₁ r₁ s₁) (GN d₁ Om₁ r₁ s₁ c₁) 0 0
      = 2 * l₁ ^ 2 * Tym (gN Om₁ r₁ s₁) (giN Om₁ r₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0)
    (E01₁ : Ein d₁ (gN Om₁ r₁ s₁) (giN Om₁ r₁ s₁) (GN d₁ Om₁ r₁ s₁ c₁) 0 1
      = 2 * l₁ ^ 2 * Tym (gN Om₁ r₁ s₁) (giN Om₁ r₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 1)
    (E00₂ : Ein d₂ (gN Om₂ r₂ s₂) (giN Om₂ r₂ s₂) (GN d₂ Om₂ r₂ s₂ c₂) 0 0
      = 2 * l₂ ^ 2 * Tym (gN Om₂ r₂ s₂) (giN Om₂ r₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0)
    (E01₂ : Ein d₂ (gN Om₂ r₂ s₂) (giN Om₂ r₂ s₂) (GN d₂ Om₂ r₂ s₂ c₂) 0 1
      = 2 * l₂ ^ 2 * Tym (gN Om₂ r₂ s₂) (giN Om₂ r₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 1)
    {v0 v1 a u0 b G : ℝ} (hv : v0 < v1) (hau : a < u0) (hub : u0 < b) (hG : G ≠ 0)
    {fv₁ : ℝ → S₁ →+* ℝ} {fv₂ : ℝ → S₂ →+* ℝ}
    (F₁ : RealLine (d₁ 1) fv₁ (Icc v0 v1)) (F₂ : RealLine (d₂ 1) fv₂ (Icc v0 v1))
    {eu₁ : ℝ → ℝ → S₁ →+* ℝ} {eu₂ : ℝ → ℝ → S₂ →+* ℝ}
    (U₁ : ∀ v, RealLine (d₁ 0) (eu₁ v) (Icc a u0)) (U₂ : ∀ v, RealLine (d₂ 0) (eu₂ v) (Icc u0 b))
    (hpt₁ : ∀ v, eu₁ v u0 = fv₁ v) (hpt₂ : ∀ v, eu₂ v u0 = fv₂ v)
    (cr : ∀ v ∈ Icc v0 v1, fv₁ v r₁ = fv₂ v r₂) (cO : ∀ v ∈ Icc v0 v1, fv₁ v Om₁ = fv₂ v Om₂)
    (cW : ∀ v ∈ Icc v0 v1, fv₁ v W₁ = fv₂ v W₂) (cs : ∀ v ∈ Icc v0 v1, fv₁ v s₁ = fv₂ v s₂)
    (cl : ∀ v ∈ Icc v0 v1, fv₁ v l₁ = fv₂ v l₂)
    (h0 : fv₂ v0 (d₂ 0 r₂) = fv₁ v0 (d₁ 0 r₁)) {μ : ℝ → ℝ}
    (weak : ∀ v ∈ Icc v0 v1, ∀ φ φ' : ℝ → ℝ, (∀ x, HasDerivAt φ (φ' x) x) → Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..u0, eu₁ v x (d₁ 0 r₁) * (eu₁ v x (d₁ 0 (-(2 * r₁⁻¹))) * φ x + eu₁ v x (-(2 * r₁⁻¹)) * φ' x))
        + ∫ x in u0..b, eu₂ v x (d₂ 0 r₂) * (eu₂ v x (d₂ 0 (-(2 * r₂⁻¹))) * φ x + eu₂ v x (-(2 * r₂⁻¹)) * φ' x))
        = (∫ x in a..u0, eu₁ v x (2 * l₁ ^ 2 * Tym (gN Om₁ r₁ s₁) (giN Om₁ r₁ s₁) (Fym d₁ (Aym W₁ s₁ c₁)) 0 0
              - 2 * d₁ 0 Om₁ * Om₁⁻¹ * r₁⁻¹ * d₁ 0 r₁) * φ x)
          + (∫ x in u0..b, eu₂ v x (2 * l₂ ^ 2 * Tym (gN Om₂ r₂ s₂) (giN Om₂ r₂ s₂) (Fym d₂ (Aym W₂ s₂ c₂)) 0 0
              - 2 * d₂ 0 Om₂ * Om₂⁻¹ * r₂⁻¹ * d₂ 0 r₂) * φ x)
          + 8 * π * G * μ v * φ u0) :
    (∀ v ∈ Icc v0 v1, μ v = 0) ∧
    (∀ v ∈ Icc v0 v1,
      -(fv₂ v s₂ * fv₂ v (d₂ 1 W₂)) - (-(fv₁ v s₁ * fv₁ v (d₁ 1 W₁))) = 0) := by
  rw [fymN d₁ W₁ Om₁ r₁ s₁ c₁ H₁ W2₁ W3₁] at E00₁ E01₁ weak
  rw [fymN d₂ W₂ Om₂ r₂ s₂ c₂ H₂ W2₂ W3₂] at E00₂ E01₂ weak
  -- 各側の uu 方程式:κ ∂_u(r_u) = 2ℓ²T̂_uu − (2Ω_u/(Ωr)) r_u
  have hδ : ∀ v ∈ Icc v0 v1, 8 * π * G * μ v
      = -2 / fv₁ v r₁ * (fv₂ v (d₂ 0 r₂) - fv₁ v (d₁ 0 r₁)) := by
    intro v hv'
    have h := shell_coeff hau hub (U₁ v) (U₂ v) _ _ _ _ _ _ (uu_side d₁ Om₁ r₁ s₁ c₁ W₁ l₁ H₁ E00₁)
      (uu_side d₂ Om₂ r₂ s₂ c₂ W₂ l₂ H₂ E00₂)
      (by rw [hpt₁, hpt₂]; simp only [map_neg, map_mul, map_inv₀, map_ofNat]; rw [cr v hv']) (weak v hv')
    rw [hpt₁, hpt₂] at h
    simp only [map_neg, map_mul, map_inv₀, map_ofNat] at h
    rw [h]; ring
  -- 波面に沿う接線微分の連続性
  have crv : ∀ v ∈ Icc v0 v1, fv₂ v (d₂ 1 r₂) = fv₁ v (d₁ 1 r₁) :=
    CFT.S4D.trace_deriv_eq hv (fun v hv' => (cr v hv').symm) (fun v hv' => F₂.deriv r₂ v hv')
      (fun v hv' => F₁.deriv r₁ v hv')
  have cWv : ∀ v ∈ Icc v0 v1, fv₂ v (d₂ 1 W₂) = fv₁ v (d₁ 1 W₁) :=
    CFT.S4D.trace_deriv_eq hv (fun v hv' => (cW v hv').symm) (fun v hv' => F₂.deriv W₂ v hv')
      (fun v hv' => F₁.deriv W₁ v hv')
  refine ⟨?_, fun v hv' => by rw [cs v hv', cWv v hv']; ring⟩
  -- 混合成分の式(mixed_eq)を波面の上へ
  have m₁ := (CFT.S4J.mixed_eq d₁ W₁ Om₁ r₁ s₁ c₁ l₁ H₁).mp E01₁
  have m₂ := (CFT.S4J.mixed_eq d₂ W₂ Om₂ r₂ s₂ c₂ l₂ H₂).mp E01₂
  rw [← H₁.comm 1 0 r₁] at m₁
  rw [← H₂.comm 1 0 r₂] at m₂
  refine CFT.S4D.null_front_weak hG (r := fun v => fv₁ v r₁) (rv := fun v => fv₁ v (d₁ 1 r₁))
    (rup := fun v => fv₂ v (d₂ 0 r₂)) (rum := fun v => fv₁ v (d₁ 0 r₁))
    (ruvp := fun v => fv₂ v (d₂ 1 (d₂ 0 r₂))) (ruvm := fun v => fv₁ v (d₁ 1 (d₁ 0 r₁)))
    (F := fun v => fv₁ v (Om₁ / 2 * (l₁ ^ 2 * (1 - W₁ ^ 2) ^ 2 * r₁⁻¹ ^ 2 - 1)))
    (fun v hv' => F₁.deriv r₁ v hv') (fun v hv' => F₂.deriv _ v hv') (fun v hv' => F₁.deriv _ v hv')
    (fun v hv' => ?_) (fun v hv' => ?_) h0 (fun v _ => (map_ne_zero _).mpr H₁.hr) hδ
  · have e := congrArg (fv₂ v) m₂
    simp only [map_add, map_mul, map_sub, map_pow, map_inv₀, map_div₀, map_ofNat, map_one] at e ⊢
    rw [cr v hv', ← crv v hv', cO v hv', cW v hv', cl v hv']
    exact e
  · have e := congrArg (fv₁ v) m₁
    simp only [map_add, map_mul, map_sub, map_pow, map_inv₀, map_div₀, map_ofNat, map_one] at e ⊢
    exact e

end CFT.S4F

/-
  段階 4:接合(α-III.1、α-III.2、α-III.9)を、Levi-Civita の曲率(AlphaS4_Curv)と
  YM の応力から閉じる(2026-10-21 の外部監査の論証を Lean に移し、足りない段を補う)

  単位:8πG T = (8πG/g²) T̂ = 2ℓ² T̂(ℓ² = 4πG/g²)。Einstein 方程式は G_μν = 2ℓ² T̂_μν。

  A. 曲率と応力から読む量(微分体 S の上、AlphaS4_Curv の公式から)
    * tube_K:時間的な管 x = x₀ の外曲率 K_ab = −A Γ^x_ab:K_tt = −N N_x/A、K_θθ = R R_x/A、非対角 0
    * gauss_tube:G_nn = G_xx/A² は管の内部の量(N, R と t 微分)と K(N_x/A、R_x/A)だけで書ける(Gnn)。
      x の 2 階微分を含まない(Gauss–Codazzi の nn 成分を計量から直接)
    * tube_tt_form、tube_ang_form:x の 2 階微分は G_tt に −(2N²/(A²R)) R_xx、
      G_θθ + (R²/(2N²)) G_tt に (R²/(A²N)) N_xx としてだけ現れる(球対称の Israel 条件の出所)
    * tnn_tube、rho_tube、flux_tube:YM の T_nn、ρ、T_tn(正規直交成分)
    * ym_flux_tube:YM 方程式 ∂_μ(√−g F^{aμν}) の x 方向の流束 √−g F^{1xθ} = N s W_x/A
    * slice_hamiltonian:時間対称(R_t = A_t = 0)な切り口で G_tt/N² = (1 − (DR)² − 2R·DDR)/R² = ½ ³R
      (D = A⁻¹∂_x)。α-III.9 の Gauss の式(AlphaIII_Junction の scalR)が計量から出る
    * uu_form:G_uu = −(2/r)(r_uu − (Ω_u/Ω) r_u)(Ω = e^{2σ} で r_uu − 2σ_u r_u)
    * mixed_eq:uv 成分の Einstein 方程式 ⇔ r r_uv + r_u r_v = (Ω/2)(ℓ²(1 − W²)²/r² − 1)
    * ym_flux_null:√−g F^{1uθ} = −s W_v(ヌルな面 u = 一定 を横切る YM の流束は接線微分 W_v だけ)
    * null_tangential_stress:T̂_vv = 2W_v²/r²、T̂_uv = Ω(1 − W²)²/(2r⁴)、T̂_vθ = T̂_vφ = 0
  B. 分布としての跳び(1 次元の横断線、試験関数で)
    * delta_coeff:∂g の弱い形の δ の係数は [g](null_shell_from_weak の一般形)
  C. α-III.1(Z6):時間的な殻なし接合の不可能性
    * tube_israel:δ の係数から、殻なし(S_tt = 0、S_θθ + (R²/(2N²))S_tt = 0)⇔ [R_x] = [N_x] = 0
    * tube_K_jump:N, A, R が連続なら [K_ab] = 0 ⇔ [N_x] = [R_x] = 0
    * timelike_no_go:殻なし([K] = 0)と両側の nn 方程式から、時間対称な瞬間に [W_x²/A²] = 0
    * boosted_jump:管がどの速さ β で動いても、[T(n,n)] = γ²(1 + β²)[w²]/R²(w = W_x/A)
    * color_current:YM の表面流 = N s [w](delta_coeff と ym_flux_tube)。なしなら [w] = 0
    * cap_slope、dumbbell_timelike:帽子 W = cos(s/ℓ) の赤道で w = −1/ℓ、首で w = 0。
    * dumbbell_no_shellfree_timelike、dumbbell_color_current:合成した不可能性定理。
      したがってダンベルの接合球を通る時間的な面は、重力の殻(S_ab ≠ 0)と YM の表面流の両方を要する。
      時間的な薄殻一般は否定しない(台帳の閉鎖条件どおり)
  D. α-III.2(Z7):ヌルな波面の殻なし
    * jump_mixed、jump_transport:混合成分の式の差 r[r_uv] + r_v[r_u] = 0 から (r q)′ = 0(q = [r_u])、
      q(v₀) = 0、r > 0 なら波面全体で q = 0
    * initial_jump:時間対称(r_t = 0)と C¹ の空間接合([r_s] = 0)から、角での q(v₀) = 0
    * null_front_no_shell、null_front_from_mixed:面密度 μ = −[r_u]/(4πG r)(AlphaIII_Null)は波面全体で 0
    * 角度成分・uv・vv の δ は横断微分 ∂_u が連続な量(r_v、Ω_v)にかかるだけなので 0、
      YM の表面流も W_v の跳び(= 0)だけ(delta_coeff と ym_flux_null)。k^μ[T_μν] = 0 は
      null_tangential_stress から(T_vν は W, W_v, r, Ω だけで決まる)
    * dumbbell_front:ダンベルの接合から出る波面では [W_u] = −α[w] ≠ 0 で、[T̂_uu] ≠ 0。
      角(r_u = 0)では [r_uu] = −(2ℓ²/r)[W_u²]。波面は殻ではなく弱い不連続を運ぶ。
      波面の上の一般の点の [r_uu] は [Ω_u/Ω] r_u の項を含む(監査の注意どおり)
  外部に残るもの:折れ目のある初期データからの EYM の解が各側で波面まで C²(特性線に沿う弱い不連続の
  標準的な理論)であること。
-/
import CFT.AlphaS4_Curv
import CFT.AlphaIII_Null
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv
import Mathlib.Analysis.Calculus.MeanValue

open Real Set

namespace CFT.S4J

open CFT.S4

/-! ### A. 曲率と応力から読む量 -/

section Alg
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- 管 x = x₀(単位法線 n = A dx)の外曲率 K_ab = ∇_a n_b = −A Γ^x_ab -/
theorem tube_K (N A R s c : S) (H : SphD d N A R s c) :
    -(A * Gam d (gD N A R s) (giD N A R s) 1 0 0) = -(N * (d 1 N * A⁻¹)) ∧
    -(A * Gam d (gD N A R s) (giD N A R s) 1 2 2) = R * (d 1 R * A⁻¹) ∧
    -(A * Gam d (gD N A R s) (giD N A R s) 1 3 3) = R * s ^ 2 * (d 1 R * A⁻¹) ∧
    -(A * Gam d (gD N A R s) (giD N A R s) 1 0 2) = 0 ∧
    -(A * Gam d (gD N A R s) (giD N A R s) 1 0 3) = 0 ∧
    -(A * Gam d (gD N A R s) (giD N A R s) 1 2 3) = 0 := by
  have hA := H.hA
  rw [gamD d N A R s c H]
  simp only [GD, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.tail_cons, mul_zero, neg_zero]
  refine ⟨?_, ?_, ?_, trivial, trivial, trivial⟩ <;> field_simp <;> ring

/-- 管の G_nn(内部の量と外曲率だけ) -/
def Gnn {K : Type*} [Field K] (N R Nt Rt Rtt k1 k2 : K) : K :=
  -R⁻¹ ^ 2 - 2 * Rtt * N⁻¹ ^ 2 * R⁻¹ - Rt ^ 2 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + 2 * Nt * Rt * N⁻¹ ^ 3 * R⁻¹
    + k2 ^ 2 * R⁻¹ ^ 2 + 2 * k1 * k2 * N⁻¹ * R⁻¹

/-- Gauss の式(nn 成分):G_xx/A² = Gnn(N, R, N_t, R_t, R_tt, N_x/A, R_x/A) -/
theorem gauss_tube (N A R s c : S) (H : SphD d N A R s c) :
    Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 1 1 * A⁻¹ ^ 2
      = Gnn N R (d 0 N) (d 0 R) (d 0 (d 0 R)) (d 1 N * A⁻¹) (d 1 R * A⁻¹) := by
  have hA := H.hA
  have hN := H.hN
  have hR := H.hR
  rw [einD_11 d N A R s c H]
  simp only [Gnn]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((2 : S) * A * (d 0 N) * (d 0 R) * iA * iN ^ 3 * iR + (-1 : S) * A * (d 0 R) ^ 2 * iA * iN ^ 2 * iR ^ 2 + (-2 : S) * A * (d 0 (d 0 R)) * iA * iN ^ 2 * iR + (-1 : S) * A * iA * iR ^ 2 + (2 : S) * (d 0 N) * (d 0 R) * iN ^ 3 * iR + (-1 : S) * (d 0 R) ^ 2 * iN ^ 2 * iR ^ 2 + (-2 : S) * (d 0 (d 0 R)) * iN ^ 2 * iR + (-1 : S) * iR ^ 2) * hiA

/-- G_tt の x の 2 階微分は R_xx だけ -/
theorem tube_tt_form (N A R s c : S) (H : SphD d N A R s c) :
    Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 0 0
      = -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) * d 1 (d 1 R)
        + (2 * d 0 A * d 0 R * A⁻¹ * R⁻¹ + 2 * d 1 A * N ^ 2 * d 1 R * A⁻¹ ^ 3 * R⁻¹
          - N ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 2 * R⁻¹ ^ 2 + N ^ 2 * R⁻¹ ^ 2 + (d 0 R) ^ 2 * R⁻¹ ^ 2) := by
  rw [einD_00 d N A R s c H]; ring

/-- G_θθ + (R²/(2N²)) G_tt の x の 2 階微分は N_xx だけ -/
theorem tube_ang_form (N A R s c : S) (H : SphD d N A R s c) :
    Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 2 2
      + R ^ 2 * N⁻¹ ^ 2 / 2 * Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 0 0
      = R ^ 2 * A⁻¹ ^ 2 * N⁻¹ * d 1 (d 1 N)
        + (-(d 0 (d 0 A)) * R ^ 2 * A⁻¹ * N⁻¹ ^ 2 - R * d 0 (d 0 R) * N⁻¹ ^ 2
          + d 0 A * d 0 N * R ^ 2 * A⁻¹ * N⁻¹ ^ 3 + d 0 N * R * d 0 R * N⁻¹ ^ 3
          - d 1 A * d 1 N * R ^ 2 * A⁻¹ ^ 3 * N⁻¹ + d 1 N * R * d 1 R * A⁻¹ ^ 2 * N⁻¹
          - (d 1 R) ^ 2 * A⁻¹ ^ 2 / 2 + 1 / 2 + (d 0 R) ^ 2 * N⁻¹ ^ 2 / 2) := by
  have hA := H.hA
  have hN := H.hN
  have hR := H.hR
  rw [einD_22 d N A R s c H, einD_00 d N A R s c H]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((1 : S) * (d 1 A) * N * R ^ 2 * (d 1 R) * iA ^ 3 * iN * iR + (1 : S) * (d 1 A) * R ^ 2 * (d 1 R) * iA ^ 3 * iR + (-1/2 : S) * N * R ^ 2 * (d 1 R) ^ 2 * iA ^ 2 * iN * iR ^ 2 + (-1 : S) * N * R ^ 2 * (d 1 (d 1 R)) * iA ^ 2 * iN * iR + (1/2 : S) * N * R ^ 2 * iN * iR ^ 2 + (-1/2 : S) * R ^ 2 * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 2 + (-1 : S) * R ^ 2 * (d 1 (d 1 R)) * iA ^ 2 * iR + (1/2 : S) * R ^ 2 * iR ^ 2) * hiN + ((1 : S) * (d 0 A) * R * (d 0 R) * iA * iN ^ 2 + (1 : S) * (d 1 A) * R * (d 1 R) * iA ^ 3 + (1/2 : S) * R * (d 0 R) ^ 2 * iN ^ 2 * iR + (-1/2 : S) * R * (d 1 R) ^ 2 * iA ^ 2 * iR + (-1 : S) * R * (d 1 (d 1 R)) * iA ^ 2 + (1/2 : S) * R * iR + (1/2 : S) * (d 0 R) ^ 2 * iN ^ 2 + (-1/2 : S) * (d 1 R) ^ 2 * iA ^ 2 + (1/2 : S)) * hiR

/-- 時間対称な切り口のハミルトン拘束の幾何:G_tt/N² = (1 − (DR)² − 2R·DDR)/R² = ½ ³R(D = A⁻¹∂_x) -/
theorem slice_hamiltonian (N A R s c : S) (H : SphD d N A R s c) (hRt : d 0 R = 0) (hAt : d 0 A = 0) :
    Ein d (gD N A R s) (giD N A R s) (GD d N A R s c) 0 0 * N⁻¹ ^ 2
      = (1 - (d 1 R * A⁻¹) ^ 2 - 2 * R * (d 1 (d 1 R) * A⁻¹ ^ 2 - d 1 A * d 1 R * A⁻¹ ^ 3)) * R⁻¹ ^ 2 := by
  have hA := H.hA
  have hN := H.hN
  have hR := H.hR
  rw [einD_00 d N A R s c H, hRt, hAt]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((2 : S) * (d 1 A) * N * (d 1 R) * iA ^ 3 * iN * iR + (2 : S) * (d 1 A) * (d 1 R) * iA ^ 3 * iR + (-1 : S) * N * (d 1 R) ^ 2 * iA ^ 2 * iN * iR ^ 2 + (-2 : S) * N * (d 1 (d 1 R)) * iA ^ 2 * iN * iR + (1 : S) * N * iN * iR ^ 2 + (-1 : S) * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 2 + (-2 : S) * (d 1 (d 1 R)) * iA ^ 2 * iR + (1 : S) * iR ^ 2) * hiN + ((-2 : S) * (d 1 A) * (d 1 R) * iA ^ 3 * iR + (2 : S) * (d 1 (d 1 R)) * iA ^ 2 * iR) * hiR

/-- 管の法線方向の応力 T̂_nn(正規直交成分) -/
def Tnn {K : Type*} [Field K] (R W wt wx : K) : K :=
  wx ^ 2 * R⁻¹ ^ 2 + wt ^ 2 * R⁻¹ ^ 2 - (1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 / 2

/-- エネルギー密度 ρ̂(正規直交成分) -/
def Rho {K : Type*} [Field K] (R W wt wx : K) : K :=
  wx ^ 2 * R⁻¹ ^ 2 + wt ^ 2 * R⁻¹ ^ 2 + (1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 / 2

theorem tnn_tube (W s N A R : S) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    Tym (gD N A R s) (giD N A R s) (FT d W s) 1 1 * A⁻¹ ^ 2 = Tnn R W (d 0 W * N⁻¹) (d 1 W * A⁻¹) := by
  rw [tymD_11 d W s hN hA hR hs]; simp only [Tnn]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((-1/2 : S) * A * W ^ 4 * iA * iR ^ 4 + (1 : S) * A * W ^ 2 * iA * iR ^ 4 + (1 : S) * A * (d 0 W) ^ 2 * iA * iN ^ 2 * iR ^ 2 + (-1/2 : S) * A * iA * iR ^ 4 + (-1/2 : S) * W ^ 4 * iR ^ 4 + (1 : S) * W ^ 2 * iR ^ 4 + (1 : S) * (d 0 W) ^ 2 * iN ^ 2 * iR ^ 2 + (-1/2 : S) * iR ^ 4) * hiA

theorem rho_tube (W s N A R : S) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    Tym (gD N A R s) (giD N A R s) (FT d W s) 0 0 * N⁻¹ ^ 2 = Rho R W (d 0 W * N⁻¹) (d 1 W * A⁻¹) := by
  rw [tymD_00 d W s hN hA hR hs]; simp only [Rho]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((1/2 : S) * N * W ^ 4 * iN * iR ^ 4 + (-1 : S) * N * W ^ 2 * iN * iR ^ 4 + (1 : S) * N * (d 1 W) ^ 2 * iA ^ 2 * iN * iR ^ 2 + (1/2 : S) * N * iN * iR ^ 4 + (1/2 : S) * W ^ 4 * iR ^ 4 + (-1 : S) * W ^ 2 * iR ^ 4 + (1 : S) * (d 1 W) ^ 2 * iA ^ 2 * iR ^ 2 + (1/2 : S) * iR ^ 4) * hiN

theorem flux_tube (W s N A R : S) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) (hs : s ≠ 0) :
    Tym (gD N A R s) (giD N A R s) (FT d W s) 0 1 * (N⁻¹ * A⁻¹)
      = 2 * (d 0 W * N⁻¹) * (d 1 W * A⁻¹) * R⁻¹ ^ 2 := by
  rw [tymD_01 d W s hN hA hR hs]; ring

/-- YM 方程式の x 方向の流束:√−g g^{xx} g^{θθ} F^1_{xθ} = N s W_x/A(√−g = N A R² s) -/
theorem ym_flux_tube (W s N A R : S) (hA : A ≠ 0) (hR : R ≠ 0) :
    (N * A * R ^ 2 * s) * giD N A R s 1 1 * giD N A R s 2 2 * FT d W s 0 1 2 = N * s * (d 1 W * A⁻¹) := by
  simp only [giD, FT, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.tail_cons]
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  linear_combination ((1 : S) * N * R ^ 2 * (d 1 W) * iA * iR ^ 2 * s) * hiA + ((1 : S) * N * R * (d 1 W) * iA * iR * s + (1 : S) * N * (d 1 W) * iA * s) * hiR

/-- ヌルな面の uu 成分:G_uu = −(2/r)(r_uu − (Ω_u/Ω) r_u) -/
theorem uu_form (Om r s c : S) (H : SphN d Om r s c) :
    Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 0 0
      = -(2 * r⁻¹) * (d 0 (d 0 r) - d 0 Om * Om⁻¹ * d 0 r) := by
  rw [einN_00 d Om r s c H]; ring

/-- uv 成分の Einstein 方程式 ⇔ r r_uv + r_u r_v = (Ω/2)(ℓ²(1 − W²)²/r² − 1) -/
theorem mixed_eq (W Om r s c l : S) (H : SphN d Om r s c) :
    Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 0 1 = 2 * l ^ 2 * Tym (gN Om r s) (giN Om r s) (FT d W s) 0 1
      ↔ r * d 0 (d 1 r) + d 0 r * d 1 r = Om / 2 * (l ^ 2 * (1 - W ^ 2) ^ 2 * r⁻¹ ^ 2 - 1) := by
  have hO := H.hO
  have hr := H.hr
  rw [einN_01 d Om r s c H, tymN_01 d W s hO hr H.hs]
  have hiOm : Om * Om⁻¹ = 1 := mul_inv_cancel₀ hO
  have hir : r * r⁻¹ = 1 := mul_inv_cancel₀ hr
  generalize Om⁻¹ = iOm at hiOm ⊢
  generalize r⁻¹ = ir at hir ⊢
  constructor
  · intro h
    linear_combination (r ^ 2 / 2) * h + ((1/2 : S) * Om * W ^ 4 * ir ^ 3 * l ^ 2 * r + (1/2 : S) * Om * W ^ 4 * ir ^ 2 * l ^ 2 + (-1 : S) * Om * W ^ 2 * ir ^ 3 * l ^ 2 * r + (-1 : S) * Om * W ^ 2 * ir ^ 2 * l ^ 2 + (1/2 : S) * Om * ir ^ 3 * l ^ 2 * r + (1/2 : S) * Om * ir ^ 2 * l ^ 2 + (-1/2 : S) * Om * ir * r + (-1/2 : S) * Om + (-1 : S) * ir * r * (d 0 r) * (d 1 r) + (-1 : S) * r * (d 0 (d 1 r)) + (-1 : S) * (d 0 r) * (d 1 r)) * hir
  · intro h
    linear_combination (2 * ir ^ 2) * h + ((-2 : S) * ir * (d 0 (d 1 r))) * hir

/-- ヌルな面 u = 一定 を横切る YM の流束:√−g g^{uv} g^{θθ} F^1_{vθ} = −s W_v(√−g = Ω r² s) -/
theorem ym_flux_null (W s Om r : S) (hO : Om ≠ 0) (hr : r ≠ 0) :
    (Om * r ^ 2 * s) * giN Om r s 0 1 * giN Om r s 2 2 * FT d W s 0 1 2 = -(s * d 1 W) := by
  simp only [giN, FT, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.tail_cons]
  have hiOm : Om * Om⁻¹ = 1 := mul_inv_cancel₀ hO
  have hir : r * r⁻¹ = 1 := mul_inv_cancel₀ hr
  generalize Om⁻¹ = iOm at hiOm ⊢
  generalize r⁻¹ = ir at hir ⊢
  linear_combination ((-1 : S) * (d 1 W) * ir ^ 2 * r ^ 2 * s) * hiOm + ((-1 : S) * (d 1 W) * ir * r * s + (-1 : S) * (d 1 W) * s) * hir

/-- 生成子 k = ∂_v の方向の応力:T̂_vv、T̂_uv、T̂_vθ、T̂_vφ は W, W_v, r, Ω だけで決まる -/
theorem null_tangential_stress (W s Om r : S) (hO : Om ≠ 0) (hr : r ≠ 0) (hs : s ≠ 0) :
    Tym (gN Om r s) (giN Om r s) (FT d W s) 1 1 = 2 * (d 1 W) ^ 2 * r⁻¹ ^ 2 ∧
    Tym (gN Om r s) (giN Om r s) (FT d W s) 0 1 = Om * (1 - W ^ 2) ^ 2 * r⁻¹ ^ 4 / 2 ∧
    Tym (gN Om r s) (giN Om r s) (FT d W s) 1 2 = 0 ∧
    Tym (gN Om r s) (giN Om r s) (FT d W s) 1 3 = 0 := by
  refine ⟨(tymN_11 d W s hO hr hs).trans (by ring), (tymN_01 d W s hO hr hs).trans (by ring),
    tymN_12 d W s hO hr hs, tymN_13 d W s hO hr hs⟩

end Alg

/-! ### B. 分布としての跳び -/

/-- 横断線の上の弱い形:−∫ g φ′ = ∫ S φ + m φ(u₀) がすべての試験関数で成り立てば、δ の係数 m = [g] -/
theorem delta_coeff {a u₀ b m : ℝ} (hau : a < u₀) (hub : u₀ < b)
    {pm pp qm qp Sm Sp : ℝ → ℝ}
    (hpm : ∀ x ∈ Icc a u₀, HasDerivWithinAt pm (qm x) (Icc a u₀) x)
    (hpp : ∀ x ∈ Icc u₀ b, HasDerivWithinAt pp (qp x) (Icc u₀ b) x)
    (hqm : IntervalIntegrable qm MeasureTheory.volume a u₀)
    (hqp : IntervalIntegrable qp MeasureTheory.volume u₀ b)
    (sideM : ∀ x ∈ Icc a u₀, qm x = Sm x) (sideP : ∀ x ∈ Icc u₀ b, qp x = Sp x)
    (weak : ∀ φ φ' : ℝ → ℝ,
      (∀ x ∈ Icc a u₀, HasDerivWithinAt φ (φ' x) (Icc a u₀) x) →
      (∀ x ∈ Icc u₀ b, HasDerivWithinAt φ (φ' x) (Icc u₀ b) x) →
      Continuous φ' → φ a = 0 → φ b = 0 →
      -((∫ x in a..u₀, pm x * φ' x) + ∫ x in u₀..b, pp x * φ' x)
        = (∫ x in a..u₀, Sm x * φ x) + (∫ x in u₀..b, Sp x * φ x) + m * φ u₀) :
    m = pp u₀ - pm u₀ := by
  set φ : ℝ → ℝ := fun u => (u - a) * (b - u) with hφ
  set φ' : ℝ → ℝ := fun u => (b - u) - (u - a) with hφ'
  have dφm : ∀ x ∈ Icc a u₀, HasDerivWithinAt φ (φ' x) (Icc a u₀) x :=
    fun x _ => CFT.Null.tent_deriv a b x _
  have dφp : ∀ x ∈ Icc u₀ b, HasDerivWithinAt φ (φ' x) (Icc u₀ b) x :=
    fun x _ => CFT.Null.tent_deriv a b x _
  have cφ' : Continuous φ' := by simp only [hφ']; fun_prop
  have hw := weak φ φ' dφm dφp cφ' (by simp [hφ]) (by simp [hφ])
  have hparts := CFT.Junction.weak_second_derivative hau.le hub.le hpm hpp dφm dφp hqm hqp
    (cφ'.intervalIntegrable _ _) (cφ'.intervalIntegrable _ _) (by simp [hφ]) (by simp [hφ])
  have e1 : ∫ x in a..u₀, qm x * φ x = ∫ x in a..u₀, Sm x * φ x := by
    apply intervalIntegral.integral_congr; intro x hx; rw [uIcc_of_le hau.le] at hx; simp only
    rw [sideM x hx]
  have e2 : ∫ x in u₀..b, qp x * φ x = ∫ x in u₀..b, Sp x * φ x := by
    apply intervalIntegral.integral_congr; intro x hx; rw [uIcc_of_le hub.le] at hx; simp only
    rw [sideP x hx]
  rw [hparts, e1, e2] at hw
  have hpos : φ u₀ ≠ 0 := by
    simp only [hφ]; exact mul_ne_zero (by linarith) (by linarith)
  have key : ((pp u₀ - pm u₀) - m) * φ u₀ = 0 := by linarith
  have k2 := (mul_eq_zero.mp key).resolve_right hpos
  linarith

/-! ### C. α-III.1:時間的な殻なし接合の不可能性 -/

/-- 球対称な管の Israel 条件:tt 成分と角度の組み合わせの δ の係数(tube_tt_form、tube_ang_form と
  delta_coeff)が 8πG S なら、殻なし ⇔ [R_x] = [N_x] = 0 -/
theorem tube_israel (G N A R jR jN Stt Sang : ℝ) (hG : G ≠ 0) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0)
    (htt : -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) * jR = 8 * π * G * Stt)
    (hang : R ^ 2 * A⁻¹ ^ 2 * N⁻¹ * jN = 8 * π * G * Sang) :
    (Stt = 0 ∧ Sang = 0) ↔ (jR = 0 ∧ jN = 0) := by
  have hπ : π ≠ 0 := pi_ne_zero
  have c1 : -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) ≠ 0 := by
    have : (2 : ℝ) * N ^ 2 * A⁻¹ ^ 2 * R⁻¹ ≠ 0 := by positivity
    exact neg_ne_zero.mpr this
  have c2 : R ^ 2 * A⁻¹ ^ 2 * N⁻¹ ≠ 0 := by positivity
  have c3 : (8 : ℝ) * π * G ≠ 0 := by positivity
  constructor
  · rintro ⟨h1, h2⟩
    rw [h1, mul_zero] at htt; rw [h2, mul_zero] at hang
    exact ⟨(mul_eq_zero.mp htt).resolve_left c1, (mul_eq_zero.mp hang).resolve_left c2⟩
  · rintro ⟨h1, h2⟩
    rw [h1, mul_zero] at htt; rw [h2, mul_zero] at hang
    exact ⟨(mul_eq_zero.mp htt.symm).resolve_left c3, (mul_eq_zero.mp hang.symm).resolve_left c3⟩

/-- N, A, R が連続なら、外曲率の跳び [K_tt] = −N[N_x]/A、[K_θθ] = R[R_x]/A は
  [N_x] = [R_x] = 0 と同値 -/
theorem tube_K_jump (N A R Nxp Nxm Rxp Rxm : ℝ) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0) :
    (-(N * (Nxp * A⁻¹)) - -(N * (Nxm * A⁻¹)) = 0 ∧ R * (Rxp * A⁻¹) - R * (Rxm * A⁻¹) = 0)
      ↔ (Nxp - Nxm = 0 ∧ Rxp - Rxm = 0) := by
  have e1 : -(N * (Nxp * A⁻¹)) - -(N * (Nxm * A⁻¹)) = -(N * A⁻¹) * (Nxp - Nxm) := by ring
  have e2 : R * (Rxp * A⁻¹) - R * (Rxm * A⁻¹) = R * A⁻¹ * (Rxp - Rxm) := by ring
  have c1 : -(N * A⁻¹) ≠ 0 := neg_ne_zero.mpr (by positivity)
  have c2 : R * A⁻¹ ≠ 0 := by positivity
  rw [e1, e2]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨(mul_eq_zero.mp h1).resolve_left c1, (mul_eq_zero.mp h2).resolve_left c2⟩
  · rintro ⟨h1, h2⟩; rw [h1, h2]; simp

/-- 殻なしの時間的な接合([K] = 0、内部の量は連続)と両側の nn 方程式 G_nn = 2ℓ² T̂_nn から、
  時間対称な瞬間(W_t = 0)に [w²] = 0(w = W_x/A) -/
theorem timelike_no_go (l N R Nt Rt Rtt k1 k2 W wp wm : ℝ) (hl : l ≠ 0) (hR : R ≠ 0)
    (eP : Gnn N R Nt Rt Rtt k1 k2 = 2 * l ^ 2 * Tnn R W 0 wp)
    (eM : Gnn N R Nt Rt Rtt k1 k2 = 2 * l ^ 2 * Tnn R W 0 wm) :
    wp ^ 2 = wm ^ 2 := by
  have h : 2 * l ^ 2 * Tnn R W 0 wp = 2 * l ^ 2 * Tnn R W 0 wm := by rw [← eP, ← eM]
  have hl2 : (2 : ℝ) * l ^ 2 ≠ 0 := by positivity
  have h2 := mul_left_cancel₀ hl2 h
  simp only [Tnn] at h2
  have hR2 : R⁻¹ ^ 2 ≠ 0 := by positivity
  have h3 : (wp ^ 2 - wm ^ 2) * R⁻¹ ^ 2 = 0 := by linear_combination h2
  linarith [(mul_eq_zero.mp h3).resolve_right hR2]

/-- 管が速さ β(|β| < 1、γ² = 1/(1 − β²))で動いていても、W_t = 0 の瞬間の法線応力の跳びは
  [T(n,n)] = γ²(1 + β²)[w²]/R²(n = γ(e_x + β e_t)) -/
theorem boosted_jump (R W wp wm β γ2 : ℝ) :
    γ2 * ((Tnn R W 0 wp - Tnn R W 0 wm) + 2 * β * (2 * 0 * wp * R⁻¹ ^ 2 - 2 * 0 * wm * R⁻¹ ^ 2)
        + β ^ 2 * (Rho R W 0 wp - Rho R W 0 wm))
      = γ2 * (1 + β ^ 2) * (wp ^ 2 - wm ^ 2) * R⁻¹ ^ 2 := by
  simp only [Tnn, Rho]; ring

/-- YM の表面流:流束 √−g F^{1xθ} = N s w の δ の係数(delta_coeff)は N s [w]。なしなら [w] = 0 -/
theorem color_current (N s wp wm j : ℝ) (hN : N ≠ 0) (hs : s ≠ 0) (hj : j = N * s * wp - N * s * wm) :
    j = 0 ↔ wp = wm := by
  rw [hj]
  constructor
  · intro h
    have : N * s * (wp - wm) = 0 := by linear_combination h
    have := (mul_eq_zero.mp this).resolve_left (mul_ne_zero hN hs)
    linarith
  · intro h; rw [h]; ring

/-- 帽子 W = cos(s/ℓ)(W = r′)の赤道 s = πℓ/2 での傾き −1/ℓ -/
theorem cap_slope (l : ℝ) (hl : l ≠ 0) :
    HasDerivAt (fun x => cos (x / l)) (-1 / l) (π * l / 2) := by
  have h := ((hasDerivAt_id (π * l / 2)).div_const l).cos
  simp only [id] at h
  convert h using 1
  rw [show π * l / 2 / l = π / 2 by field_simp; ring, sin_pi_div_two]
  ring

/-- ダンベルの接合球:帽子側 w = −1/ℓ、首側 w = 0(A = 1、W_t = 0)。
  殻なしの時間的な接合は [w²] = 0 を要し(timelike_no_go)、YM の表面流なしは [w] = 0 を要する
  (color_current)。どちらも成り立たない:どの速さで動く時間的な面にも、重力の殻と YM の表面流の
  両方が必要(boosted_jump で [T(n,n)] = γ²(1 + β²)(−1/ℓ²)/ℓ² ≠ 0) -/
theorem dumbbell_timelike (l : ℝ) (hl : l ≠ 0) :
    (0 : ℝ) ^ 2 ≠ (-1 / l) ^ 2 ∧ (0 : ℝ) ≠ -1 / l := by
  have : (-1 / l) ≠ 0 := by
    have : (1 : ℝ) / l ≠ 0 := one_div_ne_zero hl
    rw [neg_div]; exact neg_ne_zero.mpr this
  refine ⟨?_, fun h => this h.symm⟩
  intro h
  have h2 : (-1 / l) ^ 2 = 0 := by rw [← h]; ring
  exact this (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2)

/-- α-III.1 の合成:ダンベルの接合球(帽子側 w = −1/ℓ、首側 w = 0、W_t = 0)を通る時間的な面は殻なしに
  なれない。Israel の δ の係数(tube_israel)、K の跳び([R_x] = A[k₂]、[N_x] = A[k₁]、A 連続)、
  両側の nn 方程式 G_nn = 2ℓ² T̂_nn(gauss_tube、tnn_tube)を合わせる -/
theorem dumbbell_no_shellfree_timelike (G l N A R Nt Rt Rtt k1p k1m k2p k2m W jR jN Stt Sang : ℝ)
    (hG : G ≠ 0) (hl : l ≠ 0) (hN : N ≠ 0) (hA : A ≠ 0) (hR : R ≠ 0)
    (htt : -(2 * N ^ 2 * A⁻¹ ^ 2 * R⁻¹) * jR = 8 * π * G * Stt)
    (hang : R ^ 2 * A⁻¹ ^ 2 * N⁻¹ * jN = 8 * π * G * Sang)
    (hjR : jR = (k2p - k2m) * A) (hjN : jN = (k1p - k1m) * A)
    (eP : Gnn N R Nt Rt Rtt k1p k2p = 2 * l ^ 2 * Tnn R W 0 (-1 / l))
    (eM : Gnn N R Nt Rt Rtt k1m k2m = 2 * l ^ 2 * Tnn R W 0 0) :
    ¬ (Stt = 0 ∧ Sang = 0) := by
  intro hS
  obtain ⟨h1, h2⟩ := (tube_israel G N A R jR jN Stt Sang hG hN hA hR htt hang).mp hS
  rw [hjR] at h1; rw [hjN] at h2
  have e2 : k2p = k2m := by
    have := (mul_eq_zero.mp h1).resolve_right hA; linarith
  have e1 : k1p = k1m := by
    have := (mul_eq_zero.mp h2).resolve_right hA; linarith
  rw [e1, e2] at eP
  have := timelike_no_go l N R Nt Rt Rtt k1m k2m W (-1 / l) 0 hl hR eP eM
  exact (dumbbell_timelike l hl).1 this.symm

/-- YM の側の合成:同じ接合球で、表面の色の流れなしの時間的な面はない(j = N s [w] = N s/ℓ ≠ 0) -/
theorem dumbbell_color_current (N s l : ℝ) (hN : N ≠ 0) (hs : s ≠ 0) (hl : l ≠ 0) :
    N * s * 0 - N * s * (-1 / l) ≠ 0 := by
  intro h
  have := (color_current N s 0 (-1 / l) _ hN hs rfl).mp h
  exact (dumbbell_timelike l hl).2 this

/-! ### D. α-III.2:ヌルな波面の殻なし -/

/-- 混合成分の式の差:両側で r r_uv + r_u r_v = F(r, Ω, W の値が共通)なら r[r_uv] + r_v[r_u] = 0 -/
theorem jump_mixed (r rv rup rum ruvp ruvm F : ℝ) (hp : r * ruvp + rup * rv = F)
    (hm : r * ruvm + rum * rv = F) : r * (ruvp - ruvm) + rv * (rup - rum) = 0 := by
  linear_combination hp - hm

/-- 跳びの輸送:r q′ + r_v q = 0、q(v₀) = 0、r ≠ 0 なら区間の上で q = 0((r q)′ = 0) -/
theorem jump_transport {v0 v1 : ℝ} {r rv q q' : ℝ → ℝ}
    (hr : ∀ v ∈ Icc v0 v1, HasDerivWithinAt r (rv v) (Icc v0 v1) v)
    (hq : ∀ v ∈ Icc v0 v1, HasDerivWithinAt q (q' v) (Icc v0 v1) v)
    (heq : ∀ v ∈ Icc v0 v1, r v * q' v + rv v * q v = 0) (h0 : q v0 = 0)
    (hpos : ∀ v ∈ Icc v0 v1, r v ≠ 0) :
    ∀ v ∈ Icc v0 v1, q v = 0 := by
  have hd : ∀ v ∈ Icc v0 v1, HasDerivWithinAt (fun v => r v * q v) 0 (Icc v0 v1) v := by
    intro v hv
    have := (hr v hv).mul (hq v hv)
    convert this using 1
    linear_combination -(heq v hv)
  have hc : ContinuousOn (fun v => r v * q v) (Icc v0 v1) := fun v hv => (hd v hv).continuousWithinAt
  have hconst := constant_of_has_deriv_right_zero hc (fun v hv =>
    (hd v (Ico_subset_Icc_self hv)).mono_of_mem_nhdsWithin (Icc_mem_nhdsGE_of_mem hv))
  intro v hv
  have e := hconst v hv
  simp only [h0, mul_zero] at e
  exact (mul_eq_zero.mp e).resolve_left (hpos v hv)

/-- 角での初期値:∂_u = α(e_t − e_x) の向き(α は両側で共通)で、時間対称(r_t = 0)と
  C¹ の空間接合([r_x] = 0)なら [r_u] = 0 -/
theorem initial_jump (α rtp rtm rxp rxm : ℝ) (htp : rtp = 0) (htm : rtm = 0) (hx : rxp = rxm) :
    α * (rtp - rxp) - α * (rtm - rxm) = 0 := by
  rw [htp, htm, hx]; ring

/-- 波面全体で殻なし:面密度 μ(v) = −[r_u](v)/(4πG r(v))(AlphaIII_Null の null_shell_from_weak を
  各 v で)と、跳びの輸送から μ = 0 -/
theorem null_front_no_shell {v0 v1 G : ℝ} {r rv q q' μ : ℝ → ℝ}
    (hr : ∀ v ∈ Icc v0 v1, HasDerivWithinAt r (rv v) (Icc v0 v1) v)
    (hq : ∀ v ∈ Icc v0 v1, HasDerivWithinAt q (q' v) (Icc v0 v1) v)
    (heq : ∀ v ∈ Icc v0 v1, r v * q' v + rv v * q v = 0) (h0 : q v0 = 0)
    (hpos : ∀ v ∈ Icc v0 v1, r v ≠ 0)
    (hμ : ∀ v ∈ Icc v0 v1, μ v = -q v / (4 * π * G * r v)) :
    ∀ v ∈ Icc v0 v1, μ v = 0 := by
  intro v hv
  rw [hμ v hv, jump_transport hr hq heq h0 hpos v hv]
  simp

/-- α-III.2 の合成:両側の混合成分の式 r r_uv± + r_u± r_v = F(mixed_eq、F は r, Ω, W の共通の値)、
  角での [r_u] = 0(initial_jump)、r > 0 から、波面全体で面密度 μ = −[r_u]/(4πG r) = 0 -/
theorem null_front_from_mixed {v0 v1 G : ℝ} {r rv rup rum ruvp ruvm F μ : ℝ → ℝ}
    (hr : ∀ v ∈ Icc v0 v1, HasDerivWithinAt r (rv v) (Icc v0 v1) v)
    (hup : ∀ v ∈ Icc v0 v1, HasDerivWithinAt rup (ruvp v) (Icc v0 v1) v)
    (hum : ∀ v ∈ Icc v0 v1, HasDerivWithinAt rum (ruvm v) (Icc v0 v1) v)
    (sideP : ∀ v ∈ Icc v0 v1, r v * ruvp v + rup v * rv v = F v)
    (sideM : ∀ v ∈ Icc v0 v1, r v * ruvm v + rum v * rv v = F v)
    (h0 : rup v0 = rum v0) (hpos : ∀ v ∈ Icc v0 v1, r v ≠ 0)
    (hμ : ∀ v ∈ Icc v0 v1, μ v = -(rup v - rum v) / (4 * π * G * r v)) :
    ∀ v ∈ Icc v0 v1, μ v = 0 := by
  refine null_front_no_shell (q := fun v => rup v - rum v) (q' := fun v => ruvp v - ruvm v) hr
    (fun v hv => (hup v hv).sub (hum v hv)) (fun v hv => ?_) (by simp [h0]) hpos hμ
  have := jump_mixed (r v) (rv v) (rup v) (rum v) (ruvp v) (ruvm v) (F v) (sideP v hv) (sideM v hv)
  linear_combination this

/-- ダンベルの接合から出る波面:W_u = α(W_t − w)、W_t = 0 で [W_u] = −α[w] = −α/ℓ ≠ 0、
  [T̂_uu] = 2[W_u²]/r² ≠ 0。角(両側で r_u = 0)では uu 方程式 r_uu = (Ω_u/Ω) r_u − 2ℓ² W_u²/r から
  [r_uu] = −(2ℓ²/r)[W_u²]:波面は殻ではなく弱い不連続を運ぶ -/
theorem dumbbell_front (α l r : ℝ) (hα : α ≠ 0) (hl : l ≠ 0) (hr : r ≠ 0)
    (rup rum OuOp OuOm ruup ruum : ℝ) (hup : rup = 0) (hum : rum = 0)
    (hp : ruup = OuOp * rup - 2 * l ^ 2 * (α * (0 - 0)) ^ 2 / r)
    (hm : ruum = OuOm * rum - 2 * l ^ 2 * (α * (0 - -1 / l)) ^ 2 / r) :
    α * (0 - 0) - α * (0 - -1 / l) ≠ 0 ∧
    ruup - ruum = -(2 * l ^ 2 / r) * ((α * (0 - 0)) ^ 2 - (α * (0 - -1 / l)) ^ 2) ∧
    ruup - ruum ≠ 0 := by
  refine ⟨?_, ?_, ?_⟩
  · have : α * (0 - 0) - α * (0 - -1 / l) = -(α / l) := by ring
    rw [this]; exact neg_ne_zero.mpr (div_ne_zero hα hl)
  · rw [hp, hm, hup, hum]; ring
  · have key : ruup - ruum = 2 * α ^ 2 / r := by rw [hp, hm, hup, hum]; field_simp; ring
    rw [key]; exact div_ne_zero (by positivity) hr

end CFT.S4J

/-
  段階 5 の補い(2026-10-21 の外部レビュー):帽子の崩壊を曲率の不変量で直接示す、波面の軌道を導く

  * Riem:Riemann テンソル R^a_bce = ∂_c Γ^a_eb − ∂_e Γ^a_cb + Γ^a_cf Γ^f_eb − Γ^a_ef Γ^f_cb
  * KretD:対角な計量での全縮約 K = R_abce R^abce = Σ g_aa g^bb g^cc g^ee (R^a_bce)²(gD_diag で計量は対角)
  * kretD:一般の球対称な計量 −N²dt² + A²dx² + R²dΩ² の K を計算(Christoffel の表 GD から)
  * kret_cap:帽子(閉じた放射 FRW)で、場の方程式 a′² + a² = ℓ²、a″ = −a(cap_00、cap_22、cap_accel)のもとで
    K = 24ℓ⁴/a⁸(外部レビューの値と一致。共形時間で計算、固有時 τ = ℓ sin η で a² = ℓ² − τ²)
  * kret_blowup:a = ℓ cos η で η → π/2⁻ のとき K → ∞(密度の発散 cap_crunch とは別に、曲率の不変量の発散)
  * kret_center、density_center:K と ρ̂ は χ によらない(一様)ので、極座標の中心 χ → 0 でも同じ値
  * front_null、front_sign、front_inward、front_hits_center:共形計量 a²(−dη² + dχ²) のヌル曲線は χ′² = 1、
    連続な χ′ で χ′(0) = −1 なら至る所 −1、χ(0) = π/2 から χ = π/2 − η、中心 χ = 0 に着くのは η = π/2 だけ
  * curv_length、wgc_length:曲率の長さ L⁴ = 1/K = a⁸/(24ℓ⁴)(初期面で ℓ⁴/24)、WGC のカットオフの長さ
    (1/Λ)² = ℓ²/(4π)(Λ = g/√G、ℓ² = 4πG/g²)。ダンベルは最初からカットオフの尺度にある
-/
import CFT.AlphaS5_Evolution

namespace CFT.S5K

open CFT.S4 CFT.S5
open CFT.Propagation (deriv_inv deriv_ofNat)

section Curv
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- Riemann テンソル R^a_bce -/
def Riem (Γ : Fin 4 → Fin 4 → Fin 4 → S) (a b c e : Fin 4) : S :=
  d c (Γ a e b) - d e (Γ a c b) + ∑ f, (Γ a c f * Γ f e b - Γ a e f * Γ f c b)

/-- 対角な計量(成分 gd、逆 gid)での Kretschmann スカラー R_abce R^abce -/
def KretD (gd gid : Fin 4 → S) (Γ : Fin 4 → Fin 4 → Fin 4 → S) : S :=
  ∑ a, ∑ b, ∑ c, ∑ e, gd a * gid b * gid c * gid e * Riem d Γ a b c e ^ 2

/-- gD は対角で、成分は ![−N², A², R², R²s²](giD も同様) -/
theorem gD_diag (N A R s : S) :
    (∀ i j, gD N A R s i j = if i = j then ![-N ^ 2, A ^ 2, R ^ 2, R ^ 2 * s ^ 2] i else 0) ∧
    (∀ i j, giD N A R s i j = if i = j then ![-(N⁻¹ ^ 2), A⁻¹ ^ 2, R⁻¹ ^ 2, R⁻¹ ^ 2 * s⁻¹ ^ 2] i else 0) := by
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [gD, giD]

set_option maxHeartbeats 0 in
/-- 一般の球対称な計量の Kretschmann スカラー -/
theorem kretD (N A R s c : S) (H : SphD d N A R s c) :
    KretD d ![-N ^ 2, A ^ 2, R ^ 2, R ^ 2 * s ^ 2] ![-(N⁻¹ ^ 2), A⁻¹ ^ 2, R⁻¹ ^ 2, R⁻¹ ^ 2 * s⁻¹ ^ 2]
      (GD d N A R s c) = (4 : S) * (d 0 A) ^ 2 * (d 0 N) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 6 + (8 : S) * (d 0 A) ^ 2 * (d 0 R) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 4 * R⁻¹ ^ 2 + (-16 : S) * (d 0 A) ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 4 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (-8 : S) * (d 0 A) * (d 0 (d 0 A)) * (d 0 N) * A⁻¹ ^ 2 * N⁻¹ ^ 5 + (-8 : S) * (d 0 A) * (d 1 A) * (d 0 N) * (d 1 N) * A⁻¹ ^ 4 * N⁻¹ ^ 4 + (16 : S) * (d 0 A) * (d 1 A) * (d 0 R) * (d 1 R) * A⁻¹ ^ 4 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (8 : S) * (d 0 A) * (d 0 N) * (d 1 (d 1 N)) * A⁻¹ ^ 3 * N⁻¹ ^ 4 + (-32 : S) * (d 0 A) * (d 1 N) * (d 0 R) * (d 1 R) * A⁻¹ ^ 3 * N⁻¹ ^ 3 * R⁻¹ ^ 2 + (-16 : S) * (d 0 A) * (d 0 R) * (d 1 (d 1 R)) * A⁻¹ ^ 3 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (32 : S) * (d 0 A) * (d 0 (d 1 R)) * (d 1 R) * A⁻¹ ^ 3 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (4 : S) * (d 0 (d 0 A)) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 4 + (8 : S) * (d 0 (d 0 A)) * (d 1 A) * (d 1 N) * A⁻¹ ^ 4 * N⁻¹ ^ 3 + (-8 : S) * (d 0 (d 0 A)) * (d 1 (d 1 N)) * A⁻¹ ^ 3 * N⁻¹ ^ 3 + (4 : S) * (d 1 A) ^ 2 * (d 1 N) ^ 2 * A⁻¹ ^ 6 * N⁻¹ ^ 2 + (8 : S) * (d 1 A) ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 6 * R⁻¹ ^ 2 + (-8 : S) * (d 1 A) * (d 1 N) * (d 1 (d 1 N)) * A⁻¹ ^ 5 * N⁻¹ ^ 2 + (-16 : S) * (d 1 A) * (d 1 R) * (d 1 (d 1 R)) * A⁻¹ ^ 5 * R⁻¹ ^ 2 + (8 : S) * (d 0 N) ^ 2 * (d 0 R) ^ 2 * N⁻¹ ^ 6 * R⁻¹ ^ 2 + (16 : S) * (d 0 N) * (d 1 N) * (d 0 R) * (d 1 R) * A⁻¹ ^ 2 * N⁻¹ ^ 4 * R⁻¹ ^ 2 + (-16 : S) * (d 0 N) * (d 0 R) * (d 0 (d 0 R)) * N⁻¹ ^ 5 * R⁻¹ ^ 2 + (-16 : S) * (d 1 N) ^ 2 * (d 0 R) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 4 * R⁻¹ ^ 2 + (8 : S) * (d 1 N) ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 4 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (32 : S) * (d 1 N) * (d 0 R) * (d 0 (d 1 R)) * A⁻¹ ^ 2 * N⁻¹ ^ 3 * R⁻¹ ^ 2 + (-16 : S) * (d 1 N) * (d 0 (d 0 R)) * (d 1 R) * A⁻¹ ^ 2 * N⁻¹ ^ 3 * R⁻¹ ^ 2 + (4 : S) * (d 1 (d 1 N)) ^ 2 * A⁻¹ ^ 4 * N⁻¹ ^ 2 + (4 : S) * (d 0 R) ^ 4 * N⁻¹ ^ 4 * R⁻¹ ^ 4 + (-8 : S) * (d 0 R) ^ 2 * (d 1 R) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 2 * R⁻¹ ^ 4 + (8 : S) * (d 0 R) ^ 2 * N⁻¹ ^ 2 * R⁻¹ ^ 4 + (8 : S) * (d 0 (d 0 R)) ^ 2 * N⁻¹ ^ 4 * R⁻¹ ^ 2 + (-16 : S) * (d 0 (d 1 R)) ^ 2 * A⁻¹ ^ 2 * N⁻¹ ^ 2 * R⁻¹ ^ 2 + (4 : S) * (d 1 R) ^ 4 * A⁻¹ ^ 4 * R⁻¹ ^ 4 + (-8 : S) * (d 1 R) ^ 2 * A⁻¹ ^ 2 * R⁻¹ ^ 4 + (8 : S) * (d 1 (d 1 R)) ^ 2 * A⁻¹ ^ 4 * R⁻¹ ^ 2 + (4 : S) * R⁻¹ ^ 4 := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [KretD, Riem, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero, ne_eq,
    OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, sub_self]
  have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
  have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
  generalize N⁻¹ = iN at hiN ⊢
  generalize A⁻¹ = iA at hiA ⊢
  generalize R⁻¹ = iR at hiR ⊢
  generalize s⁻¹ = is at his ⊢
  linear_combination ((-2 : S) * A ^ 4 * (d 0 A) ^ 2 * N * (d 1 N) ^ 2 * iA ^ 8 * iN ^ 5 + (-2 : S) * A ^ 4 * (d 0 A) ^ 2 * (d 1 N) ^ 2 * iA ^ 8 * iN ^ 4 + (4 : S) * A ^ 3 * (d 0 A) ^ 2 * (d 1 N) ^ 2 * iA ^ 7 * iN ^ 4 + (2 : S) * A ^ 2 * (d 0 A) ^ 4 * N * iA ^ 6 * iN ^ 5 + (2 : S) * A ^ 2 * (d 0 A) ^ 4 * iA ^ 6 * iN ^ 4 + (4 : S) * A ^ 2 * (d 0 A) ^ 3 * N * (d 0 N) * iA ^ 5 * iN ^ 6 + (4 : S) * A ^ 2 * (d 0 A) ^ 3 * (d 0 N) * iA ^ 5 * iN ^ 5 + (-4 : S) * A ^ 2 * (d 0 A) ^ 2 * (d 0 (d 0 A)) * N * iA ^ 5 * iN ^ 5 + (-4 : S) * A ^ 2 * (d 0 A) ^ 2 * (d 0 (d 0 A)) * iA ^ 5 * iN ^ 4 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * N ^ 3 * (d 1 N) ^ 2 * iA ^ 6 * iN ^ 7 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * N ^ 2 * (d 1 N) ^ 2 * iA ^ 6 * iN ^ 6 + (2 : S) * A ^ 2 * (d 0 A) ^ 2 * N * (d 0 N) ^ 2 * iA ^ 4 * iN ^ 7 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * N * (d 1 N) ^ 2 * iA ^ 6 * iN ^ 5 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * N * R ^ 2 * (d 1 R) ^ 2 * iA ^ 6 * iN ^ 3 * iR ^ 4 * is ^ 4 * s ^ 4 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * N * R ^ 2 * (d 1 R) ^ 2 * iA ^ 6 * iN ^ 3 * iR ^ 4 + (2 : S) * A ^ 2 * (d 0 A) ^ 2 * (d 0 N) ^ 2 * iA ^ 4 * iN ^ 6 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * (d 1 N) ^ 2 * iA ^ 6 * iN ^ 4 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * R ^ 2 * (d 1 R) ^ 2 * iA ^ 6 * iN ^ 2 * iR ^ 4 * is ^ 4 * s ^ 4 + (-2 : S) * A ^ 2 * (d 0 A) ^ 2 * R ^ 2 * (d 1 R) ^ 2 * iA ^ 6 * iN ^ 2 * iR ^ 4 + (-4 : S) * A ^ 2 * (d 0 A) * (d 0 (d 0 A)) * N * (d 0 N) * iA ^ 4 * iN ^ 6 + (-4 : S) * A ^ 2 * (d 0 A) * (d 0 (d 0 A)) * (d 0 N) * iA ^ 4 * iN ^ 5 + (-4 : S) * A ^ 2 * (d 0 A) * (d 1 A) * (d 0 N) * (d 1 N) * iA ^ 6 * iN ^ 4 + (-4 : S) * A ^ 2 * (d 0 A) * (d 0 N) * (d 1 N) ^ 2 * iA ^ 5 * iN ^ 5 + (4 : S) * A ^ 2 * (d 0 A) * (d 0 N) * (d 1 (d 1 N)) * iA ^ 5 * iN ^ 4 + (-4 : S) * A ^ 2 * (d 0 A) * (d 1 N) * R ^ 2 * (d 0 R) * (d 1 R) * iA ^ 5 * iN ^ 3 * iR ^ 4 * is ^ 4 * s ^ 4 + (-4 : S) * A ^ 2 * (d 0 A) * (d 1 N) * R ^ 2 * (d 0 R) * (d 1 R) * iA ^ 5 * iN ^ 3 * iR ^ 4 + (2 : S) * A ^ 2 * (d 0 (d 0 A)) ^ 2 * N * iA ^ 4 * iN ^ 5