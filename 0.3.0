      linear_combination H.fs1et
    have k0 := cfr6_k0 (lam 0) (lam 1) (lam 2) (alpha F lam) (beta F lam) (gamma F lam) (eta F lam)
    have k1 := cfr6_k1 (lam 0) (lam 1) (lam 2) (alpha F lam) (beta F lam) (gamma F lam) (eta F lam)
