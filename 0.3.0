/-- 帽子の tχ 成分は恒等的に成り立つ(W_η = 0) -/
theorem cap_01 (a X Y s c l : S) (H : CapData d a X Y s c) :
    Ein d (gD a a (a * X) s) (giD a a (a * X) s) (GD d a a (a * X) s c) 0 1
      = 2 * l ^ 2 * Tym (gD a a (a * X) s) (giD a a (a * X) s) (FT d Y s) 0 1 := by
  have HS := capSph d a X Y s c H
  obtain ⟨ha, hX, hs, a1, a2, a3, X0, X1, X2, X3, Y0, Y1, hXY, -, -, -, -, -, -, -, -, comm⟩ := H
  have za : d 1 (d 0 a) = 0 := by rw [comm 1 0 a, a1, map_zero]
  rw [einD_01 d a a (a * X) s c HS, tymD_01 d Y s ha ha (mul_ne_zero ha hX) hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.leibniz, smul_eq_mul, mul_inv,
    a1, X0, X1, Y0, Y1, za, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hia : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
  have hiX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
  generalize a⁻¹ = ia at hia ⊢
  generalize X⁻¹ = iX at hiX ⊢
  linear_combination ((2 : S) * Y * (d 0 a) * iX * ia) * hia

/-- 首:時間 t(座標 0)と z(座標 1)、N = 1、A = C(C = cos(t/ℓ)、S = sin(t/ℓ))、R = ℓ、W = 0 -/
structure NeckData (C Sn l s c : S) : Prop where
  hC : C ≠ 0
  hl : l ≠ 0
  hs : s ≠ 0
  dl : ∀ i, d i l = 0
  C0 : d 0 C = -(Sn * l⁻¹)
  C1 : d 1 C = 0
  C2 : d 2 C = 0
  C3 : d 3 C = 0
  S0 : d 0 Sn = C * l⁻¹
  S1 : d 1 Sn = 0
  s0 : d 0 s = 0
  s1 : d 1 s = 0
  s2 : d 2 s = c
  s3 : d 3 s = 0
  c0 : d 0 c = 0
  c1 : d 1 c = 0
  c2 : d 2 c = -s
  c3 : d 3 c = 0
  comm : ∀ i j f, d i (d j f) = d j (d i f)

theorem neckSph (C Sn l s c : S) (H : NeckData d C Sn l s c) : SphD d 1 C l s c := by
  obtain ⟨hC, hl, hs, dl, C0, C1, C2, C3, S0, S1, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  exact ⟨one_ne_zero, hC, hl, hs, Derivation.map_one_eq_zero _, Derivation.map_one_eq_zero _, C2, C3,
    dl 2, dl 3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩

set_option maxHeartbeats 0 in
/-- 首(AdS₂ × S² の同期座標 −dt² + cos²(t/ℓ)dz² + ℓ²dΩ²)は EYM の (0,0) 成分を満たす -/
theorem neck_00 (C Sn l s c : S) (H : NeckData d C Sn l s c) :
    Ein d (gD 1 C l s) (giD 1 C l s) (GD d 1 C l s c) 0 0
      = 2 * l ^ 2 * Tym (gD 1 C l s) (giD 1 C l s) (FT d 0 s) 0 0 := by
  have HS := neckSph d C Sn l s c H
  obtain ⟨hC, hl, hs, dl, C0, C1, C2, C3, S0, S1, -, -, -, -, -, -, -, -, comm⟩ := H
  have il := fun i => deriv_inv (d i) l hl
  rw [einD_00 d 1 C l s c HS, tymD_00 d 0 s one_ne_zero hC hl hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    smul_eq_mul, inv_one, one_pow, il, dl, C0, C1, S0, S1, mul_zero, zero_mul, add_zero, zero_add,
    sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  have hiC : C * C⁻¹ = 1 := mul_inv_cancel₀ hC
  have hil : l * l⁻¹ = 1 := mul_inv_cancel₀ hl
  generalize C⁻¹ = iC at hiC ⊢
  generalize l⁻¹ = il at hil ⊢
  linear_combination ((-1 : S) * il ^ 3 * l + (-1 : S) * il ^ 2) * hil

set_option maxHeartbeats 0 in
/-- 首(AdS₂ × S² の同期座標 −dt² + cos²(t/ℓ)dz² + ℓ²dΩ²)は EYM の (1,1) 成分を満たす -/
theorem neck_11 (C Sn l s c : S) (H : NeckData d C Sn l s c) :
    Ein d (gD 1 C l s) (giD 1 C l s) (GD d 1 C l s c) 1 1
      = 2 * l ^ 2 * Tym (gD 1 C l s) (giD 1 C l s) (FT d 0 s) 1 1 := by
  have HS := neckSph d C Sn l s c H
  obtain ⟨hC, hl, hs, dl, C0, C1, C2, C3, S0, S1, -, -, -, -, -, -, -, -, comm⟩ := H
  have il := fun i => deriv_inv (d i) l hl
  rw [einD_11 d 1 C l s c HS, tymD_11 d 0 s one_ne_zero hC hl hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    smul_eq_mul, inv_one, one_pow, il, dl, C0, C1, S0, S1, mul_zero, zero_mul, add_zero, zero_add,
    sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  have hiC : C * C⁻¹ = 1 := mul_inv_cancel₀ hC
  have hil : l * l⁻¹ = 1 := mul_inv_cancel₀ hl
  generalize C⁻¹ = iC at hiC ⊢
  generalize l⁻¹ = il at hil ⊢
  linear_combination ((1 : S) * C ^ 2 * il ^ 3 * l + (1 : S) * C ^ 2 * il ^ 2) * hil

set_option maxHeartbeats 0 in
/-- 首(AdS₂ × S² の同期座標 −dt² + cos²(t/ℓ)dz² + ℓ²dΩ²)は EYM の (2,2) 成分を満たす -/
theorem neck_22 (C Sn l s c : S) (H : NeckData d C Sn l s c) :
    Ein d (gD 1 C l s) (giD 1 C l s) (GD d 1 C l s c) 2 2
      = 2 * l ^ 2 * Tym (gD 1 C l s) (giD 1 C l s) (FT d 0 s) 2 2 := by
  have HS := neckSph d C Sn l s c H
  obtain ⟨hC, hl, hs, dl, C0, C1, C2, C3, S0, S1, -, -, -, -, -, -, -, -, comm⟩ := H
  have il := fun i => deriv_inv (d i) l hl
  rw [einD_22 d 1 C l s c HS, tymD_22 d 0 s one_ne_zero hC hl hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    smul_eq_mul, inv_one, one_pow, il, dl, C0, C1, S0, S1, mul_zero, zero_mul, add_zero, zero_add,
    sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  have hiC : C * C⁻¹ = 1 := mul_inv_cancel₀ hC
  have hil : l * l⁻¹ = 1 := mul_inv_cancel₀ hl
  generalize C⁻¹ = iC at hiC ⊢
  generalize l⁻¹ = il at hil ⊢
  linear_combination ((1 : S) * il ^ 2 * l ^ 2) * hiC

set_option maxHeartbeats 0 in
/-- 首(AdS₂ × S² の同期座標 −dt² + cos²(t/ℓ)dz² + ℓ²dΩ²)は EYM の (0,1) 成分を満たす -/
theorem neck_01 (C Sn l s c : S) (H : NeckData d C Sn l s c) :
    Ein d (gD 1 C l s) (giD 1 C l s) (GD d 1 C l s c) 0 1
      = 2 * l ^ 2 * Tym (gD 1 C l s) (giD 1 C l s) (FT d 0 s) 0 1 := by
  have HS := neckSph d C Sn l s c H
  obtain ⟨hC, hl, hs, dl, C0, C1, C2, C3, S0, S1, -, -, -, -, -, -, -, -, comm⟩ := H
  have il := fun i => deriv_inv (d i) l hl
  rw [einD_01 d 1 C l s c HS, tymD_01 d 0 s one_ne_zero hC hl hs]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.map_one_eq_zero, Derivation.leibniz,
    smul_eq_mul, inv_one, one_pow, il, dl, C0, C1, S0, S1, mul_zero, zero_mul, add_zero, zero_add,
    sub_zero, zero_sub, neg_zero, mul_one, one_mul]
  have hiC : C * C⁻¹ = 1 := mul_inv_cancel₀ hC
  have hil : l * l⁻¹ = 1 := mul_inv_cancel₀ hl
  generalize C⁻¹ = iC at hiC ⊢
  generalize l⁻¹ = il at hil ⊢
  linear_combination 0

end Exact

import sympy as sp, re
t,x,th,ph=sp.symbols('t x th ph')
X=[t,x,th,ph]
def christ(g):
    gi=sp.simplify(g.inv()); n=4
    return gi,[[[sp.simplify(sum(gi[a,d]*(sp.diff(g[d,c],X[b])+sp.diff(g[d,b],X[c])-sp.diff(g[b,c],X[d])) for d in range(n))/2) for c in range(n)] for b in range(n)] for a in range(n)]
def ricci(g,Gam):
    n=4;Ric=sp.zeros(n)
    for b in range(n):
        for c in range(n):
            Ric[b,c]=sp.simplify(sum(sp.diff(Gam[a][b][c],X[a])-sp.diff(Gam[a][b][a],X[c]) for a in range(n))+sum(Gam[a][a][e]*Gam[e][b][c]-Gam[a][c][e]*Gam[e][b][a] for a in range(n) for e in range(n)))
    return Ric
S,C=sp.symbols('s c')
def lean(e,funs):
    e=sp.simplify(e)
    e=e.subs({sp.sin(th):S,sp.cos(th):C})
    # replace derivatives
    rep={}
    for f in funs:
        F=sp.Function(f)(t,x)
        for (k,nm) in [((t,t),'d 0 (d 0 %s)'),((t,x),'d 0 (d 1 %s)'),((x,x),'d 1 (d 1 %s)'),((t,),'d 0 %s'),((x,),'d 1 %s')]:
            rep[sp.Derivative(F,*k)]=sp.Symbol('('+nm%f+')')
    order=sorted(rep.keys(),key=lambda d:-len(d.variables))
    for k in order: e=e.subs(k,rep[k])
    for f in funs: e=e.subs(sp.Function(f)(t,x),sp.Symbol(f))
    s=sp.sstr(e)
    s=s.replace('**','^')
    # inverse powers: use x⁻¹
    return s
def table(Gam,funs):
    rows=[]
    for a in range(4):
        rb=[]
        for b in range(4):
            rb.append('!['+', '.join(lean(Gam[a][b][c],funs) for c in range(4))+']')
        rows.append('![' + ', '.join(rb)+']')
    return '![' + ',\n    '.join(rows)+']'
N=sp.Function('N')(t,x);A=sp.Function('A')(t,x);R=sp.Function('R')(t,x)
g=sp.diag(-N**2,A**2,R**2,R**2*sp.sin(th)**2)
gi,Gam=christ(g)
print(table(Gam,['N','A','R']))
Om=sp.Function('Om')(t,x);r=sp.Function('r')(t,x)
g2=sp.Matrix([[0,-Om,0,0],[-Om,0,0,0],[0,0,r**2,0],[0,0,0,r**2*sp.sin(th)**2]])
gi2,Gam2=christ(g2)
print(table(Gam2,['Om','r']))

import sympy as sp, pickle
t,x,th,ph=sp.symbols('t x th ph'); X=[t,x,th,ph]
S,C=sp.symbols('s c')
def full(g):
    gi=sp.simplify(g.inv()); n=4
    Gam=[[[sp.simplify(sum(gi[a,d]*(sp.diff(g[d,c],X[b])+sp.diff(g[d,b],X[c])-sp.diff(g[b,c],X[d])) for d in range(n))/2) for c in range(n)] for b in range(n)] for a in range(n)]
    Ric=sp.zeros(n)
    for b in range(n):
        for c in range(n):
            Ric[b,c]=sp.simplify(sum(sp.diff(Gam[a][b][c],X[a])-sp.diff(Gam[a][b][a],X[c]) for a in range(n))+sum(Gam[a][a][e]*Gam[e][b][c]-Gam[a][c][e]*Gam[e][b][a] for a in range(n) for e in range(n)))
    Rs=sp.simplify(sum(gi[a,b]*Ric[a,b] for a in range(n) for b in range(n)))
    G=(Ric-g*Rs/2).applyfunc(sp.simplify)
    return Ric,Rs,G
def lean(e,funs):
    e=sp.expand(sp.simplify(e)).subs({sp.sin(th):S,sp.cos(th):C})
    rep={}
    for f in funs:
        F=sp.Function(f)(t,x)
        for (k,nm) in [((t,t),'d 0 (d 0 %s)'),((t,x),'d 0 (d 1 %s)'),((x,x),'d 1 (d 1 %s)'),((t,),'d 0 %s'),((x,),'d 1 %s')]:
            rep[sp.Derivative(F,*k)]=sp.Symbol('('+nm%f+')')
    for k in sorted(rep.keys(),key=lambda d:-len(d.variables)): e=e.subs(k,rep[k])
    for f in funs: e=e.subs(sp.Function(f)(t,x),sp.Symbol(f))
    return sp.sstr(e).replace('**','^')
out={}
N=sp.Function('N')(t,x);A=sp.Function('A')(t,x);R=sp.Function('R')(t,x)
Ric,Rs,G=full(sp.diag(-N**2,A**2,R**2,R**2*sp.sin(th)**2))
for (i,j) in [(0,0),(1,1),(2,2),(3,3),(0,1)]:
    out['RicD%d%d'%(i,j)]=lean(Ric[i,j],['N','A','R'])
    out['EinD%d%d'%(i,j)]=lean(G[i,j],['N','A','R'])
out['RscD']=lean(Rs,['N','A','R'])
Om=sp.Function('Om')(t,x);r=sp.Function('r')(t,x)
Ric,Rs,G=full(sp.Matrix([[0,-Om,0,0],[-Om,0,0,0],[0,0,r**2,0],[0,0,0,r**2*sp.sin(th)**2]]))
for (i,j) in [(0,0),(1,1),(2,2),(3,3),(0,1)]:
    out['RicN%d%d'%(i,j)]=lean(Ric[i,j],['Om','r'])
    out['EinN%d%d'%(i,j)]=lean(G[i,j],['Om','r'])
out['RscN']=lean(Rs,['Om','r'])
for k,v in out.items(): print(k,':=',v)
pickle.dump(out,open('closed.pkl','wb'))

import sympy as sp, itertools, pickle
# jets
def mk(f): 
    return {k:sp.Symbol(f+k) for k in ['','t','x','tt','tx','xx']}
def setup(funs):
    J={f:mk(f) for f in funs}
    inv={f:sp.Symbol('i'+f) for f in funs}
    s,c,is_=sp.symbols('s c is_')
    # derivative of atoms: dict atom -> list of 4 derivatives
    D={}
    z=sp.Integer(0)
    for f in funs:
        j=J[f]
        D[j['']]=[j['t'],j['x'],z,z]
        D[j['t']]=[j['tt'],j['tx'],z,z]
        D[j['x']]=[j['tx'],j['xx'],z,z]
        for k in ['tt','tx','xx']: D[j[k]]=None  # third derivatives should not appear
        D[inv[f]]=[-inv[f]**2*j['t'],-inv[f]**2*j['x'],z,z]
    D[s]=[z,z,c,z]; D[c]=[z,z,-s,z]; D[is_]=[z,z,-is_**2*c,z]
    rels=[J[f]['']*inv[f]-1 for f in funs]+[s*is_-1]
    gens=[inv[f] for f in funs]+[is_]+[J[f]['']for f in funs]+[s]
    return J,inv,(s,c,is_),D,rels,gens
def Der(i,e,D):
    e=sp.expand(e); out=0
    for a in e.free_symbols:
        da=D[a]
        if da is None: raise Exception('third derivative '+str(a))
        out+=sp.diff(e,a)*da[i]
    return sp.expand(out)
def ric(G,D):
    R={}
    for b in range(4):
        for cc in range(4):
            R[b,cc]=sp.expand(sum(Der(a,G[a][b][cc],D)-Der(cc,G[a][b][a],D) for a in range(4))+sum(G[a][a][e]*G[e][b][cc]-G[a][cc][e]*G[e][b][a] for a in range(4) for e in range(4)))
    return R
def tolean(e,J,inv,sc):
    s,c,is_=sc
    names={}
    for f,j in J.items():
        names[j['']]=f; names[j['t']]='d 0 %s'%f; names[j['x']]='d 1 %s'%f
        names[j['tt']]='d 0 (d 0 %s)'%f; names[j['tx']]='d 0 (d 1 %s)'%f; names[j['xx']]='d 1 (d 1 %s)'%f
        names[inv[f]]='%s⁻¹'%f
    names[s]='s';names[c]='c';names[is_]='s⁻¹'
    e=sp.expand(e)
    if e==0: return '0'
    if not e.free_symbols:
        q=sp.Rational(e); return '(%s : S)'%q if q.q!=1 else '(%d : S)'%q.p
    terms=[]
    for mon,coef in sp.Poly(e,*sorted(e.free_symbols,key=str)).terms():
        gens=sorted(e.free_symbols,key=str)
        fac=[]
        for g,p in zip(gens,mon):
            if p==0: continue
            nm=names[g]; nm2=nm if (' ' not in nm) else '('+nm+')'
            if nm.endswith('⁻¹') : nm2=nm
            fac.append(nm2 if p==1 else '%s ^ %d'%(nm2,p))
        coef=sp.Rational(coef)
        cs='(%s : S)'%(str(coef)) if coef.q!=1 else '(%d : S)'%coef.p
        terms.append(' * '.join([cs]+fac))
    return ' + '.join(terms)
def quot(P,rels,gens):
    P=sp.expand(P)
    if P==0: return [0]*len(rels)
    Q,r=sp.reduced(P,rels,*gens)
    assert sp.expand(r)==0, r
    assert sp.expand(P-sum(q*rl for q,rl in zip(Q,rels)))==0
    return Q

import sympy as sp, pickle
from gen3 import *
def tl(e,J,inv,sc,gen=False):
    s=tolean(e,J,inv,sc)
    if gen:
        for f in J: s=s.replace('%s⁻¹'%f,'i'+f)
        s=s.replace('s⁻¹','is')
    return s
out=[]
def build(kind):
    if kind=='D':
        funs=['N','A','R']
    else:
        funs=['Om','r']
    J,inv,sc,D,rels,gens=setup(funs)
    s,c,is_=sc
    z=0
    if kind=='D':
        N,A,R=[J[f][''] for f in funs]; iN,iA,iR=[inv[f] for f in funs]
        t=lambda f,k:J[f][k]
        G=[[[t('N','t')*iN,t('N','x')*iN,0,0],[t('N','x')*iN,t('A','t')*A*iN**2,0,0],[0,0,t('R','t')*R*iN**2,0],[0,0,0,t('R','t')*R*s**2*iN**2]],
           [[t('N','x')*N*iA**2,t('A','t')*iA,0,0],[t('A','t')*iA,t('A','x')*iA,0,0],[0,0,-(t('R','x')*R*iA**2),0],[0,0,0,-(t('R','x')*R*s**2*iA**2)]],
           [[0,0,t('R','t')*iR,0],[0,0,t('R','x')*iR,0],[t('R','t')*iR,t('R','x')*iR,0,0],[0,0,0,-(s*c)]],
           [[0,0,0,t('R','t')*iR],[0,0,0,t('R','x')*iR],[0,0,0,c*is_],[t('R','t')*iR,t('R','x')*iR,c*is_,0]]]
        g=sp.diag(-N**2,A**2,R**2,R**2*s**2); gi=sp.diag(-iN**2,iA**2,iR**2,iR**2*is_**2)
        comps=[(0,0),(1,1),(2,2),(3,3),(0,1)]; ecomps=[(0,0),(1,1),(2,2),(0,1)]
    else:
        O,r=[J[f][''] for f in funs]; iO,ir=[inv[f] for f in funs]
        t=lambda f,k:J[f][k]
        G=[[[t('Om','t')*iO,0,0,0],[0,0,0,0],[0,0,t('r','x')*r*iO,0],[0,0,0,t('r','x')*r*s**2*iO]],
           [[0,0,0,0],[0,t('Om','x')*iO,0,0],[0,0,t('r','t')*r*iO,0],[0,0,0,t('r','t')*r*s**2*iO]],
           [[0,0,t('r','t')*ir,0],[0,0,t('r','x')*ir,0],[t('r','t')*ir,t('r','x')*ir,0,0],[0,0,0,-(s*c)]],
           [[0,0,0,t('r','t')*ir],[0,0,0,t('r','x')*ir],[0,0,0,c*is_],[t('r','t')*ir,t('r','x')*ir,c*is_,0]]]
        g=sp.Matrix([[0,-O,0,0],[-O,0,0,0],[0,0,r**2,0],[0,0,0,r**2*s**2]]); gi=sp.Matrix([[0,-iO,0,0],[-iO,0,0,0],[0,0,ir**2,0],[0,0,0,ir**2*is_**2]])
        comps=[(0,0),(1,1),(2,2),(3,3),(0,1),(1,0)]; ecomps=[(0,0),(1,1),(2,2),(0,1)]
    G=[[[sp.sympify(e) for e in row] for row in m] for m in G]
    Ric=ric(G,D)
    NF={}
    res={'funs':funs}
    for (i,j) in comps:
        P=Ric[i,j]; Q,rem=sp.reduced(P,rels,*gens)
        NF[i,j]=sp.expand(rem)
        res['ric',i,j]=(tl(NF[i,j],J,inv,sc),[tl(q,J,inv,sc,True) for q in Q])
    rsc_poly=sp.expand(sum(gi[a,b]*NF[a,b] for a in range(4) for b in range(4) if gi[a,b]!=0))
    Q,rem=sp.reduced(rsc_poly,rels,*gens); NFs=sp.expand(rem)
    res['rsc']=(tl(NFs,J,inv,sc),[tl(q,J,inv,sc,True) for q in Q])
    for (i,j) in ecomps:
        P=sp.expand(NF[i,j]-sp.Rational(1,2)*g[i,j]*NFs)
        Q,rem=sp.reduced(P,rels,*gens)
        res['ein',i,j]=(tl(sp.expand(rem),J,inv,sc),[tl(q,J,inv,sc,True) for q in Q],sp.expand(rem))
    res['J']=J;res['inv']=inv;res['sc']=sc
    return res
RD=build('D'); RN=build('N')
for k in [('ein',0,0),('ein',1,1),('ein',0,1)]: print('D',k,RD[k][0][:400])
for k in [('ein',0,0),('ein',0,1),('ein',2,2)]: print('N',k,RN[k][0][:400])
pickle.dump({'D':{k:v for k,v in RD.items() if k not in('J','inv','sc')},'N':{k:v for k,v in RN.items() if k not in('J','inv','sc')}},open('cert.pkl','wb'))

