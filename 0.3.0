  have d20be := congrArg (F.e 2) H.fs0be
  simp only [map_add, map_sub, map_neg, Derivation.leibniz, Derivation.leibniz_pow, nsmul_eq_mul, Nat.cast_ofNat, pow_one, smul_eq_mul, Derivation.map_one_eq_zero, H.e_ofNat, H.pD00, H.pD01, H.pD02, H.pD10, H.pD11, H.pD12, H.pD20, H.pD21, H.pD22] at d20be
  have key : (1) * n4 (lam 0) (lam 1) (lam 2) (alpha F lam) (beta F lam) (gamma F lam) (eta F lam) (F.e 2 (alpha F lam)) (F.e 2 (beta F lam)) (F.e 2 (gamma F lam)) (F.e 2 (eta F lam)) (F.e 0 (F.e 2 (alpha F lam))) (F.e 0 (F.e 2 (beta F lam))) (F.e 0 (F.e 2 (gamma F lam))) (F.e 0 (F.e 2 (eta F lam))) (F.e 1 (F.e 2 (alpha F lam))) (F.e 1 (F.e 2 (beta F lam))) (F.e 1 (F.e 2 (gamma F lam))) (F.e 1 (F.e 2 (eta F lam))) (F.e 2 (F.e 2 (alpha F lam))) (F.e 2 (F.e 2 (beta F lam))) (F.e 2 (F.e 2 (gamma F lam))) (F.e 2 (F.e 2 (eta F lam))) = 0 := by
    simp only [n4]
    linear_combination (((2 * ((lam 1)^(6:ℕ))) + (-8 * (lam 0) * ((lam 1)^(5:ℕ))) + (-8 * ((lam 0)^(3:ℕ)) * ((lam 1)^(3:ℕ))) + (-4 * (lam 2) * ((lam 1)^(5:ℕ))) + (2 * ((lam 0)^(4:ℕ)) * ((lam 1)^(2:ℕ))) + (2 * ((lam 0)^(4:ℕ)) * ((lam 2)^(2:ℕ))) + (2 * ((lam 1)^(4:ℕ)) * ((lam 2)^(2:ℕ))) + (12 * ((lam 0)^(2:ℕ)) * ((lam 1)^(4:ℕ))) + (-24 * (lam 2) * ((lam 0)^(2:ℕ)) * ((lam 1)^(3:ℕ))) + (-8 * (lam 0) * ((lam 1)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (-8 * (lam 1) * ((lam 0)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (-4 * (lam 1) * (lam 2) * ((lam 0)^(4:ℕ))) + (12 * ((lam 0)^(2:ℕ)) * ((lam 1)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (16 * (lam 0) * (lam 2) * ((lam 1)^(4:ℕ))) + (16 * (lam 2) * ((lam 0)^(3:ℕ)) * ((lam 1)^(2:ℕ))))) * t + (((2 * ((lam 1)^(4:ℕ))) + (-4 * (lam 0) * ((lam 1)^(3:ℕ))) + (-4 * (lam 2) * ((lam 1)^(3:ℕ))) + (2 * ((lam 0)^(2:ℕ)) * ((lam 1)^(2:ℕ))) + (2 * ((lam 0)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (2 * ((lam 1)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (-4 * (lam 0) * (lam 1) * ((lam 2)^(2:ℕ))) + (-4 * (lam 1) * (lam 2) * ((lam 0)^(2:ℕ))) + (8 * (lam 0) * (lam 2) * ((lam 1)^(2:ℕ))))) * d20be + (((-2 * (gamma F lam) * ((lam 1)^(6:ℕ))) + (-28 * (gamma F lam) * ((lam 1)^(3:ℕ)) * ((lam 2)^(3:ℕ))) + (-14 * (gamma F lam) * ((lam 0)^(2:ℕ)) * ((lam 2)^(4:ℕ))) + (-8 * (gamma F lam) * (lam 1) * ((lam 2)^(5:ℕ))) + (-4 * (gamma F lam) * ((lam 0)^(3:ℕ)) * ((lam 1)^(3:ℕ))) + (-2 * (gamma F lam) * ((lam 0)^(2:ℕ)) * ((lam 1)^(4:ℕ))) + (4 * (gamma F lam) * (lam 2) * ((lam 1)^(5:ℕ))) + (4 * (gamma F lam) * ((lam 0)^(3:ℕ)) * ((lam 2)^(3:ℕ))) + (8 * (gamma F lam) * (lam 0) * ((lam 1)^(5:ℕ))) + (8 * (gamma F lam) * (lam 0) * ((lam 2)^(5:ℕ))) + (8 * (gamma F lam) * ((lam 1)^(4:ℕ)) * ((lam 2)^(2:ℕ))) + (26 * (gamma F lam) * ((lam 1)^(2:ℕ)) * ((lam 2)^(4:ℕ))) + (-48 * (gamma F lam) * ((lam 0)^(2:ℕ)) * ((lam 1)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (-36 * (gamma F lam) * (lam 0) * (lam 2) * ((lam 1)^(4:ℕ))) + (-20 * (gamma F lam) * (lam 0) * ((lam 1)^(2:ℕ)) * ((lam 2)^(3:ℕ))) + (-12 * (gamma F lam) * (lam 0) * (lam 1) * ((lam 2)^(4:ℕ))) + (-12