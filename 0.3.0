    linear_combination (((-2 * ((lam 1)^(5:ℕ))) + (2 * ((lam 0)^(5:ℕ))) + (-20 * ((lam 0)^(2:ℕ)) * ((lam 1)^(3:ℕ))) + (-10 * (lam 1) * ((lam 0)^(4:ℕ))) + (10 * (lam 0) * ((lam 1)^(4:ℕ))) + (20 * ((lam 0)^(3:ℕ)) * ((lam 1)^(2:ℕ))))) * t + ((((lam 0)^(3:ℕ)) + (-1 * ((lam 1)^(3:ℕ))) + (-3 * (lam 1) * ((lam 0)^(2:ℕ))) + (3 * (lam 0) * ((lam 1)^(2:ℕ))))) * d20al + ((((gamma F lam) * ((lam 1)^(5:ℕ))) + ((gamma F lam) * ((lam 0)^(3:ℕ)) * ((lam 1)^(2:ℕ))) + (-7 * (gamma F lam) * ((lam 0)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (-5 * (gamma F lam) * (lam 0) * ((lam 1)^(4:ℕ))) + (-5 * (gamma F lam) * ((lam 1)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (-2 * (gamma F lam) * (lam 1) * ((lam 0)^(4:ℕ))) + (2 * (gamma F lam) * (lam 2) * ((lam 0)^(4:ℕ))) + (4 * (gamma F lam) * ((lam 0)^(2:ℕ)) * ((lam 2)^(3:ℕ))) + (4 * (gamma F lam) * ((lam 1)^(2:ℕ)) * ((lam 2)^(3:ℕ))) + (5 * (gamma F lam) * ((lam 0)^(2:ℕ)) * ((lam 1)^(3:ℕ))) + (-18 * (gamma F lam) * (lam 2) * ((lam 0)^(2:ℕ)) * ((lam 1)^(2:ℕ))) + (-8 * (gamma F lam) * (lam 0) * (lam 1) * ((lam 2)^(3:ℕ))) + (3 * (gamma F lam) * (lam 0) * ((lam 1)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (6 * (gamma F lam) * (lam 1) * (lam 2) * ((lam 0)^(3:ℕ))) + (9 * (gamma F lam) * (lam 1) * ((lam 0)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (10 * (gamma F lam) * (lam 0) * (lam 2) * ((lam 1)^(3:ℕ))))) * H.fs0al + (((2 * (eta F lam) * ((lam 0)^(5:ℕ))) + (-6 * (eta F lam) * (lam 1) * ((lam 0)^(4:ℕ))) + (-4 * (eta F lam) * (lam 2) * ((lam 0)^(4:ℕ))) + (-2 * (eta F lam) * ((lam 0)^(2:ℕ)) * ((lam 1)^(3:ℕ))) + (-2 * (eta F lam) * ((lam 1)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (2 * (eta F lam) * ((lam 0)^(3:ℕ)) * ((lam 2)^(2:ℕ))) + (6 * (eta F lam) * ((lam 0)^(3:ℕ)) * ((lam 1)^(2:ℕ))) + (-12 * (eta F lam) * (lam 2) * ((lam 0)^(2:ℕ)) * ((lam 1)^(2:ℕ))) + (-6 * (eta F lam) * (lam 1) * ((lam 0)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (4 * (eta F lam) * (lam 0) * (lam 2) * ((lam 1)^(3:ℕ))) + (6 * (eta F lam) * (lam 0) * ((lam 1)^(2:ℕ)) * ((lam 2)^(2:ℕ))) + (12 * (eta F lam) * (lam 1) * (lam 2) * ((lam 0)^(3:ℕ))))) * H.fs1al
