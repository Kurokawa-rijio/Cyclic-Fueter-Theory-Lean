local instance (priority := high) hmR_SSRows3 : HMul R R R := instHMul
local instance (priority := high) haR_SSRows3 : HAdd R R R := instHAdd
local instance (priority := high) hsR_SSRows3 : HSub R R R := instHSub
local instance (priority := high) hpR_SSRows3 : HPow R ℕ R := instHPow
local instance (priority := high) ngR_SSRows3 : Neg R := inferInstance

