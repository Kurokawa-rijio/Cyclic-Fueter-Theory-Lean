* text=auto
*.lean text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf

name: Lean CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Lean project
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Install Elan
        shell: bash
        run: |
          curl --proto '=https' --tlsv1.2 -sSf \
            https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
            | sh -s -- -y --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"

      - name: Resolve dependencies
        shell: bash
        run: |
          lake --version
          lake update

      - name: Get Mathlib cache
        shell: bash
        run: lake exe cache get

      - name: Build Lean project
        shell: bash
        run: lake build

      - name: Axiom audit (every theorem)
        shell: bash
        run: |
          lake env lean Audit.lean > audit.txt 2>&1
          total=$(grep -c "depends on axioms\|does not depend on any axioms" audit.txt || true)
          sorry=$(grep -c "sorryAx" audit.txt || true)
          std=$(grep -c "depends on axioms: \[propext, Classical.choice, Quot.sound\]" audit.txt || true)
          {
            echo "## Axiom audit"
            echo "- theorems audited: $total"
            echo "- depending only on [propext, Classical.choice, Quot.sound]: $std"
            echo "- using sorryAx: $sorry"
            echo '```'
            grep -v "depends on axioms: \[propext, Classical.choice, Quot.sound\]" audit.txt | head -n 50
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
          test "$sorry" = "0"

      - name: Upload audit output
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: audit
          path: audit.txt

# Lean/Lake build output
.lake/
.build/

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Local environment files / secrets
.env
.env.*
!.env.example

{
  "title": "Cyclic Fueter Theory: Lean 4 Formalization of Selected Results",
  "description": "This software repository contains Lean 4 source files developed in connection with the Cyclic Fueter Theory (CFT) research program. It formalizes selected algebraic and geometric statements involving quaternionic algebra, Fueter-type operators, matrix and spinor constructions, quantum-geometric identities, Cartan-frame calculations, the reduced Einstein–Yang–Mills action and its four-dimensional field equations, distributional junction conditions, characteristic evolution and constraint propagation, zero-mode calculations, and selected Wess–Zumino–Witten (WZW)-related formulas.\n\nVersion 0.3.0 contains 1216 theorem declarations in 118 modules, with no sorry and no project-specific axioms. New in this version: the neck's minisuperspace action with the GHY boundary term, exact Wheeler–DeWitt solutions for two operator orderings and both branches, the physical inner product from affine-group quantisation, the stationary-phase semiclassical limit, the Dirac levels on S³ from the left-invariant frame, the static-S³ no-go with traceless Yang–Mills stress, and the trace-anomaly back-reaction of conformal fields on the closed FRW caps. A correction is recorded: the final theorems that use the RealLine bridge apply only to constant fields, and four items are reclassified as partial. The repository includes an author-maintained status ledger for 53 items grouped into α-I–α-VIII (41 complete including items that use a named external theorem, 7 partial, 2 conditional, 3 not formalized as stated) and 35 items in α-IX (10 complete), 88 items in total. These labels describe the current scope of this formalization; they are not independent certification or peer review of the corresponding research claims. Lean verifies each theorem from its declared assumptions and imported results. Formalization does not by itself establish that a physical model, external theorem, or interpretation is appropriate.\n\nThe project targets Lean 4.15.0 and Mathlib v4.15.0. To reproduce the build, install Elan and run `lake update`, `lake exe cache get`, and `lake build` from the repository root.",
  "creators": [
    {
      "name": "Kurokawa, Ryojiro"
    }
  ],
  "keywords": [
    "Lean 4",
    "Mathlib",
    "formalization",
    "formal verification",
    "interactive theorem proving",
    "quaternionic analysis",
    "Fueter equations",
    "Clifford algebra",
    "differential geometry",
    "mathematical physics",
    "Einstein–Yang–Mills theory",
    "constraint propagation",
    "Wess–Zumino–Witten model"
  ],
  "upload_type": "software",
  "language": "eng",
  "version": "0.3.0",
  "license": "MIT"
}

