/- α-II.5:2 段目の捩れの式が C2 枠で成り立つこと(row4、row5) -/
import CFT.Cartan.SSFirst
import CFT.Cartan.SSJet

namespace CFT.Cartan

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {R : Type*} [CommRing R] [Algebra ℚ R]

/-- 大きな多項式の elaborate を速くするための局所インスタンス(標準のものと定義上同じ) -/
local instance (priority := high) hmR_SSRows1b : HMul R R R := instHMul
local instance (priority := high) haR_SSRows1b : HAdd R R R := instHAdd
local instance (priority := high) hsR_SSRows1b : HSub R R R := instHSub
local instance (priority := high) hpR_SSRows1b : HPow R ℕ R := instHPow
local instance (priority := high) ngR_SSRows1b : Neg R := inferInstance

namespace C2

variable {F : Frame R} {lam : Fin 3 → R} (H : C2 F lam)
include H

theorem row4 : n4 (lam 0) (lam 1) (lam 2) (alpha F lam) (beta F lam) (gamma F lam) (eta F lam) (F.e 2 (alpha F lam)) (F.e 2 (beta F lam)) (F.e 2 (gamma F lam)) (F.e 2 (eta F lam)) (F.e 0 (F.e 2 (alpha F lam))) (F.e 0 (F.e 2 (beta F lam))) (F.e 0 (F.e 2 (gamma F lam))) (F.e 0 (F.e 2 (eta F lam))) (F.e 1 (F.e 2 (alpha F lam))) (F.e 1 (F.e 2 (beta F lam))) (F.e 1 (F.e 2 (gamma F lam))) (F.e 1 (F.e 2 (eta F lam))) (F.e 2 (F.e 2 (alpha F lam))) (F.e 2 (F.e 2 (beta F lam))) (F.e 2 (F.e 2 (gamma F lam))) (F.e 2 (F.e 2 (eta F lam))) = 0 := by
  have t := F.torsion 0 2 (beta F lam)
  simp only [Fin.sum_univ_three] at t
