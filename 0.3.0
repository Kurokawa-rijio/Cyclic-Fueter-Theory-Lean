/- α-II.5:2 段目の捩れの式が C2 枠で成り立つこと(row0〜row2) -/
import CFT.Cartan.SSFirst
import CFT.Cartan.SSJet

namespace CFT.Cartan

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {R : Type*} [CommRing R] [Algebra ℚ R]

/-- 大きな多項式の elaborate を速くするための局所インスタンス(標準のものと定義上同じ) -/
local instance (priority := high) hmR_SSRows0 : HMul R R R := instHMul
local instance (priority := high) haR_SSRows0 : HAdd R R R := instHAdd
local instance (priority := high) hsR_SSRows0 : HSub R R R := instHSub
local instance (priority := high) hpR_SSRows0 : HPow R ℕ R := instHPow
local instance (priority := high) ngR_SSRows0 : Neg R := inferInstance

namespace C2

