# Generator scripts

These SymPy scripts generated the large component identities in the Lean sources and the `linear_combination` certificates used in their proofs. They are provided for transparency; the Lean files are self-contained and building the project does not need them.

- `S1/` — scalar curvature and GHY boundary term of the spherical reduction, YM field-strength formulas (stage 1).
- `S2/` — reduced action, first variation, and the match with the reduced field equations (stage 2, `AlphaS2_Action`, `AlphaS2_Match`).
- `S4/` — Christoffel symbols, Ricci, Einstein, Riemann and Kretschmann tensors, YM stress tensor and YM equations for the diagonal and double-null spherical metrics, and the 16 + 12 component four-dimensional match (`AlphaS4_Curv`, `AlphaS5_Curvature`, `AlphaS2_4DMatch`).
- `gen_audit.py` — regenerates `Audit.lean` and `CFT.lean` from the module list.

The scripts were written for the author's working directory layout (paths under `/home/claude/lean`), and the certificate files (`*.pkl`) they write are not included; adjust the paths before rerunning. Python 3 with SymPy is required.

import sympy as sp
from sympy.algebras.quaternion import Quaternion as Q
one,i,j,k=Q(1,0,0,0),Q(0,1,0,0),Q(0,0,1,0),Q(0,0,0,1)
e=[one,i,j,k]
def real_rank(rows):
    # right-module real 16x16: map y -> sum_a C_ra y_a
    import itertools
    M=[]
    ys=sp.symbols('y0:16')
    yq=[Q(*ys[4*a:4*a+4]) for a in range(4)]
    out=[]
    for r in rows:
        s=Q(0,0,0,0)
        for a in range(4): s=s+r[a]*yq[a]
        out+= [s.a,s.b,s.c,s.d]
    J=sp.Matrix([[sp.diff(o,y) for y in ys] for o in out])
    return J.rank()
Z4=[[e[(m+a)%4] for a in range(4)] for m in range(4)]
V4perm=[[0,1,2,3],[1,0,3,2],[2,3,0,1],[3,2,1,0]]
V4=[[e[p[a]] for a in range(4)] for p in V4perm]
print("Z4 real rank",real_rank(Z4),"V4 real rank",real_rank(V4))

import sympy as sp
t,x,th,ph=sp.symbols('t x theta phi')
N=sp.Function('N')(t,x);A=sp.Function('A')(t,x);R=sp.Function('R')(t,x)
g=sp.diag(-N**2,A**2,R**2,R**2*sp.sin(th)**2); X=[t,x,th,ph]; gi=g.inv()
Gam=[[[sum(gi[a,d]*(sp.diff(g[d,b],X[c])+sp.diff(g[d,c],X[b])-sp.diff(g[b,c],X[d])) for d in range(4))/2 for c in range(4)] for b in range(4)] for a in range(4)]
def Ric(b,c):
    return sp.simplify(sum(sp.diff(Gam[a][b][c],X[a])-sp.diff(Gam[a][b][a],X[c])+sum(Gam[a][a][d]*Gam[d][b][c]-Gam[a][c][d]*Gam[d][b][a] for d in range(4)) for a in range(4)))
Rs=sp.simplify(sum(gi[b,b]*Ric(b,b) for b in range(4)))
L=sp.simplify(N*A*R**2*Rs)   # sqrt(-g)/sin
print("L =",sp.expand(L))
# guess: P_t = 2*(Adot R^2 + 2 A R Rdot)/N ; P_x = -2*(N' R^2 + 2 N R R')/A
Pt=2*(sp.diff(A,t)*R**2+2*A*R*sp.diff(R,t))/N
Px=-2*(sp.diff(N,x)*R**2+2*N*R*sp.diff(R,x))/A
L1=sp.expand(sp.simplify(L-sp.diff(Pt,t)-sp.diff(Px,x)))
print("L1 =",L1)
print("second derivs in L1:",[d for d in L1.atoms(sp.Derivative) if sum(c for _,c in d.variable_count)>=2])

import sympy as sp, pickle
t,x,th,ph=sp.symbols('t x theta phi')
F=lambda n: sp.Function(n)(t,x)
N,A,R,b=F('N'),F('A'),F('R'),F('b')
X=[t,x,th,ph]
g=sp.zeros(4); g[0,0]=-N**2+A**2*b**2; g[0,1]=g[1,0]=A**2*b; g[1,1]=A**2; g[2,2]=R**2; g[3,3]=R**2*sp.sin(th)**2
gi=sp.simplify(g.inv())
Gam=[[[sp.simplify(sum(gi[a,d]*(sp.diff(g[d,bb],X[c])+sp.diff(g[d,c],X[bb])-sp.diff(g[bb,c],X[d])) for d in range(4))/2) for c in range(4)] for bb in range(4)] for a in range(4)]
def Ric(bb,c):
    return sum(sp.diff(Gam[a][bb][c],X[a])-sp.diff(Gam[a][bb][a],X[c])+sum(Gam[a][a][d]*Gam[d][bb][c]-Gam[a][c][d]*Gam[d][bb][a] for d in range(4)) for a in range(4))
Rs=sum(gi[i,j]*Ric(i,j) for i in range(4) for j in range(4) if gi[i,j]!=0)
L=sp.simplify(sp.expand(N*A*R**2*Rs))
dt=lambda f: sp.diff(f,t); dx=lambda f: sp.diff(f,x)
K=(dt(A)-dx(A*b))/(N*A)+2*(dt(R)-b*dx(R))/(N*R)
Pt=2*A*R**2*K
Px0=-2*(dx(N)*R**2+2*N*R*dx(R))/A
for name,Px in [("Px0",Px0),("Px0 - b*Pt",Px0-b*Pt)]:
    L1=sp.expand(sp.simplify(L-dt(Pt)-dx(Px)))
    sec=[d for d in L1.atoms(sp.Derivative) if sum(c for _,c in d.variable_count)>=2]
    print(name,"second derivs:",sec)
    if not sec:
        print("L1 =",L1); pickle.dump((L,Pt,Px,L1),open('shiftL.pkl','wb'))

import sympy as sp
# toy check with abstract functions in 2 coords: mu,nu in {0,1}
t,x=sp.symbols('t x'); X=[t,x]
A=[[sp.Function(f'A{a}{m}')(t,x) for m in range(2)] for a in range(3)]
ep=[sp.Function(f'e{a}')(t,x) for a in range(3)]
f=lambda a,b,c: sp.LeviCivita(a,b,c)
c=sp.Symbol('c')
def F(Ax,a,m,n): return sp.diff(Ax[a][n],X[m])-sp.diff(Ax[a][m],X[n])+c*sum(f(a,b,cc)*Ax[b][m]*Ax[cc][n] for b in range(3) for cc in range(3))
s=sp.Symbol('s')
Ad=[[A[a][m]+s*(sp.diff(ep[a],X[m])+sum(f(a,b,cc)*A[b][m]*ep[cc] for b in range(3) for cc in range(3))) for m in range(2)] for a in range(3)]
dF=sp.diff(F(Ad,0,0,1),s).subs(s,0)
target=sum(f(0,b,cc)*F(A,b,0,1)*ep[cc] for b in range(3) for cc in range(3))
print(sp.factor(sp.expand(dF-target)))

def Lag : S := (-2) * A * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * A * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + (-2) * A * N * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * A * N + (-4) * A * R * (dx R) * b * (dx b) * N⁻¹ + 4 * A * R * (dt R) * (dx b) * N⁻¹ + (-2) * A * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹ + 4 * A * (dx R) * (dt R) * b * N⁻¹ + (-2) * A * (dt R)^(2:ℕ) * N⁻¹ + 4 * A * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 4 * A * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * (dx R) * b^(2:ℕ) * N⁻¹ + 4 * (dx A) * R * (dt R) * b * N⁻¹ + 4 * (dt A) * R * (dx R) * b * N⁻¹ + (-4) * (dt A) * R * (dt R) * N⁻¹ + 2 * N * (dx R)^(2:ℕ) * A⁻¹ + (-4) * N * (dx W)^(2:ℕ) * A⁻¹ * l^(2:ℕ) + 4 * (dx N) * R * (dx R) * A⁻¹

def EN : S := 4 * A * R * (dx R) * b * (dx b) * N⁻¹^(2:ℕ) + (-4) * A * R * (dt R) * (dx b) * N⁻¹^(2:ℕ) + 2 * A * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * A * (dx R) * (dt R) * b * N⁻¹^(2:ℕ) + 2 * A * (dt R)^(2:ℕ) * N⁻¹^(2:ℕ) + (-2) * A * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * A * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + (-4) * A * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + 8 * A * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * A * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-2) * A * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * A + 4 * (dx A) * R * (dx R) * A⁻¹^(2:ℕ) + 4 * (dx A) * R * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + (-4) * (dx A) * R * (dt R) * b * N⁻¹^(2:ℕ) + (-4) * (dt A) * R * (dx R) * b * N⁻¹^(2:ℕ) + 4 * (dt A) * R * (dt R) * N⁻¹^(2:ℕ) + (-4) * R * (dx (dx R)) * A⁻¹ + (-2) * (dx R)^(2:ℕ) * A⁻¹ + (-4) * (dx W)^(2:ℕ) * A⁻¹ * l^(2:ℕ)

def EA : S := (-2) * N * (dx R)^(2:ℕ) * A⁻¹^(2:ℕ) + (-2) * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 4 * N * (dx W)^(2:ℕ) * A⁻¹^(2:ℕ) * l^(2:ℕ) + (-2) * N * l^(2:ℕ) * R⁻¹^(2:ℕ) + 2 * N + (-4) * (dx N) * R * (dx R) * A⁻¹^(2:ℕ) + (-4) * (dx N) * R * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * (dx N) * R * (dt R) * b * N⁻¹^(2:ℕ) + 4 * (dt N) * R * (dx R) * b * N⁻¹^(2:ℕ) + (-4) * (dt N) * R * (dt R) * N⁻¹^(2:ℕ) + 4 * R * (dx R) * b * (dx b) * N⁻¹ + (-4) * R * (dx R) * (dt b) * N⁻¹ + 4 * R * (dx (dx R)) * b^(2:ℕ) * N⁻¹ + (-8) * R * (dx (dt R)) * b * N⁻¹ + 4 * R * (dt (dt R)) * N⁻¹ + 2 * (dx R)^(2:ℕ) * b^(2:ℕ) * N⁻¹ + (-4) * (dx R) * (dt R) * b * N⁻¹ + 2 * (dt R)^(2:ℕ) * N⁻¹ + 4 * (dx W)^(2:ℕ) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + (-8) * (dx W) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 4 * (dt W)^(2:ℕ) * l^(2:ℕ) * N⁻¹

def ER : S := 4 * A * N * W^(4:ℕ) * l^(2:ℕ) * R⁻¹^(3:ℕ) + (-8) * A * N * W^(2:ℕ) * l^(2:ℕ) * R⁻¹^(3:ℕ) + 4 * A * N * l^(2:ℕ) * R⁻¹^(3:ℕ) + (-4) * A * (dx N) * R * b * (dx b) * N⁻¹^(2:ℕ) + (-4) * A * (dx N) * (dx R) * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * A * (dx N) * (dt R) * b * N⁻¹^(2:ℕ) + 4 * A * (dt N) * R * (dx b) * N⁻¹^(2:ℕ) + 4 * A * (dt N) * (dx R) * b * N⁻¹^(2:ℕ) + (-4) * A * (dt N) * (dt R) * N⁻¹^(2:ℕ) + 4 * A * R * b * (dx (dx b)) * N⁻¹ + 4 * A * R * (dx b)^(2:ℕ) * N⁻¹ + (-4) * A * R * (dx (dt b)) * N⁻¹ + 8 * A * (dx R) * b * (dx b) * N⁻¹ + (-4) * A * (dx R) * (dt b) * N⁻¹ + 4 * A * (dx (dx R)) * b^(2:ℕ) * N⁻¹ + (-4) * A * (dt R) * (dx b) * N⁻¹ + (-8) * A * (dx (dt R)) * b * N⁻¹ + 4 * A * (dt (dt R)) * N⁻¹ + 4 * (dx A) * N * (dx R) * A⁻¹^(2:ℕ) + 4 * (dx A) * (dx N) * R * A⁻¹^(2:ℕ) + (-4) * (dx A) * (dx N) * R * b^(2:ℕ) * N⁻¹^(2:ℕ) + 4 * (dx A) * (dt N) * R * b * N⁻¹^(2:ℕ) + 12 * (dx A) * R * b * (dx b) * N⁻¹ + (-4) * (dx A) * R * (dt b) * N⁻¹ + 4 * (dx A) * (dx R) * b^(2:ℕ) * N⁻¹ + (-4) * (dx A) * (dt R) * b * N⁻¹ + 4 * (dx (dx A)) * R * b^(2:ℕ) * N⁻¹ + 4 * (dt A) * (dx N) * R * b * N⁻¹^(2:ℕ) + (-4) * (dt A) * (dt N) * R * N⁻¹^(2:ℕ) + (-8) * (dt A) * R * (dx b) * N⁻¹ + (-4) * (dt A) * (dx R) * b * N⁻¹ + 4 * (dt A) * (dt R) * N⁻¹ + (-8) * (dx (dt A)) * R * b * N⁻¹ + 4 * (dt (dt A)) * R * N⁻¹ + (-4) * N * (dx (dx R)) * A⁻¹ + (-4) * (dx N) * (dx R) * A⁻¹ + (-4) * (dx (dx N)) * R * A⁻¹

def Eb : S := (-4) * A * (dx N) * R * (dx R) * b * N⁻¹^(2:ℕ) + 4 * A * (dx N) * R * (dt R) * N⁻¹^(2:ℕ) + 4 * A * R * (dx (dx R)) * b * N⁻¹ + (-4) * A * R * (dx (dt R)) * N⁻¹ + 8 * A * (dx W)^(2:ℕ) * b * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx W) * (dt W) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * (dx R) * b * N⁻¹ + 4 * (dt A) * R * (dx R) * N⁻¹

def EW : S := (-8) * A * N * W^(3:ℕ) * l^(2:ℕ) * R⁻¹^(2:ℕ) + 8 * A * N * W * l^(2:ℕ) * R⁻¹^(2:ℕ) + 8 * A * (dx N) * (dx W) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-8) * A * (dx N) * (dt W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-8) * A * (dt N) * (dx W) * b * l^(2:ℕ) * N⁻¹^(2:ℕ) + 8 * A * (dt N) * (dt W) * l^(2:ℕ) * N⁻¹^(2:ℕ) + (-16) * A * (dx W) * b * (dx b) * l^(2:ℕ) * N⁻¹ + 8 * A * (dx W) * (dt b) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dx (dx W)) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + 8 * A * (dt W) * (dx b) * l^(2:ℕ) * N⁻¹ + 16 * A * (dx (dt W)) * b * l^(2:ℕ) * N⁻¹ + (-8) * A * (dt (dt W)) * l^(2:ℕ) * N⁻¹ + (-8) * (dx A) * N * (dx W) * A⁻¹^(2:ℕ) * l^(2:ℕ) + (-8) * (dx A) * (dx W) * b^(2:ℕ) * l^(2:ℕ) * N⁻¹ + 8 * (dx A) * (dt W) * b * l^(2:ℕ) * N⁻¹ + 8 * (dt A) * (dx W) * b * l^(2:ℕ) * N⁻¹ + (-8) * (dt A) * (dt W) * l^(2:ℕ) * N⁻¹ + 8 * N * (dx (dx W)) * A⁻¹ * l^(2:ℕ) + 8 * (dx N) * (dx W) * A⁻¹ * l^(2:ℕ)

def Tht : S := 4 * A * R * (dx b) * (δ R) * N⁻¹ + 4 * A * (dx R) * b * (δ R) * N⁻¹ + (-4) * A * (dt R) * (δ R) * N⁻¹ + (-8) * A * (dx W) * b * (δ W) * l^(2:ℕ) * N⁻¹ + 8 * A * (dt W) * (δ W) * l^(2:ℕ) * N⁻¹ + 4 * (dx A) * R * b * (δ R) * N⁻¹ + (-4) * (dt A) * R * (δ R) * N⁻¹ + 4 * R * (dx R) * b * (δ A) * N⁻¹ + (-4) * R * (dt R) * (δ A) * N⁻¹

def Thx : S := (-4) * A * R * (dx R) * b * (δ b) * N⁻¹ + 4 * A * R * (dt R) * (δ b) * N⁻¹ + (-4) * A * R * b * (dx b) * (δ R) * N⁻¹ + (-4) * A * (dx R) * b^(2:ℕ) * (δ R) * N⁻¹ + 4 * A * (dt R) * b * (δ R) * N⁻¹ + 8 * A * (dx W) * b^(2:ℕ) * (δ W) * l^(2:ℕ) * N⁻¹ + (-8) * A * (dt W) * b * (δ W) * l^(2:ℕ) * N⁻¹ + (-4) * (dx A) * R * b^(2:ℕ) * (δ R) * N⁻¹ + 4 * (dt A) * R * b * (δ R) * N⁻¹ + 4 * N * (dx R) * A⁻¹ * (δ R) + (-8) * N * (dx W) * A⁻¹ * (δ W) * l^(2:ℕ) + 4 * (dx N) * R * A⁻¹ * (δ R) + 4 * R * (dx R) * A⁻¹ * (δ N) + (-4) * R * (dx R) * b^(2:ℕ) * (δ A) * N⁻¹ + 4 * R * (dt R) * b * (δ A) * N⁻¹

import sympy as sp, itertools
l=sp.Symbol('l')
fields=['N','A','R','b','W']
inv={'N':'n','A':'a','R':'r'}
J={}
def jet(f,i,j):
    k=(f,i,j)
    if k not in J: J[k]=sp.Symbol(f'{f}_{i}{j}')
    return J[k]
dJ={}
def djet(f,i,j):
    k=(f,i,j)
    if k not in dJ: dJ[k]=sp.Symbol(f'd{f}_{i}{j}')
    return dJ[k]
IV={f:sp.Symbol(s) for f,s in inv.items()}
def parse(s):
    nm=str(s)
    if nm in inv.values():
        return ('inv',[f for f,v in inv.items() if v==nm][0])
    if nm.startswith('d') and nm[1] in 'NARbW' and '_' in nm:
        return ('var',nm[1],int(nm[-2]),int(nm[-1]))
    if '_' in nm: return ('jet',nm[0],int(nm[-2]),int(nm[-1]))
    return ('const',)
def D(e,which):  # which: 't','x','d' (variation)
    e=sp.expand(e); res=0
    for s in e.free_symbols:
        p=parse(s); de=sp.diff(e,s)
        if p[0]=='const': continue
        if p[0]=='inv':
            f=p[1]; ds=-IV[f]**2*D(jet(f,0,0),which)
        elif p[0]=='jet':
            _,f,i,j=p
            ds = jet(f,i+1,j) if which=='t' else jet(f,i,j+1) if which=='x' else djet(f,i,j)
        else:
            _,f,i,j=p
            if which=='d': raise Exception
            ds = djet(f,i+1,j) if which=='t' else djet(f,i,j+1)
        res+=de*ds
    return sp.expand(res)
N,A,R,b,W=[jet(f,0,0) for f in fields]
n,a,r=IV['N'],IV['A'],IV['R']
Dt=lambda e: D(e,'t'); Dx=lambda e: D(e,'x')
u=Dt(R)-b*Dx(R); v=Dt(A)-Dx(A*b); w=Dt(W)-b*Dx(W)
L1=2*A*N+(2*N*Dx(R)**2+4*R*Dx(N)*Dx(R))*a-2*A*u**2*n-4*R*v*u*n
LYM=-4*l**2*(N*Dx(W)**2*a-A*w**2*n+N*A*(1-W**2)**2*r**2/2)
Lag=sp.expand(L1+LYM)
def pd(e,s):  # partial with chain rule through inverses
    out=sp.diff(e,s)
    for f,iv in IV.items():
        if s==jet(f,0,0): out+= sp.diff(e,iv)*(-iv**2)
    return sp.expand(out)
E={};Tt=0;Tx=0
for f in fields:
    s0,st,sx=jet(f,0,0),jet(f,1,0),jet(f,0,1)
    E[f]=sp.expand(pd(Lag,s0)-Dt(pd(Lag,st))-Dx(pd(Lag,sx)))
    Tt+=djet(f,0,0)*pd(Lag,st); Tx+=djet(f,0,0)*pd(Lag,sx)
Tt=sp.expand(Tt); Tx=sp.expand(Tx)
check=sp.expand(D(Lag,'d')-sum(djet(f,0,0)*E[f] for f in fields)-Dt(Tt)-Dx(Tx))
print("formal identity residual:",check)
def lean(e):
    def atom(s):
        p=parse(s)
        if p[0]=='inv': return f'{p[1]}⁻¹'
        if p[0]=='const': return 'l'
        if p[0]=='jet':
            _,f,i,j=p; t=f
            for _ in range(i): t=f'dt ({t})' if ' ' in t else f'dt {t}'
            for _ in range(j): t=f'dx ({t})' if ' ' in t else f'dx {t}'
            return t
        _,f,i,j=p; t=f'δ {f}'
        for _ in range(i): t=f'dt ({t})'
        for _ in range(j): t=f'dx ({t})'
        return t
    e=sp.expand(e)
    terms=[]
    for mon,c in sp.Poly(e,*sorted(e.free_symbols,key=str)).terms():
        gens=sorted(e.free_symbols,key=str)
        fac=[]
        for g,p in zip(gens,mon):
            if p==0: continue
            at=atom(g); at=f'({at})' if ' ' in at else at
            fac.append(at if p==1 else f'{at}^({p}:ℕ)')
        cs = f'({c})' if c<0 or not c.is_Integer else str(c)
        if c.is_Rational and not c.is_Integer: cs=f'({c.p}/{c.q} : S)'
        terms.append(' * '.join([cs]+fac) if fac else cs)
    return ' + '.join(terms) if terms else '0'
import pickle
pickle.dump((Lag,E,Tt,Tx),open('stage2.pkl','wb'))
out=open('defs.lean','w')
out.write(f"def Lag : S := {lean(Lag)}\n\n")
for f in fields: out.write(f"def E{f} : S := {lean(E[f])}\n\n")
out.write(f"def Tht : S := {lean(Tt)}\n\ndef Thx : S := {lean(Tx)}\n")
out.close()
print({f:len(E[f].args) for f in fields}, len(Tt.args), len(Tx.args))

import sympy as sp, pickle
exec(open('gen.py').read().split("import pickle")[0].replace('print("formal identity residual:",check)',''))
certs=pickle.load(open('certs.pkl','rb'))
def leanC(e):
    s=lean(e)
    return s.replace('A⁻¹','a').replace('R⁻¹','r').replace('N⁻¹','1')
P='CFT.Propagation'
args="dx A R (-(dt A * A⁻¹)) (-(dt R * R⁻¹)) W (A * dt W) (2 * l ^ 2)"
Hs=f"{P}.Hc {args}"; Ms=f"{P}.Mc {args}"
DxR=f"{P}.Dx dx A R"; DDR=f"{P}.Dx dx A ({DxR})"; DxW=f"{P}.Dx dx A W"
Kx="(-(dt A * A⁻¹))"; KT="(-(dt R * R⁻¹))"; Pp="(A * dt W)"; k="(2 * l ^ 2)"
eP=f"(dt {Pp} - (dx (dx W * A⁻¹) + A * W * (1 - W ^ 2) * R⁻¹ ^ 2))"
eKx=f"(dt {Kx} - (-2 * ({DDR}) * R⁻¹ + ({Kx} + 2 * {KT}) * {Kx} - {k} * ((({Pp} * A⁻¹) ^ 2 + ({DxW}) ^ 2) * R⁻¹ ^ 2 - (1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 * 2⁻¹)))"
eKT=f"(dt {KT} - ((1 - ({DxR}) ^ 2 - R * ({DDR})) * R⁻¹ ^ 2 + ({Kx} + 2 * {KT}) * {KT} - {k} * ((1 - W ^ 2) ^ 2 * R⁻¹ ^ 4 * 2⁻¹)))"
H_='Hα dt dx A R W l'; M_='Mα dt dx A R W l'; eP_='ePα dt dx A R W l'; eKx_='eKxα dt dx A R W l'; eKT_='eKTα dt dx A R W l'
rhs={'N':f"A * R ^ 2 * {H_}",'b':f"-2 * A ^ 2 * R ^ 2 * {M_}",'W':f"-8 * l ^ 2 * {eP_}",
     'A':f"-4 * R ^ 2 * {eKT_} - R ^ 2 * {H_}",'R':f"-4 * A * R * ({eKx_} + {eKT_}) - 2 * A * R * {H_}"}
sig='(dt dx : Derivation ℤ S S) (A R W l : S) : S'
defs=f'''
/-- α の拘束と発展方程式(同期ゲージ、K_x = −∂_tA/A、K_T = −∂_tR/R、P = A∂_tW、κ = 2ℓ²) -/
def Hα {sig} := {Hs}
def Mα {sig} := {Ms}
def ePα {sig} := {eP}
def eKxα {sig} := {eKx}
def eKTα {sig} := {eKT}
'''
hdr='''/-
  段階 2(その 2):同期ゲージ N = 1、β = 0 で、作用の Euler–Lagrange の式は α の方程式の一次結合
    E_N = A R² · H(ハミルトン拘束、AlphaIV_Propagation の Hc)
    E_β = −2A²R² · M(運動量拘束、Mc)
    E_W = −8ℓ² ·(YM の発展方程式 ∂_t P = ∂_x(∂_xW/A) + AW(1 − W²)/R²、P = A∂_tW)
    E_A = −4R² ·(K_T の発展方程式) − R² · H
    E_R = −4AR ·(K_x の発展方程式 + K_T の発展方程式) − 2AR · H
  ここで K_x = −∂_tA/A、K_T = −∂_tR/R、P = A∂_tW、κ = 2ℓ²(拘束の伝播 AlphaIV_Propagation の変数)。
  * el_iff_alpha:A, R, ℓ ≠ 0 なら、五つの EL の式がすべて 0 ⇔ α の五つの方程式(H = M = 0 と三つの発展方程式)。
  したがって α で入力としてきた場の方程式は、段階 1 で導いた作用の帰結である(仮定ではない)。
  証明:aux/S2/match.py が A·A⁻¹ = 1、R·R⁻¹ = 1 に関する一次結合の係数を出し、linear_combination で閉じる。
-/
import CFT.AlphaS2_Action

namespace CFT.S2

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {S : Type*} [Field S] [CharZero S]
'''
body=defs
names={'N':'EN','b':'Eb','W':'EW','A':'EA','R':'ER'}
for f in ['N','b','W','A','R']:
    Q=certs[f]
    lc=' + '.join(f'({leanC(q)}) * {h}' for q,h in zip(Q,['ha','hb'])) if Q else '0'
    body+=f'''
theorem match_{f} (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    {names[f]} dt dx 1 A R 0 W l = {rhs[f]} := by
  have ha : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
  have hb : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
  have i2t : dt (2⁻¹ : S) = 0 := by rw [{P}.deriv_inv _ _ two_ne_zero, {P}.deriv_ofNat dt 2]; ring
  have i2x : dx (2⁻¹ : S) = 0 := by rw [{P}.deriv_inv _ _ two_ne_zero, {P}.deriv_ofNat dx 2]; ring
  simp only [{names[f]}, Hα, Mα, ePα, eKxα, eKTα, {P}.Hc, {P}.Mc, {P}.Dx, map_add, map_sub, map_neg, map_zero, inv_one,
    Derivation.map_one_eq_zero, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul,
    {P}.deriv_inv _ _ hA, {P}.deriv_inv _ _ hR, {P}.deriv_ofNat dt 2, {P}.deriv_ofNat dx 2,
    {P}.deriv_ofNat dt 4, {P}.deriv_ofNat dx 4, {P}.deriv_ofNat dt 8, {P}.deriv_ofNat dx 8,
    hc, hlt, hlx, i2t, i2x, nsmul_eq_mul, Nat.cast_ofNat, mul_zero, zero_mul, add_zero, sub_zero, mul_one, one_mul]
  generalize A⁻¹ = a at ha ⊢
  generalize R⁻¹ = r at hb ⊢
  linear_combination {lc}
'''
final='''
/-- 抽象的な形:五つの一次の関係と A, R, ℓ ≠ 0 から、EL の式がすべて 0 ⇔ α の方程式がすべて成り立つ -/
theorem el_iff_abstract (A R l EN Eb EW EA ER H M eP eKx eKT : S) (hA : A ≠ 0) (hR : R ≠ 0) (hl : l ≠ 0)
    (h1 : EN = A * R ^ 2 * H) (h2 : Eb = -2 * A ^ 2 * R ^ 2 * M) (h3 : EW = -8 * l ^ 2 * eP)
    (h4 : EA = -4 * R ^ 2 * eKT - R ^ 2 * H) (h5 : ER = -4 * A * R * (eKx + eKT) - 2 * A * R * H) :
    (EN = 0 ∧ Eb = 0 ∧ EW = 0 ∧ EA = 0 ∧ ER = 0) ↔ (H = 0 ∧ M = 0 ∧ eP = 0 ∧ eKx = 0 ∧ eKT = 0) := by
  have hR2 : R ^ 2 ≠ 0 := pow_ne_zero 2 hR
  have hl2 : l ^ 2 ≠ 0 := pow_ne_zero 2 hl
  constructor
  · rintro ⟨e1, e2, e3, e4, e5⟩
    have hH : H = 0 := by
      rw [h1] at e1; rcases mul_eq_zero.mp e1 with h | h
      · exact absurd h (mul_ne_zero hA hR2)
      · exact h
    have hM : M = 0 := by
      rw [h2] at e2; rcases mul_eq_zero.mp e2 with h | h
      · exact absurd h (by simp [hA, hR])
      · exact h
    have hP : eP = 0 := by
      rw [h3] at e3; rcases mul_eq_zero.mp e3 with h | h
      · exact absurd h (by simp [hl])
      · exact h
    have hT : eKT = 0 := by
      rw [h4, hH] at e4
      have : R ^ 2 * eKT = 0 := by linear_combination (-1/4 : S) * e4
      exact (mul_eq_zero.mp this).resolve_left hR2
    have hX : eKx = 0 := by
      rw [h5, hH, hT] at e5
      have : (A * R) * eKx = 0 := by linear_combination (-1/4 : S) * e5
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hA hR)
    exact ⟨hH, hM, hP, hX, hT⟩
  · rintro ⟨hH, hM, hP, hX, hT⟩
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [h1, hH, mul_zero]
    · rw [h2, hM, mul_zero]
    · rw [h3, hP, mul_zero]
    · rw [h4, hT, hH]; ring
    · rw [h5, hX, hT, hH]; ring

/-- 段階 2 の結論:縮約した作用の Euler–Lagrange 方程式 ⇔ α の場の方程式(同期ゲージ) -/
theorem el_iff_alpha (dt dx : Derivation ℤ S S) (A R W l : S) (hA : A ≠ 0) (hR : R ≠ 0) (hl : l ≠ 0)
    (hc : ∀ f, dt (dx f) = dx (dt f)) (hlt : dt l = 0) (hlx : dx l = 0) :
    (EN dt dx 1 A R 0 W l = 0 ∧ Eb dt dx 1 A R 0 W l = 0 ∧ EW dt dx 1 A R 0 W l = 0 ∧
      EA dt dx 1 A R 0 W l = 0 ∧ ER dt dx 1 A R 0 W l = 0) ↔
    (Hα dt dx A R W l = 0 ∧ Mα dt dx A R W l = 0 ∧ ePα dt dx A R W l = 0 ∧
      eKxα dt dx A R W l = 0 ∧ eKTα dt dx A R W l = 0) :=
  el_iff_abstract A R l _ _ _ _ _ _ _ _ _ _ hA hR hl
    (match_N dt dx A R W l hA hR hc hlt hlx) (match_b dt dx A R W l hA hR hc hlt hlx)
    (match_W dt dx A R W l hA hR hc hlt hlx) (match_A dt dx A R W l hA hR hc hlt hlx)
    (match_R dt dx A R W l hA hR hc hlt hlx)
'''
open('/home/claude/lean/CFT/CFT/AlphaS2_Match.lean','w').write(hdr+body+final+'\nend CFT.S2\n')
print("ok")

import sympy as sp, pickle, re
exec(open('gen.py').read().split("import pickle")[0].replace('print("formal identity residual:",check)',''))
# gauge: N=1, b=0
gsub={}
for (f,i,j),s in list(J.items()):
    if f=='N': gsub[s]= 1 if (i,j)==(0,0) else 0
    if f=='b': gsub[s]=0
gsub[n]=1
Eg={f:sp.expand(E[f].subs(gsub)) for f in fields}
# alpha side
Dxx=lambda e: sp.expand(a*Dx(e))
Kx=-Dt(A)*a; KT=-Dt(R)*r; P=A*Dt(W); k=2*l**2; h=sp.Rational(1,2)
DR=Dxx(R); DDR=Dxx(DR)
H=-2*DDR*r+2*(1-DR**2-R*DDR)*r**2+4*Kx*KT+2*KT**2-2*k*(((P*a)**2+Dxx(W)**2)*r**2+(1-W**2)**2*r**4*h)
M=2*(DR*r)*(Kx-KT)-2*Dxx(KT)-k*(-2*(P*a)*Dxx(W)*r**2)
eP=Dt(P)-(Dx(Dx(W)*a)+A*W*(1-W**2)*r**2)
eKx=Dt(Kx)-(-2*DDR*r+(Kx+2*KT)*Kx-k*(((P*a)**2+Dxx(W)**2)*r**2-(1-W**2)**2*r**4*h))
eKT=Dt(KT)-((1-DR**2-R*DDR)*r**2+(Kx+2*KT)*KT-k*((1-W**2)**2*r**4*h))
claims={'N':A*R**2*H,'b':-2*A**2*R**2*M,'W':-8*l**2*eP,'A':-4*R**2*eKT-R**2*H,'R':-4*A*R*(eKx+eKT)-2*A*R*H}
rels=[A*a-1,R*r-1]
certs={}
for f,c in claims.items():
    d=sp.expand(Eg[f]-c)
    gens=[a,r]+sorted(d.free_symbols-{a,r},key=str)
    Q,rem=sp.reduced(d,rels,*gens)
    print(f,'remainder',sp.expand(rem),'sizes',[len(sp.expand(q).args) for q in Q])
    certs[f]=Q
pickle.dump(certs,open('certs.pkl','wb'))

set_option maxHeartbeats 0 in
theorem ricA_00 (H : SphD d N A R s c) : Ric d (GD d N A R s c) 0 0 =
    (1 : S) * (d 0 A) * (d 0 N) * A⁻¹ * N⁻¹ + (-1 : S) * (d 0 (d 0 A)) * A⁻¹ + (-1 : S) * (d 1 A) * N * (d 1 N) * A⁻¹ ^ 3 + (2 : S) * N * (d 1 N) * (d 1 R) * A⁻¹ ^ 2 * R⁻¹ + (1 : S) * N * (d 1 (d 1 N)) * A⁻¹ ^ 2 + (2 : S) * (d 0 N) * (d 0 R) * N⁻¹ * R⁻¹ + (-2 : S) * (d 0 (d 0 R)) * R⁻¹ := by
  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [Ric, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat, Nat.reduceSub, pow_one,
    iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  all_goals
    have hiN : N * N⁻¹ = 1 := mul_inv_cancel₀ hN
    have hiA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
    have hiR : R * R⁻¹ = 1 := mul_inv_cancel₀ hR
    have his : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    generalize N⁻¹ = iN at hiN ⊢
    generalize A⁻¹ = iA at hiA ⊢
    generalize R⁻¹ = iR at hiR ⊢
    generalize s⁻¹ = is at his ⊢
    linear_combination ((-1 : S) * (d 1 N) ^ 2 * iA ^ 2) * hiN

