  have hU : IsUnit (1 : R) := by
    have e : (1 : R) = ((2 : R) ^ 0 * (lam 0 - lam 1) ^ 0 * (lam 0 - lam 2) ^ 0 * (lam 1 - lam 2) ^ 0) := by ring
