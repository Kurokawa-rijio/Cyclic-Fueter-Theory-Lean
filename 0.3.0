* iR ^ 2 * is ^ 3 * s ^ 3 + (-4 : S) * (d 0 (d 1 R)) ^ 2 * iA ^ 2 * iN ^ 2 * iR ^ 2 * is ^ 2 * s ^ 2 + (-8 : S) * (d 0 (d 1 R)) ^ 2 * iA ^ 2 * iN ^ 2 * iR ^ 2 * is * s + (-8 : S) * (d 0 (d 1 R)) ^ 2 * iA ^ 2 * iN ^ 2 * iR ^ 2 + (2 : S) * (d 1 R) ^ 4 * iA ^ 4 * iR ^ 4 * is ^ 3 * s ^ 3 + (2 : S) * (d 1 R) ^ 4 * iA ^ 4 * iR ^ 4 * is ^ 2 * s ^ 2 + (4 : S) * (d 1 R) ^ 4 * iA ^ 4 * iR ^ 4 * is * s + (4 : S) * (d 1 R) ^ 4 * iA ^ 4 * iR ^ 4 + (2 : S) * (d 1 R) ^ 2 * c ^ 2 * iA ^ 2 * iR ^ 4 * is ^ 5 * s ^ 3 + (-6 : S) * (d 1 R) ^ 2 * c ^ 2 * iA ^ 2 * iR ^ 4 * is ^ 4 * s ^ 2 + (-4 : S) * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 4 * is ^ 3 * s ^ 3 + (-8 : S) * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 4 * is ^ 2 * s ^ 2 + (-8 : S) * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 4 * is * s + (-8 : S) * (d 1 R) ^ 2 * iA ^ 2 * iR ^ 4 + (2 : S) * (d 1 (d 1 R)) ^ 2 * iA ^ 4 * iR ^ 2 * is ^ 3 * s ^ 3 + (2 : S) * (d 1 (d 1 R)) ^ 2 * iA ^ 4 * iR ^ 2 * is ^ 2 * s ^ 2 + (4 : S) * (d 1 (d 1 R)) ^ 2 * iA ^ 4 * iR ^ 2 * is * s + (4 : S) * (d 1 (d 1 R)) ^ 2 * iA ^ 4 * iR ^ 2 + (2 : S) * c ^ 4 * iR ^ 4 * is ^ 5 * s + (-2 : S) * c ^ 4 * iR ^ 4 * is ^ 4 + (4 : S) * c ^ 2 * iR ^ 4 * is ^ 4 * s ^ 2 + (4 : S) * iR ^ 4 * is ^ 3 * s ^ 3 + (4 : S) * iR ^ 4 * is ^ 2 * s ^ 2 + (4 : S) * iR ^ 4 * is * s + (4 : S) * iR ^ 4) * his

set_option maxHeartbeats 0 in
/-- 帽子(閉じた放射 FRW):場の方程式のもとで K = 24ℓ⁴/a⁸ -/
theorem kret_cap (a X Y s c l : S) (H : CapData d a X Y s c)
    (h00 : (d 0 a) ^ 2 + a ^ 2 = l ^ 2) (h22 : d 0 (d 0 a) = -a) :
    KretD d ![-a ^ 2, a ^ 2, (a * X) ^ 2, (a * X) ^ 2 * s ^ 2]
      ![-(a⁻¹ ^ 2), a⁻¹ ^ 2, (a * X)⁻¹ ^ 2, (a * X)⁻¹ ^ 2 * s⁻¹ ^ 2] (GD d a a (a * X) s c)
      = 24 * l ^ 4 * a⁻¹ ^ 8 := by
  have HS := capSph d a X Y s c H
  rw [kretD d a a (a * X) s c HS]
  obtain ⟨ha, hX, hs, a1, a2, a3, X0, X1, X2, X3, Y0, Y1, hXY, -, -, -, -, -, -, -, -, comm⟩ := H
  have za : d 1 (d 0 a) = 0 := by rw [comm 1 0 a, a1, map_zero]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.leibniz, smul_eq_mul, mul_inv,
    a1, X0, X1, Y0, Y1, za, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hia : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
  have hiX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
  generalize a⁻¹ = ia at hia ⊢
  generalize X⁻¹ = iX at hiX ⊢
  linear_combination ((-4 : S) * X ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 8 + (-8 : S) * X ^ 2 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 4 * ia ^ 8 + (4 : S) * Y ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 8 + (4 : S) * a ^ 4 * iX ^ 4 * ia ^ 8 + (-16 : S) * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (-8 : S) * a ^ 2 * iX ^ 4 * ia ^ 6 + (32 : S) * a * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 7 + (-16 : S) * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 6) * hXY + ((4 : S) * X ^ 3 * a ^ 4 * iX ^ 3 * ia ^ 8 + (8 : S) * X ^ 3 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 8 + (4 : S) * X ^ 3 * (d 0 a) ^ 4 * iX ^ 3 * ia ^ 8 + (4 : S) * X ^ 2 * a ^ 4 * iX ^ 2 * ia ^ 8 + (8 : S) * X ^ 2 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (4 : S) * X ^ 2 * (d 0 a) ^ 4 * iX ^ 2 * ia ^ 8 + (-8 : S) * X * a ^ 4 * iX ^ 3 * ia ^ 8 + (4 : S) * X * a ^ 4 * iX * ia ^ 8 + (-8 : S) * X * a ^ 2 * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 8 + (24 : S) * X * a ^ 2 * (d 0 a) ^ 2 * iX * ia ^ 8 + (8 : S) * X * a ^ 2 * iX ^ 3 * ia ^ 6 + (8 : S) * X * a ^ 2 * iX * ia ^ 6 + (-16 : S) * X * a * (d 0 a) ^ 2 * iX * ia ^ 7 + (20 : S) * X * (d 0 a) ^ 4 * iX * ia ^ 8 + (-16 : S) * X * (d 0 a) ^ 2 * (d 0 (d 0 a)) * iX * ia ^ 7 + (8 : S) * X * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 6 + (16 : S) * X * (d 0 a) ^ 2 * iX * ia ^ 6 + (8 : S) * X * (d 0 (d 0 a)) ^ 2 * iX * ia ^ 6 + (-8 : S) * a ^ 4 * iX ^ 2 * ia ^ 8 + (4 : S) * a ^ 4 * ia ^ 8 + (-8 : S) * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (24 : S) * a ^ 2 * (d 0 a) ^ 2 * ia ^ 8 + (8 : S) * a ^ 2 * iX ^ 2 * ia ^ 6 + (8 : S) * a ^ 2 * ia ^ 6 + (-16 : S) * a * (d 0 a) ^ 2 * ia ^ 7 + (20 : S) * (d 0 a) ^ 4 * ia ^ 8 + (-16 : S) * (d 0 a) ^ 2 * (d 0 (d 0 a)) * ia ^ 7 + (8 : S) * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 6 + (16 : S) * (d 0 a) ^ 2 * ia ^ 6 + (8 : S) * (d 0 (d 0 a)) ^ 2 * ia ^ 6) * hiX + ((-12 : S) * a * ia ^ 6 + (-24 : S) * (d 0 a) ^ 2 * ia ^ 7 + (12 : S) * (d 0 (d 0 a)) * ia ^ 6) * h22 + ((-24 : S) * a ^ 2 * iX ^ 2 * ia ^ 8 + (32 : S) * a * iX ^ 2 * ia ^ 7 + (8 : S) * a * ia ^ 7 + (24 : S) * (d 0 a) ^ 2 * ia ^ 8 + (-8 : S) * iX ^ 2 * ia ^ 6 + (24 : S) * ia ^ 8 * l ^ 2 + (16 : S) * ia ^ 6) * h00 + ((4 : S) * a ^ 3 * iX ^ 4 * ia ^ 7 + (16 : S) * a ^ 3 * iX ^ 2 * ia ^ 7 + (4 : S) * a ^ 3 * ia ^ 7 + (4 : S) * a ^ 2 * iX ^ 4 * ia ^ 6 + (-16 : S) * a ^ 2 * iX ^ 2 * ia ^ 6 + (-4 : S) * a ^ 2 * ia ^ 6 + (-4 : S) * a * iX ^ 4 * ia ^ 5 + (-24 : S) * a * iX ^ 2 * ia ^ 7 * l ^ 2 + (-24 : S) * a * ia ^ 7 * l ^ 2 + (-4 : S) * iX ^ 4 * ia ^ 4 + (8 : S) * iX ^ 2 * ia ^ 6 * l ^ 2 + (-16 : S) * ia ^ 6 * l ^ 2) * hia

end Curv

import sympy as sp, pickle, time
from gen3 import setup, Der, tolean
funs=['N','A','R']
J,inv,sc,D,rels,gens=setup(funs)
s,c,is_=sc
N,A,R=[J[f][''] for f in funs]; iN,iA,iR=[inv[f] for f in funs]
t=lambda f,k:J[f][k]
G=[[[t('N','t')*iN,t('N','x')*iN,0,0],[t('N','x')*iN,t('A','t')*A*iN**2,0,0],[0,0,t('R','t')*R*iN**2,0],[0,0,0,t('R','t')*R*s**2*iN**2]],
   [[t('N','x')*N*iA**2,t('A','t')*iA,0,0],[t('A','t')*iA,t('A','x')*iA,0,0],[0,0,-(t('R','x')*R*iA**2),0],[0,0,0,-(t('R','x')*R*s**2*iA**2)]],
   [[0,0,t('R','t')*iR,0],[0,0,t('R','x')*iR,0],[t('R','t')*iR,t('R','x')*iR,0,0],[0,0,0,-(s*c)]],
   [[0,0,0,t('R','t')*iR],[0,0,0,t('R','x')*iR],[0,0,0,c*is_],[t('R','t')*iR,t('R','x')*iR,c*is_,0]]]
G=[[[sp.sympify(e) for e in row] for row in m] for m in G]
gdiag=[-N**2,A**2,R**2,R**2*s**2]; gid=[-iN**2,iA**2,iR**2,iR**2*is_**2]
rels=[N*iN-1,A*iA-1,R*iR-1,s*is_-1]; gens=[iN,iA,iR,is_,N,A,R,s]
t0=time.time()
Riem={}
nz=0
for a in range(4):
  for b in range(4):
    for cc in range(4):
      for e in range(4):
        v=sp.expand(Der(cc,G[a][e][b],D)-Der(e,G[a][cc][b],D)+sum(G[a][cc][f]*G[f][e][b]-G[a][e][f]*G[f][cc][b] for f in range(4)))
        Riem[a,b,cc,e]=v
        if v!=0: nz+=1
print('nonzero Riem',nz,time.time()-t0)
K=sp.expand(sum(gdiag[a]*gid[b]*gid[cc]*gid[e]*Riem[a,b,cc,e]**2 for a in range(4) for b in range(4) for cc in range(4) for e in range(4) if Riem[a,b,cc,e]!=0))
Q,rem=sp.reduced(K,rels+[s**2+c**2-1],*([c]+gens))
rem=sp.expand(rem)
print('K terms',len(rem.args),time.time()-t0)
pickle.dump({'K':rem},open('kret.pkl','wb'))

import sympy as sp, pickle
K=pickle.load(open('kret.pkl','rb'))['K']
sym=sp.Symbol
a,at,att,X,Y,ia,iX,l,s,c=sp.symbols('a at att X Y ia iX l s c')
sub={sym('N'):a,sym('Nt'):at,sym('Nx'):0,sym('Ntt'):att,sym('Ntx'):0,sym('Nxx'):0,
 sym('A'):a,sym('At'):at,sym('Ax'):0,sym('Att'):att,sym('Atx'):0,sym('Axx'):0,
 sym('R'):a*X,sym('Rt'):at*X,sym('Rx'):a*Y,sym('Rtt'):att*X,sym('Rtx'):at*Y,sym('Rxx'):-a*X,
 sym('iN'):ia,sym('iA'):ia,sym('iR'):ia*iX}
Kc=sp.expand(K.subs(sub))
print([str(x) for x in Kc.free_symbols])
GB=[Y**2+X**2-1, X*iX-1, a*ia-1]
Q,rem=sp.reduced(Kc,GB,Y,iX,ia,X,a,at,att,l,s,c,order='lex')
print('K cap =',sp.factor(rem))
# impose att=-a, at^2=l^2-a^2
r2=sp.expand(rem.subs(att,-a))
GB2=[at**2+a**2-l**2,a*ia-1]
Q2,rem2=sp.reduced(r2,GB2,at,ia,a,l,order='lex')
print('on shell:',sp.factor(rem2))

import sympy as sp, pickle, time
from gen3 import setup, Der, tolean
from cert5 import lean as clean, names, A_
exec(open('kret.py').read().split("t0=time.time()")[0])
Riem={}
for a in range(4):
  for b in range(4):
    for cc in range(4):
      for e in range(4):
        Riem[a,b,cc,e]=sp.expand(Der(cc,G[a][e][b],D)-Der(e,G[a][cc][b],D)+sum(G[a][cc][f]*G[f][e][b]-G[a][e][f]*G[f][cc][b] for f in range(4)))
K=sp.expand(sum(gdiag[a]*gid[b]*gid[cc]*gid[e]*Riem[a,b,cc,e]**2 for a in range(4) for b in range(4) for cc in range(4) for e in range(4)))
rr=rels+[s**2+c**2-1]
Q,rem=sp.reduced(K,rr,*([c]+gens))
rem=sp.expand(rem)
def g(st):
    for f in ['N','A','R']: st=st.replace('%s⁻¹'%f,'i'+f)
    return st.replace('s⁻¹','is')
qs=[g(tolean(q,J,inv,sc)) for q in Q]
out={'rhs':tolean(rem,J,inv,sc),'q':qs}
print('rhs len',len(out['rhs']),'q lens',[len(x) for x in qs])
pickle.dump(out,open('kret_cert.pkl','wb'))
# cap on shell certificate
sym=sp.Symbol
a_,at,att,X,Y,ia,iX,l=[A_(x,y) for x,y in [('a','a'),('at','(d 0 a)'),('att','(d 0 (d 0 a))'),('X','X'),('Y','Y'),('ia','ia'),('iX','iX'),('l','l')]]
sub={sym('N'):a_,sym('Nt'):at,sym('Nx'):0,sym('Ntt'):att,sym('Ntx'):0,sym('Nxx'):0,
 sym('A'):a_,sym('At'):at,sym('Ax'):0,sym('Att'):att,sym('Atx'):0,sym('Axx'):0,
 sym('R'):a_*X,sym('Rt'):at*X,sym('Rx'):a_*Y,sym('Rtt'):att*X,sym('Rtx'):at*Y,sym('Rxx'):-a_*X,
 sym('iN'):ia,sym('iA'):ia,sym('iR'):ia*iX}
Kc=sp.expand(rem.subs(sub))
GB=[Y**2+X**2-1, X*iX-1, att+a_, at**2+a_**2-l**2, a_*ia-1]
Q2,r2=sp.reduced(sp.expand(Kc-24*l**4*ia**8),GB,Y,iX,att,at,ia,X,a_,l,order='lex')
assert sp.expand(r2)==0, r2
out2=' + '.join('(%s) * %s'%(clean(q),h) for q,h in zip(Q2,['hXY','hiX','h22','h00','hia']) if sp.expand(q)!=0)
print('cap cert len',len(out2))
pickle.dump(out2,open('kret_cap.pkl','wb'))

section Analysis
open Real Filter Topology Set

/-- 固有時 τ = ℓ sin η で a = ℓ cos η は a² = ℓ² − τ² -/
theorem cap_cosmic (l η : ℝ) : (l * cos η) ^ 2 = l ^ 2 - (l * sin η) ^ 2 := by
  have := sin_sq_add_cos_sq η; nlinarith

/-- η → π/2⁻ で K = 24ℓ⁴/(ℓ cos η)⁸ → ∞ -/
theorem kret_blowup (l : ℝ) (hl : 0 < l) :
    Tendsto (fun η => 24 * l ^ 4 * ((l * cos η)⁻¹) ^ 8) (𝓝[<] (π / 2)) atTop := by
  have h1 : Tendsto (fun η => l * cos η) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    have hc := tendsto_cos_pi_div_two
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have := (tendsto_nhdsWithin_iff.mp hc).1
      simpa using this.const_mul l
    · filter_upwards [(tendsto_nhdsWithin_iff.mp hc).2] with η hη
      exact Set.mem_Ioi.mpr (mul_pos hl (Set.mem_Ioi.mp hη))
  have h2 : Tendsto (fun η => (l * cos η) ^ 8) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using (tendsto_nhdsWithin_iff.mp h1).1.pow 8
    · filter_upwards [(tendsto_nhdsWithin_iff.mp h1).2] with η hη
      exact Set.mem_Ioi.mpr (pow_pos (Set.mem_Ioi.mp hη) 8)
  have h3 := (tendsto_inv_nhdsGT_zero.comp h2).const_mul_atTop (by positivity : (0 : ℝ) < 24 * l ^ 4)
  refine h3.congr' ?_
  filter_upwards with η
  simp only [Function.comp, inv_pow]

/-- K と ρ̂ は χ によらない(空間的に一様)ので、極座標の中心 χ → 0⁺ でも同じ値をとる -/
theorem center_limit (v : ℝ) (f : ℝ → ℝ) (hf : ∀ χ ∈ Ioo 0 π, f χ = v) :
    Tendsto f (𝓝[>] 0) (𝓝 v) := by
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT pi_pos] with χ hχ
  exact (hf χ hχ).symm

theorem density_center (a : ℝ) (ha : a ≠ 0) :
    Tendsto (fun χ => CFT.S4J.Rho (a * sin χ) (cos χ) 0 (-(sin χ) / a)) (𝓝[>] 0) (𝓝 (3 / (2 * a ^ 4))) :=
  center_limit _ _ fun χ hχ => cap_density a (sin χ) (cos χ) ha (sin_pos_of_pos_of_lt_pi hχ.1 hχ.2).ne'
    (sin_sq_add_cos_sq χ)

/-- 共形計量 a²(−dη² + dχ²) の曲線 η ↦ (η, χ(η)) がヌル ⇔ χ′² = 1 -/
theorem front_null (a χ' : ℝ) (ha : a ≠ 0) : -a ^ 2 + a ^ 2 * χ' ^ 2 = 0 ↔ χ' ^ 2 = 1 := by
  constructor
  · intro h
    have : a ^ 2 * (χ' ^ 2 - 1) = 0 := by linear_combination h
    have := (mul_eq_zero.mp this).resolve_left (pow_ne_zero 2 ha); linarith
  · intro h; rw [h]; ring

/-- 連続な χ′ が至る所 χ′² = 1 で χ′(0) = −1 なら至る所 χ′ = −1(内向きの波面は向きを変えない) -/
theorem front_sign (χ' : ℝ → ℝ) (hc : Continuous χ') (h : ∀ η, χ' η ^ 2 = 1) (h0 : χ' 0 = -1) :
    ∀ η, χ' η = -1 := by
  intro η
  have hv : χ' η = 1 ∨ χ' η = -1 := by
    have := h η
    have : (χ' η - 1) * (χ' η + 1) = 0 := by linear_combination this
    rcases mul_eq_zero.mp this with h1 | h1
    · left; linarith
    · right; linarith
  rcases hv with h1 | h1
  · exfalso
    have hne : ∀ x, χ' x ≠ 0 := fun x hx => by have := h x; rw [hx] at this; norm_num at this
    rcases le_total 0 η with hle | hle
    · obtain ⟨x, -, hx⟩ := intermediate_value_Icc hle hc.continuousOn
        (show (0 : ℝ) ∈ Icc (χ' 0) (χ' η) by rw [h0, h1]; norm_num)
      exact hne x hx
    · obtain ⟨x, -, hx⟩ := intermediate_value_Icc' hle hc.continuousOn
        (show (0 : ℝ) ∈ Icc (χ' 0) (χ' η) by rw [h0, h1]; norm_num)
      exact hne x hx
  · exact h1

/-- 接合 χ(0) = π/2 から内向きのヌルな波面は χ(η) = π/2 − η -/
theorem front_inward (χ χ' : ℝ → ℝ) (hd : ∀ η, HasDerivAt χ (χ' η) η) (hc : Continuous χ')
    (hnull : ∀ η, χ' η ^ 2 = 1) (h0' : χ' 0 = -1) (h0 : χ 0 = π / 2) : ∀ η, χ η = π / 2 - η := by
  have hs := front_sign χ' hc hnull h0'
  have hD : ∀ η, HasDerivAt (fun η => χ η + η) 0 η := by
    intro η
    have := (hd η).add (hasDerivAt_id η)
    simpa [hs η] using this
  intro η
  have := is_const_of_deriv_eq_zero (fun z => (hD z).differentiableAt) (fun z => (hD z).deriv) η 0
  simp only [h0, add_zero] at this
  linarith

/-- 波面が中心 χ = 0 に着くのは η = π/2(崩壊の瞬間)だけ。それ以前の中心は波面の外(帽子の依存領域) -/
theorem front_hits_center (η : ℝ) : π / 2 - η = 0 ↔ η = π / 2 := by
  constructor <;> intro h <;> linarith

end Analysis

end CFT.S5K

import pickle
o=pickle.load(open('closed.pkl','rb'))
def fix(e): return e
L=[]
def prelude(kind):
    if kind=='D':
        return """  obtain ⟨hN, hA, hR, hs, N2, N3, A2, A3, R2, R3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iN := fun i => deriv_inv (d i) N hN
  have iA := fun i => deriv_inv (d i) A hA
  have iR := fun i => deriv_inv (d i) R hR
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zN20, zN30⟩ := z N N2 N3 0
  obtain ⟨zN21, zN31⟩ := z N N2 N3 1
  obtain ⟨zA20, zA30⟩ := z A A2 A3 0
  obtain ⟨zA21, zA31⟩ := z A A2 A3 1
  obtain ⟨zR20, zR30⟩ := z R R2 R3 0
  obtain ⟨zR21, zR31⟩ := z R R2 R3 1
  have kN := comm 1 0 N
  have kA := comm 1 0 A
  have kR := comm 1 0 R
  simp only [Ric, GD, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, iN, iA, iR, is, N2, N3, A2, A3, R2, R3,
    s0, s1, s2, s3, c0, c1, c2, c3, zN20, zN30, zN21, zN31, zA20, zA30, zA21, zA31, zR20, zR30, zR21, zR31,
    kN, kA, kR, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  field_simp
  ring"""
    else:
        return """  obtain ⟨hO, hr, hs, O2, O3, r2, r3, s0, s1, s2, s3, c0, c1, c2, c3, comm⟩ := H
  have iO := fun i => deriv_inv (d i) Om hO
  have ir := fun i => deriv_inv (d i) r hr
  have is := fun i => deriv_inv (d i) s hs
  have z : ∀ f, d 2 f = 0 → d 3 f = 0 → ∀ j, d 2 (d j f) = 0 ∧ d 3 (d j f) = 0 := fun f h2 h3 j =>
    ⟨by rw [comm 2 j f, h2, map_zero], by rw [comm 3 j f, h3, map_zero]⟩
  obtain ⟨zO20, zO30⟩ := z Om O2 O3 0
  obtain ⟨zO21, zO31⟩ := z Om O2 O3 1
  obtain ⟨zr20, zr30⟩ := z r r2 r3 0
  obtain ⟨zr21, zr31⟩ := z r r2 r3 1
  have kO := comm 1 0 Om
  have kr := comm 1 0 r
  simp only [Ric, GN, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, map_add, map_sub, map_neg, map_mul, map_zero,
    Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, iO, ir, is, O2, O3, r2, r3,
    s0, s1, s2, s3, c0, c1, c2, c3, zO20, zO30, zO21, zO31, zr20, zr30, zr21, zr31,
    kO, kr, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  field_simp
  ring"""
for kind,args,hyp in [('D','N A R s c','SphD d N A R s c'),('N','Om r s c','SphN d Om r s c')]:
    gargs='N A R s' if kind=='D' else 'Om r s'
    for (i,j) in [(0,0),(1,1),(2,2),(3,3),(0,1)]+([(1,0)] if kind=='N' else []):
        key='Ric%s%d%d'%(kind,min(i,j),max(i,j))
        L.append(f"""set_option maxHeartbeats 0 in
theorem ric{kind}_{i}{j} (H : {hyp}) : Ric d (G{kind} d {args}) {i} {j} = {o[key]} := by
{prelude(kind)}
""")
    L.append(f"""theorem rsc{kind} (H : {hyp}) :
    Rsc d (gi{kind} {gargs}) (G{kind} d {args}) = {o['Rsc'+kind]} := by
  have h00 := ric{kind}_00 d {args} H
  have h11 := ric{kind}_11 d {args} H
  have h22 := ric{kind}_22 d {args} H
  have h33 := ric{kind}_33 d {args} H
  have h01 := ric{kind}_01 d {args} H
  have H0 := H
  obtain ⟨{'hN, hA, hR, hs' if kind=='D' else 'hO, hr, hs'}, -⟩ := H
  simp only [Rsc, gi{kind}, Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons, zero_mul, add_zero, zero_add]
  {'rw [h00, h11, h22, h33]' if kind=='D' else 'rw [h01, ricN_10 d Om r s c H0, h22, h33]'}
  field_simp
  ring
""")
    for (i,j) in [(0,0),(1,1),(2,2),(0,1)]:
        L.append(f"""theorem ein{kind}_{i}{j} (H : {hyp}) :
    Ein d (g{kind} {gargs}) (gi{kind} {gargs}) (G{kind} d {args}) {i} {j} = {o['Ein%s%d%d'%(kind,i,j)]} := by
  have hR := ric{kind}_{i}{j} d {args} H
  have hS := rsc{kind} d {args} H
  obtain ⟨{'hN, hA, hR0, hs' if kind=='D' else 'hO, hr, hs'}, -⟩ := H
  rw [Ein, hR, hS]
  simp only [g{kind}, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.tail_cons]
  field_simp
  ring
""")
open('ric.lean','w').write('\n'.join(L))

