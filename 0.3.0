/- α-II.5:1 段目の解(e₀v, e₁v を e₂v で表す)と単元の補題 -/
import CFT.Cartan.C2

namespace CFT.Cartan

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {R : Type*} [CommRing R] [Algebra ℚ R]

/-- 大きな多項式の elaborate を速くするための局所インスタンス(標準のものと定義上同じ) -/
local instance (priority := high) hmR_SSFirst : HMul R R R := instHMul
local instance (priority := high) haR_SSFirst : HAdd R R R := instHAdd
local instance (priority := high) hsR_SSFirst : HSub R R R := instHSub
local instance (priority := high) hpR_SSFirst : HPow R ℕ R := instHPow
local instance (priority := high) ngR_SSFirst : Neg R := inferInstance

namespace C2

variable {F : Frame R} {lam : Fin 3 → R} (H : C2 F lam)
include H

