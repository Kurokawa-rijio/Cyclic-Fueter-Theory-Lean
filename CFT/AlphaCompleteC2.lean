/-- まとめ:ε で定義した Hodge 双対について m²D_kΦ + m²(*F)_k = 0、すなわち D_AΦ = −*F -/
theorem bps (m iE iS : ℂ) (p : Fin 3 → ℂ)
    (hiE : (m ^ 2 + p 0 ^ 2 + p 1 ^ 2 + p 2 ^ 2) * iE ^ 2 = 1)
    (hiS : (p 0 ^ 2 + p 1 ^ 2 + p 2 ^ 2) * iS = 1) (k : Fin 3) :
    (m ^ 2) • DPhi m iE iS p k + starF m iE p (aB m iE iS) (apB m iE iS p) k = 0 := by
  rw [starF_closed]
  exact bps_closed m iE iS p hiE hiS k

end

/-- a = (1 − m/E)/(2s) は 1/(2E(E+m)) に等しい(s = E² − m²、E > m > 0) -/
theorem aB_eq (m E : ℝ) (hm : 0 < m) (hEm : m < E) :
    (1 - m * (1 / E)) * (1 / (E ^ 2 - m ^ 2)) / 2 = 1 / (2 * E * (E + m)) := by
  have hE : 0 < E := lt_trans hm hEm
  have h1 : E ^ 2 - m ^ 2 ≠ 0 := by nlinarith
  have h2 : E + m ≠ 0 := by positivity
  field_simp
  ring

/-- a′ の式は berry_deriv の値 −(2E+m)/(4E³(E+m)²) に等しい -/
theorem apB_eq (m E : ℝ) (hm : 0 < m) (hEm : m < E) :
    (m * (E ^ 2 - m ^ 2) * (1 / E) ^ 3 - 2 + 2 * m * (1 / E)) * (1 / (E ^ 2 - m ^ 2)) ^ 2 / 4
      = -(2 * E + m) / (4 * E ^ 3 * (E + m) ^ 2) := by
  have hE : 0 < E := lt_trans hm hEm
  have h1 : E ^ 2 - m ^ 2 ≠ 0 := by nlinarith
  have h2 : E + m ≠ 0 := by positivity
  have h3 : E - m ≠ 0 := by linarith
  field_simp
  ring

end CFT.AlphaCompleteC2
