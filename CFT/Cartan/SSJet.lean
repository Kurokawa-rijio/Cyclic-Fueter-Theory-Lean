namespace CFT.Cartan

set_option maxHeartbeats 0
set_option maxRecDepth 100000

variable {R : Type*} [CommRing R] [Algebra ℚ R]

/-- 大きな多項式の elaborate を速くするための局所インスタンス(標準のものと定義上同じ) -/
local instance (priority := high) hmR_SSJet : HMul R R R := instHMul
local instance (priority := high) haR_SSJet : HAdd R R R := instHAdd
local instance (priority := high) hsR_SSJet : HSub R R R := instHSub
local instance (priority := high) hpR_SSJet : HPow R ℕ R := instHPow
local instance (priority := high) ngR_SSJet : Neg R := inferInstance

