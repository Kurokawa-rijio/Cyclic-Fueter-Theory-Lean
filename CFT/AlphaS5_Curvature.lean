/-- 帽子(閉じた放射 FRW):場の方程式のもとで K = 24ℓ⁴/a⁸ -/
theorem kret_cap (a X Y s c l : S) (H : CapData d a X Y s c)
    (h00 : (d 0 a) ^ 2 + a ^ 2 = l ^ 2) (h22 : d 0 (d 0 a) = -a) :
    KretD d ![-a ^ 2, a ^ 2, (a * X) ^ 2, (a * X) ^ 2 * s ^ 2]
      ![-(a⁻¹ ^ 2), a⁻¹ ^ 2, (a * X)⁻¹ ^ 2, (a * X)⁻¹ ^ 2 * s⁻¹ ^ 2] (GD d a a (a * X) s c)
      = 24 * l ^ 4 * a⁻¹ ^ 8 := by
  have HS := capSph d a X Y s c H
  rw [kretD d a a (a * X) s c HS]
  obtain ⟨ha, hX, hs, a1, a2, a3, X0, X1, X2, X3, Y0, Y1, hXY, -, -, -, -, -, -, -, -, comm⟩ := H
  have za : d 1 (d 0 a) = 0 := by rw [comm 1 0 a, a1, map_zero]
  simp only [map_add, map_sub, map_neg, map_mul, map_zero, Derivation.leibniz, smul_eq_mul, mul_inv,
    a1, X0, X1, Y0, Y1, za, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, neg_zero]
  have hia : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
  have hiX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
  generalize a⁻¹ = ia at hia ⊢
  generalize X⁻¹ = iX at hiX ⊢
  linear_combination ((-4 : S) * X ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 8 + (-8 : S) * X ^ 2 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 4 * ia ^ 8 + (4 : S) * Y ^ 2 * a ^ 4 * iX ^ 4 * ia ^ 8 + (4 : S) * a ^ 4 * iX ^ 4 * ia ^ 8 + (-16 : S) * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (-8 : S) * a ^ 2 * iX ^ 4 * ia ^ 6 + (32 : S) * a * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 7 + (-16 : S) * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 6) * hXY + ((4 : S) * X ^ 3 * a ^ 4 * iX ^ 3 * ia ^ 8 + (8 : S) * X ^ 3 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 8 + (4 : S) * X ^ 3 * (d 0 a) ^ 4 * iX ^ 3 * ia ^ 8 + (4 : S) * X ^ 2 * a ^ 4 * iX ^ 2 * ia ^ 8 + (8 : S) * X ^ 2 * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (4 : S) * X ^ 2 * (d 0 a) ^ 4 * iX ^ 2 * ia ^ 8 + (-8 : S) * X * a ^ 4 * iX ^ 3 * ia ^ 8 + (4 : S) * X * a ^ 4 * iX * ia ^ 8 + (-8 : S) * X * a ^ 2 * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 8 + (24 : S) * X * a ^ 2 * (d 0 a) ^ 2 * iX * ia ^ 8 + (8 : S) * X * a ^ 2 * iX ^ 3 * ia ^ 6 + (8 : S) * X * a ^ 2 * iX * ia ^ 6 + (-16 : S) * X * a * (d 0 a) ^ 2 * iX * ia ^ 7 + (20 : S) * X * (d 0 a) ^ 4 * iX * ia ^ 8 + (-16 : S) * X * (d 0 a) ^ 2 * (d 0 (d 0 a)) * iX * ia ^ 7 + (8 : S) * X * (d 0 a) ^ 2 * iX ^ 3 * ia ^ 6 + (16 : S) * X * (d 0 a) ^ 2 * iX * ia ^ 6 + (8 : S) * X * (d 0 (d 0 a)) ^ 2 * iX * ia ^ 6 + (-8 : S) * a ^ 4 * iX ^ 2 * ia ^ 8 + (4 : S) * a ^ 4 * ia ^ 8 + (-8 : S) * a ^ 2 * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 8 + (24 : S) * a ^ 2 * (d 0 a) ^ 2 * ia ^ 8 + (8 : S) * a ^ 2 * iX ^ 2 * ia ^ 6 + (8 : S) * a ^ 2 * ia ^ 6 + (-16 : S) * a * (d 0 a) ^ 2 * ia ^ 7 + (20 : S) * (d 0 a) ^ 4 * ia ^ 8 + (-16 : S) * (d 0 a) ^ 2 * (d 0 (d 0 a)) * ia ^ 7 + (8 : S) * (d 0 a) ^ 2 * iX ^ 2 * ia ^ 6 + (16 : S) * (d 0 a) ^ 2 * ia ^ 6 + (8 : S) * (d 0 (d 0 a)) ^ 2 * ia ^ 6) * hiX + ((-12 : S) * a * ia ^ 6 + (-24 : S) * (d 0 a) ^ 2 * ia ^ 7 + (12 : S) * (d 0 (d 0 a)) * ia ^ 6) * h22 + ((-24 : S) * a ^ 2 * iX ^ 2 * ia ^ 8 + (32 : S) * a * iX ^ 2 * ia ^ 7 + (8 : S) * a * ia ^ 7 + (24 : S) * (d 0 a) ^ 2 * ia ^ 8 + (-8 : S) * iX ^ 2 * ia ^ 6 + (24 : S) * ia ^ 8 * l ^ 2 + (16 : S) * ia ^ 6) * h00 + ((4 : S) * a ^ 3 * iX ^ 4 * ia ^ 7 + (16 : S) * a ^ 3 * iX ^ 2 * ia ^ 7 + (4 : S) * a ^ 3 * ia ^ 7 + (4 : S) * a ^ 2 * iX ^ 4 * ia ^ 6 + (-16 : S) * a ^ 2 * iX ^ 2 * ia ^ 6 + (-4 : S) * a ^ 2 * ia ^ 6 + (-4 : S) * a * iX ^ 4 * ia ^ 5 + (-24 : S) * a * iX ^ 2 * ia ^ 7 * l ^ 2 + (-24 : S) * a * ia ^ 7 * l ^ 2 + (-4 : S) * iX ^ 4 * ia ^ 4 + (8 : S) * iX ^ 2 * ia ^ 6 * l ^ 2 + (-16 : S) * ia ^ 6 * l ^ 2) * hia

end Curv
section PropFromEqs
variable {S : Type*} [Field S] [CharZero S] (d : Fin 4 → Derivation ℤ S S)

/-- α-IV.1 の合成:uv・θθ の Einstein 方程式と YM 方程式(F = dA + A∧A)から Goursat の形を出し
  (goursat_r、goursat_Om、goursat_W)、拘束の伝播 ∂_v C_u = −(r_v/r) C_u、∂_u C_v = −(r_u/r) C_v を得る -/
theorem constraint_prop_from_eqs (W Om r s c l : S) (H : SphN d Om r s c) (W2 : d 2 W = 0) (W3 : d 3 W = 0)
    (dl : ∀ i, d i l = 0)
    (E01 : Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 0 1
      = 2 * l ^ 2 * Tym (gN Om r s) (giN Om r s) (Fym d (Aym W s c)) 0 1)
    (E22 : Ein d (gN Om r s) (giN Om r s) (GN d Om r s c) 2 2
      = 2 * l ^ 2 * Tym (gN Om r s) (giN Om r s) (Fym d (Aym W s c)) 2 2)
    (hY : YMeq d (giN Om r s) (Om * r ^ 2 * s) (Aym W s c) (Fym d (Aym W s c)) 0 2 = 0) :
    d 1 (Cu d Om r W l) = -(d 1 r * r⁻¹) * Cu d Om r W l ∧
    d 0 (Cv d Om r W l) = -(d 0 r * r⁻¹) * Cv d Om r W l := by
  have hF : Fym d (Aym W s c) = FT d W s := fym_eq d W s c W2 W3 H.s0 H.s1 H.s2 H.s3 H.c0 H.c1 H.c2 H.c3
  rw [hF] at E01 E22 hY
  have hr := goursat_r d W Om r s c l H E01
  have hO := goursat_Om d W Om r s c l H E22
  have hW := goursat_W d W Om r s c H W2 W3 hY
  exact ⟨constraint_prop_u d W Om r s c l H dl hr hO hW, constraint_prop_v d W Om r s c l H dl hr hO hW⟩

end PropFromEqs

section Analysis
open Real Filter Topology Set

/-- 固有時 τ = ℓ sin η で a = ℓ cos η は a² = ℓ² − τ² -/
theorem cap_cosmic (l η : ℝ) : (l * cos η) ^ 2 = l ^ 2 - (l * sin η) ^ 2 := by
  have := sin_sq_add_cos_sq η; nlinarith

/-- η → π/2⁻ で K = 24ℓ⁴/(ℓ cos η)⁸ → ∞ -/
theorem kret_blowup (l : ℝ) (hl : 0 < l) :
    Tendsto (fun η => 24 * l ^ 4 * ((l * cos η)⁻¹) ^ 8) (𝓝[<] (π / 2)) atTop := by
  have h1 : Tendsto (fun η => l * cos η) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    have hc := tendsto_cos_pi_div_two
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have := (tendsto_nhdsWithin_iff.mp hc).1
      simpa using this.const_mul l
    · filter_upwards [(tendsto_nhdsWithin_iff.mp hc).2] with η hη
      exact Set.mem_Ioi.mpr (mul_pos hl (Set.mem_Ioi.mp hη))
  have h2 : Tendsto (fun η => (l * cos η) ^ 8) (𝓝[<] (π / 2)) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using (tendsto_nhdsWithin_iff.mp h1).1.pow 8
    · filter_upwards [(tendsto_nhdsWithin_iff.mp h1).2] with η hη
      exact Set.mem_Ioi.mpr (pow_pos (Set.mem_Ioi.mp hη) 8)
  have h3 := (tendsto_inv_nhdsGT_zero.comp h2).const_mul_atTop (by positivity : (0 : ℝ) < 24 * l ^ 4)
  refine h3.congr' ?_
  filter_upwards with η
  simp only [Function.comp, inv_pow]

/-- K と ρ̂ は χ によらない(空間的に一様)ので、極座標の中心 χ → 0⁺ でも同じ値をとる -/
theorem center_limit (v : ℝ) (f : ℝ → ℝ) (hf : ∀ χ ∈ Ioo 0 π, f χ = v) :
    Tendsto f (𝓝[>] 0) (𝓝 v) := by
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT pi_pos] with χ hχ
  exact (hf χ hχ).symm

theorem density_center (a : ℝ) (ha : a ≠ 0) :
    Tendsto (fun χ => CFT.S4J.Rho (a * sin χ) (cos χ) 0 (-(sin χ) / a)) (𝓝[>] 0) (𝓝 (3 / (2 * a ^ 4))) :=
  center_limit _ _ fun χ hχ => CFT.S5.cap_density a (sin χ) (cos χ) ha (sin_pos_of_pos_of_lt_pi hχ.1 hχ.2).ne'
    (sin_sq_add_cos_sq χ)

/-- 共形計量 a²(−dη² + dχ²) の曲線 η ↦ (η, χ(η)) がヌル ⇔ χ′² = 1 -/
theorem front_null (a χ' : ℝ) (ha : a ≠ 0) : -a ^ 2 + a ^ 2 * χ' ^ 2 = 0 ↔ χ' ^ 2 = 1 := by
  constructor
  · intro h
    have : a ^ 2 * (χ' ^ 2 - 1) = 0 := by linear_combination h
    have := (mul_eq_zero.mp this).resolve_left (pow_ne_zero 2 ha); linarith
  · intro h; rw [h]; ring

/-- 連続な χ′ が至る所 χ′² = 1 で χ′(0) = −1 なら至る所 χ′ = −1(内向きの波面は向きを変えない) -/
theorem front_sign (χ' : ℝ → ℝ) (hc : Continuous χ') (h : ∀ η, χ' η ^ 2 = 1) (h0 : χ' 0 = -1) :
    ∀ η, χ' η = -1 := by
  intro η
  have hv : χ' η = 1 ∨ χ' η = -1 := by
    have := h η
    have : (χ' η - 1) * (χ' η + 1) = 0 := by linear_combination this
    rcases mul_eq_zero.mp this with h1 | h1
    · left; linarith
    · right; linarith
  rcases hv with h1 | h1
  · exfalso
    have hne : ∀ x, χ' x ≠ 0 := fun x hx => by have := h x; rw [hx] at this; norm_num at this
    rcases le_total 0 η with hle | hle
    · obtain ⟨x, -, hx⟩ := intermediate_value_Icc hle hc.continuousOn
        (show (0 : ℝ) ∈ Icc (χ' 0) (χ' η) by rw [h0, h1]; norm_num)
      exact hne x hx
    · obtain ⟨x, -, hx⟩ := intermediate_value_Icc' hle hc.continuousOn
        (show (0 : ℝ) ∈ Icc (χ' 0) (χ' η) by rw [h0, h1]; norm_num)
      exact hne x hx
  · exact h1

/-- 接合 χ(0) = π/2 から内向きのヌルな波面は χ(η) = π/2 − η -/
theorem front_inward (χ χ' : ℝ → ℝ) (hd : ∀ η, HasDerivAt χ (χ' η) η) (hc : Continuous χ')
    (hnull : ∀ η, χ' η ^ 2 = 1) (h0' : χ' 0 = -1) (h0 : χ 0 = π / 2) : ∀ η, χ η = π / 2 - η := by
  have hs := front_sign χ' hc hnull h0'
  have hD : ∀ η, HasDerivAt (fun η => χ η + η) 0 η := by
    intro η
    have := (hd η).add (hasDerivAt_id η)
    simpa [hs η] using this
  intro η
  have := is_const_of_deriv_eq_zero (fun z => (hD z).differentiableAt) (fun z => (hD z).deriv) η 0
  simp only [h0, add_zero] at this
  linarith

/-- 波面が中心 χ = 0 に着くのは η = π/2(崩壊の瞬間)だけ。それ以前の中心は波面の外(帽子の依存領域) -/
theorem front_hits_center (η : ℝ) : π / 2 - η = 0 ↔ η = π / 2 := by
  constructor <;> intro h <;> linarith

/-- 曲率の長さ L(L⁴ = 1/K)は K = 24ℓ⁴/a⁸ で L⁴ = a⁸/(24ℓ⁴)、すなわち L² = a⁴/(√24 ℓ²)(L ~ a²/ℓ)。
  時間対称な初期面 a = ℓ ではすでに L⁴ = ℓ⁴/24 -/
theorem curv_length (a l : ℝ) (ha : a ≠ 0) (hl : l ≠ 0) :
    (24 * l ^ 4 * a⁻¹ ^ 8)⁻¹ = a ^ 8 / (24 * l ^ 4) ∧ (24 * l ^ 4 * l⁻¹ ^ 8)⁻¹ = l ^ 4 / 24 := by
  constructor <;> field_simp <;> ring

/-- WGC の磁気版のカットオフ Λ = g M_Pl = g/√G:ℓ² = 4πG/g² なら (1/Λ)² = G/g² = ℓ²/(4π)。
  帽子の曲率の長さ(初期面で ℓ/24^{1/4})と同じ桁:ダンベルは最初からカットオフの尺度にある -/
theorem wgc_length (G g l : ℝ) (hG : 0 < G) (hg : g ≠ 0) (hl : l ^ 2 = 4 * π * G / g ^ 2) :
    (1 / (g / √G)) ^ 2 = l ^ 2 / (4 * π) := by
  have hπ : π ≠ 0 := pi_ne_zero
  rw [hl, one_div, inv_pow, div_pow, Real.sq_sqrt hG.le]
  field_simp
  ring

end Analysis

